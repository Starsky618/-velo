# RIDEMAP 反向代理配置
#
# Caddy 会自动为这个域名申请 Let's Encrypt SSL 证书。
# 部署前把 api.ridemap.cn 替换为你的实际域名。
# 前置条件：域名的 A 记录已指向服务器 IP，服务器开放 80/443 端口。

api.ridemap.cn {
    # 赛段创建等管理工具（静态 HTML 文件）
    handle /tools/* {
        root * /app
        file_server
    }

    # API 反向代理
    handle {
        reverse_proxy api:8000
    }
}
