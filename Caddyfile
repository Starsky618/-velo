# VELO 反向代理配置
#
# 三站点结构（2026-07-29 增加 VELO 官网）：
# - api.weiluai.top：正式入口，Caddy 自动向 Let's Encrypt 申请并续期 HTTPS 证书
#  （微信小程序合法域名硬性要求 https + 备案域名）。证书存 caddy_data 卷，重建容器不丢。
# - weiluai.top：www.weiluai.top 跳转到这里；仅以 /srv/website 为站点根，不反代 API。
#   Caddy 容器因既有 API 白名单路由仍只读挂载 /srv/uploads；官网目录禁止符号链接，
#   且官网 snippet 不引用 uploads，避免公开用户 FIT/GPX 和轨迹文件。
# - :80 兜底：保留 IP 直连（开发者工具调试 / 证书异常时的逃生通道）。
# API 两个入口的路由规则都从 (velo_site) 代码片段导入——改规则只改一处，防两份漂移。
# 前置条件（已满足）：api 和 @ 的 A 记录 → 114.132.190.245，
# www 的 CNAME → weiluai.top，轻量服务器防火墙放行 80/443。

(velo_site) {
    # 微信小程序业务域名所有权校验。仅开放微信生成的精确文件名，
    # 不扩大 /srv/website 在 API 域名下的静态文件访问范围。
    handle /l5SARfvHJ6.txt {
        root * /srv/website
        file_server
    }

    # 上传体积上限：约骑媒体图 ≤5MB / 视频 ≤50MB，留余量 55MB。
    # 在反代之前就拦超大请求，0 应用层内存消耗（防大文件先读进内存才被后端 413）。
    request_body {
        max_size 55MB
    }

    # 赛段创建等管理工具（静态 HTML 文件）
    handle /tools/* {
        root * /app
        file_server
    }

    # 约骑照片墙静态服务：**只 serve meetup_media/ 子目录，绝不能 serve /uploads/* 整个根**！
    # uploads 根混着所有用户的私密活动 GPX 轨迹，serve 整个根会绕过 _can_view_activity 隐私判断
    # 泄露轨迹（含家庭住址/常骑路线）。2026-06-01 Codex 异源审抓的隐私 Critical 修复。
    # 约骑照片存在 uploads/meetup_media/，file_id 形如 meetup_media/202605/x.jpg。
    handle /uploads/meetup_media/* {
        root * /srv
        file_server
    }

    # 路线百科封面/配图静态服务（2026-06-11）：图放服务器 uploads/route_covers/，
    # meta.json 的 cover_url 填 https://api.weiluai.top/uploads/route_covers/<文件名> 即生效。
    # 与 meetup_media 同纪律：只 serve 子目录，绝不 serve /uploads/* 根（隐私 Critical 判例）。
    handle /uploads/route_covers/* {
        root * /srv
        file_server
    }

    # API 反向代理
    handle {
        reverse_proxy api:8000
    }
}

api.weiluai.top {
    import velo_site
}

# VELO 官网：纯静态、无表单、无脚本、无用户数据读取。
# 上线前 DNS 还需要：
#   @   A      114.132.190.245
#   www CNAME  weiluai.top
(velo_website) {
	root * /srv/website
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; script-src 'none'; connect-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
	}

	handle_errors {
		@not_found expression {err.status_code} == 404
		handle @not_found {
			rewrite * /404.html
			file_server
		}
	}

	file_server
}

weiluai.top {
	import velo_website
}

www.weiluai.top {
	redir https://weiluai.top{uri} permanent
}

:80 {
    import velo_site
}
