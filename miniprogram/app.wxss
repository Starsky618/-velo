/**
 * VELO 全局样式
 *
 * 这里定义的样式对所有页面生效，相当于"大楼统一装修标准"。
 * 各页面的 .wxss 文件可以覆盖这里的样式（局部装修优先）。
 *
 * 设计原则（参考 Apple Human Interface Guidelines）：
 * - 大量留白，内容区不要填满
 * - 清晰的信息层级：标题大、正文小、辅助信息最小
 * - 一致的圆角、间距、颜色
 */

/* ── 全局变量（通过 CSS 变量统一管理颜色和间距）── */
page {
  /* 主色调：骑行热情红，来自 velo.jsx 的 #FF2D55 */
  --color-primary: #FF9500;
  --color-primary-light: rgba(255, 149, 0, 0.10);

  /* 文字层级：从深到浅，对应"标题→正文→辅助→占位" */
  --color-text-1: #1C1C1E;
  --color-text-2: #3A3A3C;
  --color-text-3: #8A8A8E;

  /* 背景和分割线 */
  --color-bg: #F2F2F7;
  --color-card: #FFFFFF;
  --color-divider: #E5E5EA;

  /* 功能色（成功/警告/信息） */
  --color-success: #34C759;
  --color-warning: #FF9500;
  --color-info: #5AC8FA;

  /* 间距系统（4px 倍数，保持一致性） */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 36rpx;

  /* 页面默认背景色 */
  background-color: var(--color-bg);
  font-family: -apple-system, 'SF Pro Display', 'Helvetica Neue', sans-serif;
  color: var(--color-text-1);
  font-size: 28rpx;
  line-height: 1.5;
}

/* ── 通用卡片样式 ── */
.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ── 全局按压反馈（MASTER §4.5.1）──
   任何可点元素挂 .tappable：按下缩小变暗，松手"弹"回原位。
   这是"摸起来像苹果原生"的关键——手感来源不是缩放幅度，是松手那一下的"回弹"。
   实现要点（纯 CSS 做出 spring 手感）：
   - 按下（:active）：用快而直接的曲线，立刻缩到位，让按压"跟手"
   - 松手（回到默认态）：用带"过冲"的 cubic-bezier，先弹过头再收回 → 这就是弹性
   缩放幅度 0.94（缩 6%，明显能看见；之前 0.98 太微肉眼分辨不出，已实证看不出）。
   禁用 hover-class（有延迟、手感拖沓）。 */
.tappable {
  /* 松手回弹：曲线末段 1.4 是"过冲"，造成弹一下的手感 */
  transition: transform 0.32s cubic-bezier(.34, 1.56, .64, 1), opacity 0.2s ease;
}
.tappable:active {
  transform: scale(0.94);
  opacity: 0.7;
  /* 按下要跟手：缩放走快曲线，不用回弹（回弹只发生在松手） */
  transition: transform 0.1s ease-out, opacity 0.1s ease-out;
}

/* ── 页面标题区 ── */
.page-header {
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
}

.page-header .subtitle {
  font-size: 24rpx;
  color: var(--color-text-3);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.page-header .title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-1);
  letter-spacing: -1rpx;
  margin-top: 4rpx;
}
