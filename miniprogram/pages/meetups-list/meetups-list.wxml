<view class="meetups-page">
  <view class="topbar">
    <view>
      <view class="title">约骑</view>
      <view class="subtitle">找一条路线，约一群人一起出发</view>
    </view>
    <button class="create-btn" bindtap="onTapCreate">发起约骑</button>
  </view>

  <view wx:if="{{loading && meetups.length === 0}}" class="state">加载中</view>
  <view wx:elif="{{meetups.length === 0}}" class="state">暂时没有开放约骑</view>

  <view wx:else class="list">
    <view class="meetup-card tappable" wx:for="{{meetups}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapMeetup">
      <!-- 轨迹缩略区：canvas 自绘路线形状（图上信息下的大图卡语言）。
           用 hidden 而非 wx:if——canvas DOM 常在才能稳定绘制（陷阱 #17）；
           没有路书轨迹的约骑整块隐藏，不留空区 -->
      <view class="card-track" hidden="{{!item.hasTrack}}">
        <canvas canvas-id="track-{{item.id}}" class="track-canvas"></canvas>
      </view>
      <view class="card-body">
        <view class="card-main">
          <view class="route-name">{{item.snapshot_route_name}}</view>
          <view class="time">{{item.timeText}}</view>
        </view>
        <view class="meeting">{{item.meeting_point}}</view>
        <view class="metrics">
          <text class="metric">{{item.distanceText}}</text>
          <text class="metric" wx:if="{{item.climbText}}">{{item.climbText}}</text>
          <text class="metric">{{item.paceText}}</text>
          <text class="metric seats {{item.full ? 'full' : ''}}">{{item.seatsText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
