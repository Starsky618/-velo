/* 约骑列表——苹果方案（MASTER v0.4）：大图卡语言（轨迹缩略在上、信息在下），
   系统橙 accent，中文字重 ≤600，数据数字 tabular-nums。 */

page {
  background: #f2f2f7;
}

.meetups-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.create-btn {
  flex: 0 0 auto;
  min-width: 176rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ff9500;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

.create-btn:active {
  background: #e07f00;
}

.state {
  margin-top: 180rpx;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meetup-card {
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 轨迹缩略区：浅底出血到卡边。
   ⚠ 旧 canvas API：702×220rpx 必须与 js 绘制坐标 351×110px 保持 2:1，改一处同步另一处 */
.card-track {
  height: 220rpx;
  background: #f7f7f9;
}

.track-canvas {
  width: 702rpx;
  height: 220rpx;
}

.card-body {
  padding: 24rpx 28rpx 26rpx;
}

.card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.route-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.time {
  flex: 0 0 auto;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #e07f00;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.meeting {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #3a3a3c;
}

/* 数据行：纯文字 + 竖 hairline 分隔（灰底小格退场，对齐探索页等宽数据行语言）*/
.metrics {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.metric {
  padding-right: 18rpx;
}

.metric + .metric {
  padding-left: 18rpx;
  border-left: 1rpx solid #e5e5ea;
}

.seats {
  margin-left: auto;
  padding-right: 0;
  color: #3a3a3c;
  font-weight: 600;
}

.seats.full {
  color: #ff3b30;
}
