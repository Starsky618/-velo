page {
  background: #f2f1f6;
}

.meetups-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.subtitle {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.create-btn {
  flex: 0 0 auto;
  min-width: 176rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #ff2d55;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.state {
  margin-top: 180rpx;
  text-align: center;
  color: #86868b;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meetup-card {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
}

.card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.route-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.time {
  flex: 0 0 auto;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #ff2d55;
  font-weight: 700;
}

.meeting {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #3a3a3c;
}

/* flex 而非固定 4 列：爬升缺失隐藏后剩 3 格仍均分铺满、不留空列 */
.metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #8a8a8e;
}

.metrics text {
  flex: 1;
  min-width: 0;
  padding: 12rpx 10rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.metrics .full {
  color: #b91c1c;
  background: #fee2e2;
}
