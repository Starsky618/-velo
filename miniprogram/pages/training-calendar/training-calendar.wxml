<!-- 训练日历页 —— CTL / ATL / TSB 三曲线 -->
<view class="training-page">
  <view class="status-card status-{{summary.current_status_band || 'ok'}}" wx:if="{{summary}}">
    <view class="status-main">
      <text class="status-label">{{summary.current_status_label}}</text>
      <text class="status-copy">{{statusCopy}}</text>
    </view>
    <view class="status-metrics">
      <view class="metric">
        <text class="metric-value">{{summary.current_ctl}}</text>
        <text class="metric-label">健身度 CTL</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{summary.current_atl}}</text>
        <text class="metric-label">疲劳 ATL</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{summary.current_tsb}}</text>
        <text class="metric-label">状态 TSB</text>
      </view>
      <view class="metric">
        <text class="metric-value">{{summary.weekly_tss}}</text>
        <text class="metric-label">本周训练量</text>
      </view>
    </view>
  </view>

  <view class="range-tabs">
    <view
      wx:for="{{ranges}}"
      wx:key="value"
      class="range-tab {{currentRange === item.value ? 'active' : ''}}"
      data-range="{{item.value}}"
      bindtap="onRangeTap"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <view class="chart-card">
    <view class="chart-header">
      <text class="chart-title">训练负荷曲线</text>
      <view class="legend" wx:if="{{dataComplete}}">
        <text class="legend-item ctl">CTL</text>
        <text class="legend-item atl">ATL</text>
        <text class="legend-item tsb">TSB</text>
      </view>
    </view>
    <view class="chart-guide" wx:if="{{dataComplete}}">
      <text>绿线慢慢涨：长期体能在变厚</text>
      <text>黄线冲高：最近练得猛，身体更累</text>
      <text>蓝线低于 -10：更适合轻松骑或休息</text>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <view class="error-state" wx:elif="{{loadError}}">
      <text class="empty-title">训练分析加载失败 / 请重试</text>
    </view>

    <view class="empty-state" wx:elif="{{insufficientPower}}">
      <text class="empty-emoji">⚡</text>
      <text class="empty-title">功率数据不足</text>
      <text class="empty-subtitle">训练负荷曲线需要更多有功率计的骑行记录（当前时间范围内功率记录偏少）</text>
    </view>

    <view class="empty-state" wx:elif="{{!dataComplete}}">
      <text class="empty-emoji">📈</text>
      <text class="empty-title">再骑 {{daysToComplete}} 天能看到完整训练负荷曲线</text>
      <text class="empty-subtitle">我们需要至少 14 天数据，才能算出更稳定的健身度</text>
    </view>

    <!-- 陷阱 #17 防御：canvas 永远在 DOM / 只用 hidden 切显隐 / 不用 wx:if/wx:else -->
    <!-- 否则 dataComplete 翻 true 那一帧 canvas 2d node 未 ready / 90% 设备折线图不渲染 -->
    <view class="canvas-wrap" hidden="{{loading || loadError || !dataComplete}}">
      <canvas type="2d" id="pmc-chart" class="pmc-chart"></canvas>
    </view>
  </view>
</view>
