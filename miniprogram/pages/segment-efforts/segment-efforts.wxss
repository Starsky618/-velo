/* 我的成绩列表（task-4.5 / 跟其他页面统一白底浅灰风格 / 2026-05-15 Tim hotfix）*/

page {
  background: #F2F2F7;
  color: #1D1D1F;
  min-height: 100vh;
}

.page {
  padding-bottom: 80rpx;
}

/* ========== 状态提示（加载 / 失败 / 未登录） ========== */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 0 60rpx;
}

.state-loading text,
.state-text {
  color: #86868B;
  font-size: 30rpx;
}

.btn-login {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: #FF9500;
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* ========== 年份标题 ========== */
.year-title {
  padding: 40rpx 32rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: 1rpx;
  background: #F2F2F7;  /* 跟 page 背景一致 / 不抢戏 */
}

/* ========== 单条成绩行 ========== */
.row {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #FFFFFF;        /* 行用白底 / 跟其他页面卡片风格一致 */
  border-bottom: 1rpx solid #F2F2F7;
}

.row:active {
  background: #FAFAFA;  /* 点击反馈 / 浅灰 */
}

/* 日期列：日期 + PR 黄点 */
.date-col {
  display: flex;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}

.date-text {
  font-size: 32rpx;
  color: #1D1D1F;
  font-weight: 400;
}

.pr-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF9500;       /* 改用品牌橙（白底上更醒目 / 跟黄色对比度不够）*/
  margin-left: 12rpx;
}

/* 数字列：用时 / 速度 / 功率（紧凑横排 / 等宽数字防跳动） */
.stats-col {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 28rpx;
  font-variant-numeric: tabular-nums;
}

.stat {
  font-size: 30rpx;
  color: #1D1D1F;
}

.time-text {
  font-weight: 600;
  color: #1D1D1F;
}

.speed-text,
.power-text {
  color: #86868B;     /* 速度/功率用次级文字色 / 拉开层次 */
}

/* 箭头 */
.arrow {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #C7C7CC;
  flex-shrink: 0;
}
