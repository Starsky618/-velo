/* 约骑战报——苹果方案（MASTER v0.4）：白卡世界（黑底 hero 退场），
   字重 ≤600 铁律（旧版 800 全清），数据数字 tabular，卡 28rpx。 */

page {
  background: #f2f2f7;
}

.report-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.state {
  margin-top: 220rpx;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.content {
  padding-bottom: 48rpx;
}

/* 头卡：白卡 + 橙路线名（仪式感靠大标题字号，不靠深底）*/
.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-name {
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: #e07f00;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  line-height: 54rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* 总计：一张白卡内竖 hairline 分隔（对齐详情页数据卡语言）*/
.totals {
  display: flex;
  margin: 22rpx 0;
  padding: 28rpx 10rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.total-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.total-item + .total-item {
  border-left: 1rpx solid #e5e5ea;
}

.total-value {
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 600;
  color: #1c1c1e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.total-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.total-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.section {
  margin-top: 22rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  width: calc((100% - 24rpx) / 3);
}

.media-thumb {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e9e9ee;
}

.cell-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-cell {
  min-height: 132rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

/* 已交卷：浅橙衬底（成绩到手的庆祝感）；未交卷：浅灰 */
.is-submitted {
  background: rgba(255, 149, 0, 0.06);
  border: 1rpx solid rgba(255, 149, 0, 0.2);
}

.is-gray {
  background: #f2f2f7;
  border: 1rpx solid #e5e5ea;
}

.cell-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.avatar,
.avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex: 0 0 72rpx;
  background: #d1d1d6;
}

.cell-user {
  margin-left: 18rpx;
  min-width: 0;
}

.nickname {
  font-size: 28rpx;
  line-height: 38rpx;
  color: #1c1c1e;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submitted-at {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.cell-stats {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 0 0 auto;
}

.stat {
  min-width: 78rpx;
  text-align: right;
}

.stat-value {
  font-size: 28rpx;
  line-height: 36rpx;
  color: #1c1c1e;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-unit {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8a8a8e;
}

.submit-btn {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #ff9500;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.submit-btn:active {
  background: #e07f00;
}
