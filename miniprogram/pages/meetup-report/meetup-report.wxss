page {
  background: #f2f2f7;
}

.report-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.state {
  margin-top: 220rpx;
  text-align: center;
  color: #86868b;
  font-size: 28rpx;
}

.content {
  padding-bottom: 48rpx;
}

.hero {
  padding: 34rpx;
  border-radius: 18rpx;
  background: #1c1c1e;
  color: #fff;
}

.route-name {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #ffd6df;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 38rpx;
  color: #e5e5ea;
}

.totals {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 0;
}

.total-item {
  flex: 1;
  min-width: 0;
  padding: 22rpx 8rpx;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.total-value {
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.total-unit {
  margin-left: 4rpx;
  font-size: 21rpx;
  color: #8a8a8e;
}

.total-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #86868b;
}

.section {
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #fff;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  width: calc((100% - 24rpx) / 3);
}

.media-thumb {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.cell-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.report-cell {
  min-height: 132rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.is-submitted {
  background: #f9fafb;
  border: 1rpx solid #e5e5ea;
}

.is-gray {
  background: #f3f4f6;
  border: 1rpx solid #e5e5ea;
}

.cell-main {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.avatar,
.avatar-fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex: 0 0 72rpx;
  background: #d1d5db;
}

.cell-user {
  margin-left: 18rpx;
  min-width: 0;
}

.nickname {
  font-size: 28rpx;
  line-height: 38rpx;
  color: #1c1c1e;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submitted-at {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}

.cell-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}

.stat {
  min-width: 78rpx;
  text-align: right;
}

.stat-value {
  font-size: 27rpx;
  line-height: 36rpx;
  color: #1c1c1e;
  font-weight: 800;
}

.stat-unit {
  display: block;
  margin-top: 2rpx;
  font-size: 19rpx;
  color: #86868b;
}

.submit-btn {
  flex: 0 0 136rpx;
  width: 136rpx;
  height: 66rpx;
  line-height: 66rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}
