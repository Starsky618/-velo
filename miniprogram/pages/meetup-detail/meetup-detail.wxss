/* 约骑详情页——苹果方案（MASTER v0.4）：白卡世界，深底霓虹 demo 风全部退场。
   中文字重 ≤600；数据值 tabular 大数字；卡圆角统一 28rpx。 */

page {
  background: #f2f2f7;
}

.detail-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.state {
  margin-top: 220rpx;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.content {
  padding-bottom: 148rpx;
}

/* 头卡：白卡（原黑底 demo 风退场），时间用橙色强调 */
.hero {
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-name {
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #1c1c1e;
}

.time {
  margin-top: 16rpx;
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #e07f00;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.meeting {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #8a8a8e;
}

/* 用 flex 而非固定 4 列 grid：爬升缺失隐藏后，剩下 3 格仍能均分铺满、不留空列 */
.metrics {
  display: flex;
  gap: 14rpx;
  margin: 22rpx 0;
}

.metrics view {
  flex: 1;
  min-width: 0;
  padding: 24rpx 10rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}

.value,
.label {
  display: block;
}

.value {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #1c1c1e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: #8a8a8e;
}

.section {
  margin-top: 22rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #1c1c1e;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #3a3a3c;
}

.row + .row {
  border-top: 1rpx solid #e5e5ea;
}

.description {
  font-size: 29rpx;
  line-height: 1.75;
  color: #3a3a3c;
}

.route-preview-map {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 照片墙：标题行（左标题 + 右"加照片"）+ 3 列 grid */
.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.add-media {
  font-size: 27rpx;
  color: #ff9500;
  font-weight: 600;
}

.media-empty {
  font-size: 26rpx;
  color: #8a8a8e;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
}

.media-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #e9e9ee;
  display: block;
}

.media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.6);
  color: #fff;
  font-size: 28rpx;
}

/* 底部只显示一个按钮（按身份：取消/退出/加入）或一行状态文案，单列全宽 */
.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(28, 28, 30, 0.06);
}

.actions button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 加入和取消都用主色填充（取消是发起人的主操作）；退出是次操作用描边 */
.join,
.cancel {
  background: #ff9500;
  color: #fff;
}

/* 看战报：信息入口不是主操作——iOS tinted 风格（浅橙底橙字），深底荧光 demo 风退场 */
.report-entry {
  background: rgba(255, 149, 0, 0.12);
  color: #e07f00;
  margin-bottom: 16rpx;
}

.leave {
  background: #fff;
  color: #1c1c1e;
  border: 1rpx solid #d1d1d6;
}

.status-hint {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
  font-weight: 500;
}
