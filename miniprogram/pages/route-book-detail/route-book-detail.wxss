.route-book-detail-page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 32rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.state-text {
  padding: 120rpx 0;
  color: #8a8a8e;
  font-size: 28rpx;
  text-align: center;
}

.title-band {
  padding: 24rpx 2rpx 8rpx;
}

.route-label {
  color: #ff9500;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.route-name {
  margin-top: 10rpx;
  color: #1c1c1e;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.22;
}

.route-status {
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.45;
}

.stat-card,
.climb-plan-card,
.map-section,
.export-card {
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 30rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.climb-sequence {
  margin-top: 10rpx;
  color: #1c1c1e;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.climb-list {
  margin-top: 12rpx;
}

.climb-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx solid #e5e5ea;
}

.climb-category {
  flex: none;
  min-width: 88rpx;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  text-align: center;
}

.climb-copy {
  min-width: 0;
  margin-left: 16rpx;
}

.climb-main {
  color: #1c1c1e;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
}

.climb-sub,
.climb-empty,
.climb-boundary-hint,
.rider-climb-line {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 23rpx;
  line-height: 1.45;
}

.rider-climb-line,
.climb-boundary-hint {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 149, 0, 0.10);
  color: #8a5a00;
}

.climb-boundary-hint {
  background: #f2f2f7;
  color: #636366;
}

.rider-scenario-list {
  margin-top: 14rpx;
  border-top: 1rpx solid #e5e5ea;
}

.rider-scenario-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.rider-scenario-label,
.rider-scenario-value {
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
}

.rider-scenario-value,
.rider-scenario-range {
  margin-top: 4rpx;
}

.rider-scenario-range {
  color: #8e8e93;
  font-size: 22rpx;
}

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat + .stat {
  border-left: 1rpx solid #e5e5ea;
}

.stat-v {
  color: #1c1c1e;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-u {
  color: #8a8a8e;
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 4rpx;
}

.stat-k {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
}

.elevation-thumb {
  width: 622rpx;
  height: 140rpx;
  margin-top: 20rpx;
}

.elevation-pending,
.route-empty {
  margin-top: 18rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.section-title,
.export-title {
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

.route-map-preview {
  width: 100%;
  height: 420rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.map-section {
  position: relative;
}

.map-open-label {
  position: absolute;
  left: 50rpx;
  bottom: 42rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
}

.export-subtitle {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.45;
}

.export-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.export-button {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  padding: 0;
}

.export-button.secondary {
  background: #f2f2f7;
  color: #1c1c1e;
}

.export-button[disabled] {
  opacity: 0.58;
}

.export-help-button {
  margin-top: 16rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #ff9500;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  padding: 0;
}

.export-result {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
}

.export-result-label {
  color: #34c759;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.25;
}

.export-result-name {
  margin-top: 6rpx;
  color: #1c1c1e;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.export-result-tip {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.4;
}

.export-next-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.export-copy-button,
.export-share-button {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 72rpx;
  padding: 0;
}

.export-copy-button.primary,
.export-share-button.primary {
  background: #1c1c1e;
  color: #ffffff;
}

.export-share-button.secondary,
.export-copy-button.secondary {
  background: #ffffff;
  color: #1c1c1e;
  border: 1rpx solid #d1d1d6;
}

.export-fallback,
.export-hint {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #8a5a00;
  font-size: 24rpx;
  line-height: 1.45;
}
