.route-detail-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.state-text {
  padding: 120rpx 0;
  color: #6b7280;
  font-size: 28rpx;
  text-align: center;
}

.detail-body {
  padding-top: 24rpx;
}

.hero-cover {
  width: 100%;
  height: 340rpx;
  border-radius: 8rpx;
  background: #f7f3ea;
}

.intro-line {
  margin-top: 22rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.5;
}

.accordion-list {
  margin-top: 24rpx;
}

.accordion-section {
  margin-top: 18rpx;
  background: #ffffff;
  border: 1rpx solid #ececf0;
  border-radius: 8rpx;
  overflow: hidden;
}

.accordion-section.expanded {
  border-color: #e5e7eb;
}

.accordion-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  cursor: pointer;
}

.accordion-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.expand-indicator {
  flex: 0 0 auto;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1;
}

.accordion-body {
  padding: 0 24rpx 24rpx;
}

.accordion-body .md-h2:first-child,
.accordion-body .md-h1:first-child,
.accordion-body .md-p:first-child,
.accordion-body .md-ul:first-child {
  margin-top: 0;
}

.route-map-wrap,
.elevation-section {
  margin-top: 22rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 28rpx;
}

.route-name {
  color: #111827;
  font-size: 44rpx;
  font-weight: 750;
  line-height: 1.22;
}

.city {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.status {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.status.ready {
  color: #0f766e;
  background: #e7f7f3;
}

.status.pending {
  color: #8a5a00;
  background: #fff4d6;
}

.metric-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.metric {
  padding: 10rpx 14rpx;
  color: #f04452;
  background: #fff0f2;
  border-radius: 6rpx;
  font-size: 25rpx;
  font-weight: 650;
}

.section {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #ececf0;
  border-radius: 8rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.highlight {
  margin-top: 10rpx;
  color: #374151;
  font-size: 27rpx;
  line-height: 1.55;
}

.elevation-canvas {
  width: 640rpx;
  height: 256rpx;
}

.route-map {
  width: 100%;
  height: 360rpx;
  border-radius: 8rpx;
}

.start-button {
  margin: 34rpx 0 0;
  height: 92rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: #f04452;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.md-h1 {
  font-size: 36rpx;
  font-weight: 750;
  color: #111827;
  line-height: 1.35;
}

.md-h2 {
  margin-top: 22rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

.md-p,
.md-li {
  color: #374151;
  font-size: 28rpx;
  line-height: 1.7;
}

.md-ul {
  padding-left: 34rpx;
}

.md-img {
  width: 100%;
}
