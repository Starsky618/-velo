/* 路线详情页——苹果方案（MASTER v0.4）：iOS 系统语义色 + 系统橙 accent。
   hero 出血到屏幕边（App Store 详情页式），手风琴做成 iOS inset-grouped
   整卡列表（行间 hairline，不是节节独立卡）。中文字重 ≤600 铁律。 */

.route-detail-page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 0 32rpx 56rpx;
  box-sizing: border-box;
}

.state-text {
  padding: 120rpx 0;
  color: #8a8a8e;
  font-size: 28rpx;
  text-align: center;
}

/* hero 全宽出血：负 margin 抵掉页面左右 padding */
.hero-cover {
  display: block;
  width: calc(100% + 64rpx);
  height: 420rpx;
  margin: 0 -32rpx;
  background: #e9e9ee;
}

.route-name {
  margin-top: 28rpx;
  color: #1c1c1e;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.intro-line {
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 28rpx;
  line-height: 1.55;
}

/* 手风琴：iOS inset-grouped——整组一张大圆角白卡，行间 hairline */
.accordion-list {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.accordion-section + .accordion-section .accordion-title-row {
  border-top: 1rpx solid #e5e5ea;
}

.accordion-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
  padding: 0 30rpx;
}

.accordion-title {
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

/* iOS 式 chevron：› 收起态朝右，展开旋转 90° 朝下 */
.expand-indicator {
  flex: 0 0 auto;
  color: #c5c5c7;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.2s ease-out;
}

.expand-indicator.open {
  transform: rotate(90deg);
}

.accordion-body {
  padding: 4rpx 30rpx 30rpx;
}

.accordion-body .md-h2:first-child,
.accordion-body .md-h1:first-child,
.accordion-body .md-p:first-child,
.accordion-body .md-ul:first-child {
  margin-top: 0;
}

.route-map-wrap,
.elevation-section {
  margin-top: 22rpx;
}

.elevation-canvas {
  width: 640rpx;
  height: 256rpx;
}

.route-map {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
}

/* 主按钮：系统橙、胶囊感大圆角（HIG 主操作语言） */
.start-button {
  margin: 36rpx 0 0;
  height: 96rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: #ff9500;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.start-button:active {
  background: #e07f00;
}

/* rich-text 内容排版（guide.md 渲染出的节点 class） */
.md-h1 {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.35;
}

.md-h2 {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.4;
}

.md-p,
.md-li {
  color: #3a3a3c;
  font-size: 28rpx;
  line-height: 1.7;
}

.md-ul {
  padding-left: 34rpx;
}

.md-img {
  width: 100%;
  border-radius: 16rpx;
}
