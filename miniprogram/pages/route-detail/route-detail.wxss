/* 路线详情页——苹果方案（MASTER v0.4）：iOS 系统语义色 + 系统橙 accent。
   hero 出血到屏幕边（App Store 详情页式），手风琴做成 iOS inset-grouped
   整卡列表（行间 hairline，不是节节独立卡）。中文字重 ≤600 铁律。 */

.route-detail-page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 0 32rpx 56rpx;
  box-sizing: border-box;
}

.state-text {
  padding: 120rpx 0;
  color: #8a8a8e;
  font-size: 28rpx;
  text-align: center;
}

/* hero 全宽出血：负 margin 抵掉页面左右 padding。
   图文融合三件套：包裹层定位 → 底部小面积渐变淡入页面底色 → 标题负 margin 上提坐进淡出区。
   渐变只占图高 ~27%（Tim 拍：参考稿渐变太大看不清图，这里刻意收小） */
.hero-wrap {
  position: relative;
  width: calc(100% + 64rpx);
  height: 520rpx;
  margin: 0 -32rpx;
  background: #e9e9ee;
}

.hero-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx; /* 多压 1rpx 防个别机型渐变与页面底色间露出 1px 接缝 */
  height: 140rpx;
  background: linear-gradient(to bottom, rgba(242, 242, 247, 0), #f2f2f7);
  pointer-events: none; /* 纯装饰层，不挡任何点击 */
}

.route-name {
  position: relative; /* 上提后要压在 hero 上方，否则被图盖住 */
  margin-top: -64rpx;
  color: #1c1c1e;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.25;
}

.intro-line {
  margin-top: 10rpx;
  color: #8a8a8e;
  font-size: 28rpx;
  line-height: 1.55;
}

/* 实景图横滑长廊：卡片化圆角图一字排开，溢出即横滑（不分页不加点，克制）。
   ⚠ scroll-view 横滑三件套缺一不可：white-space nowrap + 子项 inline-block + 关 scrollbar */
.gallery-strip {
  margin-top: 26rpx;
  white-space: nowrap;
  width: 100%;
}

.gallery-photo {
  display: inline-block;
  width: 340rpx;
  height: 230rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  background: #e9e9ee; /* 加载中的占位底色，与 hero 同 */
}

.gallery-photo:last-child {
  margin-right: 0;
}

/* 常显数据卡：三格数据 + 海拔缩略线（一张"路线档案卡"） */
.stat-card {
  margin-top: 26rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx 30rpx 22rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat + .stat {
  border-left: 1rpx solid #e5e5ea;
}

.stat-v {
  color: #1c1c1e;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-u {
  color: #8a8a8e;
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 4rpx;
}

.stat-k {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

/* 旧 canvas API：尺寸必须与 js 绘制坐标 2:1 对应（622×140rpx = 311×70px），改一处必须同步另一处 */
.elevation-thumb {
  width: 622rpx;
  height: 140rpx;
  margin-top: 20rpx;
}

.export-card {
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx 30rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.export-head {
  margin-bottom: 18rpx;
}

.export-title {
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

.export-subtitle {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.45;
}

.export-actions {
  display: flex;
  gap: 16rpx;
}

.export-button {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  padding: 0;
}

.export-button.secondary {
  background: #f2f2f7;
  color: #1c1c1e;
}

.export-button[disabled] {
  opacity: 0.58;
}

.export-help-button {
  margin-top: 16rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #ff9500;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  padding: 0;
}

.export-result {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
}

.export-result-label {
  color: #34c759;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.25;
}

.export-result-name {
  margin-top: 6rpx;
  color: #1c1c1e;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.export-result-tip {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.4;
}

.export-next-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.export-copy-button,
.export-share-button {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 72rpx;
  padding: 0;
}

.export-copy-button.primary {
  background: #1c1c1e;
  color: #ffffff;
}

.export-share-button.secondary {
  background: #ffffff;
  color: #1c1c1e;
  border: 1rpx solid #d1d1d6;
}

.export-fallback {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #8a5a00;
  font-size: 24rpx;
  line-height: 1.45;
}

.export-hint {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 149, 0, 0.10);
  color: #8a5a00;
  font-size: 26rpx;
  line-height: 1.55;
}

/* 手风琴：iOS inset-grouped——整组一张大圆角白卡，行间 hairline */
.accordion-list {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.accordion-section + .accordion-section .accordion-title-row {
  border-top: 1rpx solid #e5e5ea;
}

.accordion-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
  padding: 0 30rpx;
}

.accordion-title {
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

/* iOS 式 chevron：› 收起态朝右，展开旋转 90° 朝下 */
.expand-indicator {
  flex: 0 0 auto;
  color: #c5c5c7;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.2s ease-out;
}

.expand-indicator.open {
  transform: rotate(90deg);
}

.accordion-body {
  padding: 0 30rpx 34rpx;
}

.route-map-wrap,
.elevation-section {
  margin-top: 22rpx;
}

.elevation-canvas {
  width: 640rpx;
  height: 256rpx;
}

.route-paper-canvas {
  width: 640rpx;
  max-width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
}

.route-map-open-label {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
}

.route-map-wrap {
  position: relative;
}

/* 主按钮：系统橙、胶囊感大圆角（HIG 主操作语言） */
.start-button {
  margin: 36rpx 0 0;
  height: 96rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: #ff9500;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.start-button:active {
  background: #e07f00;
}

/* ── rich-text 正文排版（guide.md 渲染节点） ──
   分层三原则：段间留白造呼吸 / 键值表和步骤条造结构 / 600 字重粗体造锚点 */

.md-h1,
.md-h2 {
  margin-top: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.4;
}

.md-p {
  margin-top: 24rpx;
  color: #3a3a3c;
  font-size: 29rpx;
  line-height: 1.8;
}

/* 粗体锚点：600 真字重（strong 的 700 会让中文合成加粗发糊） */
.md-b {
  font-weight: 600;
  color: #1c1c1e;
}

/* 键值行（核心数据节）：iOS 设置页式数据表 */
.md-kv {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.md-kv:last-child {
  border-bottom: none;
}

.md-kv-k {
  color: #8a8a8e;
  font-size: 28rpx;
}

.md-kv-v {
  color: #1c1c1e;
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* 字段块（给真要去的骑友）：橙色小标签独立一行 + 长文值另起一行 */
.md-field {
  margin-top: 32rpx;
}

.md-field-k {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #d97a00;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 8rpx;
  line-height: 1.6;
}

.md-field-v {
  margin-top: 12rpx;
  color: #3a3a3c;
  font-size: 29rpx;
  line-height: 1.75;
}

/* 语录块（骑友怎么说）：语录气泡 + 解释另起一行小字 */
.md-quote {
  margin-top: 28rpx;
}

.md-quote-text {
  padding: 20rpx 26rpx;
  background: #f2f2f7;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  color: #1c1c1e;
  font-size: 29rpx;
  line-height: 1.7;
}

.md-quote-note {
  margin-top: 10rpx;
  padding-left: 10rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 步骤行（怎么骑）：橙色序号导航感 */
.md-step {
  display: flex;
  margin-top: 28rpx;
}

.md-step-n {
  flex: 0 0 52rpx;
  color: #ff9500;
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.7;
}

.md-step-body {
  flex: 1;
  color: #3a3a3c;
  font-size: 29rpx;
  line-height: 1.7;
}

/* 圆点行（普通列表/骑友语录）：自绘橙点，间距可控 */
.md-li {
  display: flex;
  margin-top: 22rpx;
}

.md-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff9500;
  margin: 18rpx 22rpx 0 4rpx;
}

.md-li-body {
  flex: 1;
  color: #3a3a3c;
  font-size: 29rpx;
  line-height: 1.7;
}

.md-img {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 16rpx;
}
