<view class="route-detail-page">
  <view wx:if="{{loading}}" class="state-text">加载中</view>
  <view wx:elif="{{error}}" class="state-text">{{error}}</view>

  <view wx:else class="detail-body">
    <!-- hero：封面出血到屏幕边，底部一小段渐变淡入页面底色，标题坐在淡出区上（图文融合，Tim 2026-06-12 拍：渐变面积要小） -->
    <view class="hero-wrap">
      <image class="hero-cover" src="{{coverSrc}}" mode="aspectFill" />
      <view class="hero-fade"></view>
    </view>
    <view wx:if="{{guide.name}}" class="route-name">{{guide.name}}</view>
    <view wx:if="{{introText}}" class="intro-line">{{introText}}</view>

    <!-- 常显数据卡：距离/累计爬升/显著爬坡 + 海拔缩略线（全程累计爬升不能冒充均坡） -->
    <view wx:if="{{routeStats.length}}" class="stat-card">
      <view class="stat-row">
        <view class="stat" wx:for="{{routeStats}}" wx:key="k">
          <view class="stat-v">{{item.v}}<text class="stat-u">{{item.u}}</text></view>
          <view class="stat-k">{{item.k}}</view>
        </view>
      </view>
      <canvas canvas-id="elevation-thumb" class="elevation-thumb" hidden="{{!hasElevation}}"></canvas>
    </view>

    <view wx:if="{{climbPlanView.ready}}" class="climb-plan-card">
      <view class="climb-plan-title">这条路线由哪些坡组成</view>
      <view class="climb-sequence">{{climbPlanView.sequence}}</view>
      <view wx:if="{{climbPlanView.climbs.length}}" class="climb-list">
        <view wx:for="{{climbPlanView.climbs}}" wx:key="order" class="climb-row">
          <view class="climb-category" style="background: {{item.color}}">{{item.category}}</view>
          <view class="climb-copy">
            <view class="climb-main">第{{item.order}}坡 · {{item.shapeLabels || item.shape}}</view>
            <view class="climb-sub">{{item.distance}} / 均坡{{item.grade}} / +{{item.gain}}</view>
            <view class="climb-sub">路线第{{item.startKm}}–{{item.endKm}}km {{item.max500}} {{item.candidate ? '· 地形候选' : ''}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="climb-empty">没有达到 500m / 3% / score 1500 的显著爬坡</view>
      <view wx:if="{{climbPlanView.riderScenarios.length}}" class="rider-scenario-list">
        <view wx:for="{{climbPlanView.riderScenarios}}" wx:key="key" class="rider-scenario-row">
          <view class="rider-scenario-label">{{item.label}}</view>
          <view class="rider-scenario-value">{{item.power}} · {{item.powerPerKg}} · {{item.time}}</view>
          <view wx:if="{{item.timeRange}}" class="rider-scenario-range">情景范围 {{item.timeRange}}</view>
          <view wx:if="{{item.climbTargets}}" class="rider-scenario-range">{{item.climbTargets}}</view>
        </view>
      </view>
      <view wx:if="{{climbPlanView.riderLine}}" class="rider-climb-line">{{climbPlanView.riderLine}}</view>
      <view wx:if="{{climbPlanView.riderContextLine}}" class="climb-boundary-hint">{{climbPlanView.riderContextLine}}</view>
      <view wx:if="{{climbPlanView.boundaryStatus === 'ambiguous'}}" class="climb-boundary-hint">地形边界在不同平滑尺度下不稳定，类别仅作候选。</view>
      <view wx:if="{{climbPlanView.boundaryStatus === 'not_assessed'}}" class="climb-boundary-hint">缺少多尺度边界复核，本次坡段边界尚未评估。</view>
    </view>

    <view wx:if="{{guide.export_ready}}" class="export-card">
      <view class="export-head">
        <view class="export-title">导出到码表</view>
        <view class="export-subtitle">先生成路线文件，再复制链接到浏览器下载</view>
      </view>
      <view class="export-actions">
        <button
          class="export-button"
          data-format="gpx"
          loading="{{exportingFormat === 'gpx'}}"
          disabled="{{exporting}}"
          bindtap="onDownloadRouteExport">下载 GPX</button>
        <button
          class="export-button secondary"
          data-format="tcx"
          loading="{{exportingFormat === 'tcx'}}"
          disabled="{{exporting}}"
          bindtap="onDownloadRouteExport">下载 TCX</button>
      </view>
      <button class="export-help-button" bindtap="onShowExportHelp">两步导入</button>
      <view wx:if="{{lastExportFilename}}" class="export-result">
        <view class="export-result-label">已下载</view>
        <view class="export-result-name">{{lastExportFilename}}</view>
        <view class="export-result-tip">下一步复制链接，用手机浏览器打开，再去码表 App 导入。</view>
      </view>
      <view wx:if="{{lastExportTempPath}}" class="export-next-actions">
        <button class="export-copy-button primary" bindtap="onCopyLastExportLink">复制下载链接</button>
        <button class="export-share-button secondary" bindtap="onShareLastExport">发送到微信</button>
      </view>
      <view wx:if="{{exportSendFailed}}" class="export-fallback">{{exportSendError}}</view>
    </view>
    <view wx:elif="{{exportHint}}" class="export-hint">{{exportHint}}</view>

    <!-- 实景图横滑长廊：图片来自 content/routes/<路线>/（Tim 访达增删），点开全屏可翻页保存 -->
    <scroll-view wx:if="{{gallerySrcs.length}}" class="gallery-strip" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
      <image
        wx:for="{{gallerySrcs}}"
        wx:key="*this"
        class="gallery-photo tappable"
        src="{{item}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        data-src="{{item}}"
        bindtap="onTapGalleryPhoto" />
    </scroll-view>

    <view class="accordion-list">
      <view class="accordion-section" wx:for="{{sections}}" wx:key="title">
        <view class="accordion-title-row tappable" data-index="{{index}}" bindtap="toggleSection">
          <view class="accordion-title">{{item.title}}</view>
          <view class="expand-indicator {{item.expanded ? 'open' : ''}}">›</view>
        </view>
        <view class="accordion-body" hidden="{{!item.expanded}}">
          <rich-text nodes="{{item.nodes}}" />
          <view wx:if="{{guide.ready && item.hasElevationSlot}}" class="elevation-section" hidden="{{!item.expanded || !hasElevation}}">
            <canvas canvas-id="elevation-canvas" class="elevation-canvas" hidden="{{!item.expanded || !hasElevation}}"></canvas>
          </view>
          <view wx:if="{{guide.ready && item.expanded && item.hasMapSlot && routePreviewVisible}}" class="route-map-wrap">
            <canvas canvas-id="route-paper-preview" class="route-paper-canvas" bindtap="onOpenRouteMapPage"></canvas>
            <view class="route-map-open-label" bindtap="onOpenRouteMapPage">查看地图</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
