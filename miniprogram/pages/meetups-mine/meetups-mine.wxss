/* 我的约骑（我发起的 / 我加入的）——苹果方案（MASTER v0.4）。
   对齐约骑列表页新语言：橙 accent、字重 ≤600、卡 28rpx、hairline 数据行；
   状态药丸按语义色分流（开放=橙 / 完成=蓝 / 草稿·取消=灰）。 */

page {
  background: #f2f2f7;
}

.mine-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部两 tab：选中橙底白字 */
.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: #8a8a8e;
  font-size: 28rpx;
  font-weight: 600;
}

.tab.active {
  background: #ff9500;
  color: #fff;
}

.state {
  margin-top: 180rpx;
  text-align: center;
  color: #8a8a8e;
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meetup-card {
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.route-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* 状态药丸：语义色 tinted（浅底深字）*/
.status-tag {
  flex: 0 0 auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 600;
}

.status-OPEN {
  background: rgba(255, 149, 0, 0.12);
  color: #e07f00;
}

.status-DRAFT {
  background: #f2f2f7;
  color: #8a8a8e;
}

.status-CANCELLED {
  background: #f2f2f7;
  color: #8a8a8e;
}

.status-COMPLETED {
  background: rgba(0, 122, 255, 0.1);
  color: #0a6cd6;
}

.time {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #e07f00;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.meeting {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #3a3a3c;
}

/* 数据行：纯文字 + 竖 hairline 分隔（同约骑列表页）*/
.metrics {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.metric {
  padding-right: 18rpx;
}

.metric + .metric {
  padding-left: 18rpx;
  border-left: 1rpx solid #e5e5ea;
}

.seats {
  margin-left: auto;
  padding-right: 0;
  color: #3a3a3c;
  font-weight: 600;
}

.seats.full {
  color: #ff3b30;
}
