<view class="mine-page">
  <view class="tabs">
    <view class="tab {{role === 'created' ? 'active' : ''}}" data-role="created" bindtap="onTapTab">我发起的</view>
    <view class="tab {{role === 'joined' ? 'active' : ''}}" data-role="joined" bindtap="onTapTab">我加入的</view>
  </view>

  <view wx:if="{{loading && meetups.length === 0}}" class="state">加载中</view>
  <view wx:elif="{{meetups.length === 0}}" class="state">{{role === 'created' ? '你还没发起过约骑' : '你还没加入过约骑'}}</view>

  <view wx:else class="list">
    <view class="meetup-card" wx:for="{{meetups}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapMeetup">
      <view class="card-main">
        <view class="route-name">{{item.snapshot_route_name}}</view>
        <view class="status-tag status-{{item.status}}">{{item.statusText}}</view>
      </view>
      <view class="time">{{item.timeText}}</view>
      <view class="meeting">{{item.meeting_point}}</view>
      <view class="metrics">
        <text class="metric">{{item.distanceText}}</text>
        <text class="metric" wx:if="{{item.climbText}}">{{item.climbText}}</text>
        <text class="metric">{{item.paceText}}</text>
        <text class="metric seats {{item.full ? 'full' : ''}}">{{item.seatsText}}</text>
      </view>
    </view>
  </view>
</view>
