<!--
  骑行详情页 — 一次骑行的完整报告
  设计参考：Strava 骑行详情 + Apple Fitness 卡片风格
  布局顺序：hero → 途经赛段 → 海拔剖面 → 速度 → 功率 → 心率 → 分段表
-->

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:if="{{!loading && activity}}">

  <!-- ====== 深色头部卡片（距离/时长/爬升） ====== -->
  <view class="hero-card">
    <view class="hero-top">
      <text class="hero-title">{{activity.title || '骑行记录'}}</text>
      <text class="hero-date">{{dateText}}</text>
    </view>
    <view class="hero-stats">
      <view class="hero-item">
        <text class="hero-value">{{activity.distance || 0}}</text>
        <text class="hero-unit">km</text>
        <text class="hero-label">距离</text>
      </view>
      <view class="hero-sep"></view>
      <view class="hero-item">
        <text class="hero-value">{{durationText}}</text>
        <text class="hero-unit"> </text>
        <text class="hero-label">时长</text>
      </view>
      <view class="hero-sep"></view>
      <view class="hero-item">
        <text class="hero-value">{{elevationGainText}}</text>
        <text class="hero-unit">m</text>
        <text class="hero-label">爬升</text>
      </view>
    </view>
  </view>

  <!-- ====== 途经赛段（Strava Segment Efforts 风格） ====== -->
  <view class="section-card" wx:if="{{hasSegments}}">
    <view class="segment-header">
      <text class="segment-title">途经赛段</text>
      <text class="segment-count">{{segments.length}} 个</text>
    </view>
    <view class="segment-list">
      <view class="segment-item {{item.isPr ? 'segment-pr' : ''}}" wx:for="{{segments}}" wx:key="segment_id">
        <view class="segment-left">
          <text class="segment-name">{{item.name}}</text>
          <view class="segment-meta">
            <text class="segment-time">{{item.timeText}}</text>
            <text class="segment-speed" wx:if="{{item.avgSpeed}}">{{item.avgSpeed}} km/h</text>
            <text class="segment-power" wx:if="{{item.avgPower}}">{{item.avgPower}} W</text>
          </view>
        </view>
        <view class="segment-right">
          <view class="segment-rank-badge {{item.rank <= 3 ? 'top3' : ''}}">
            <text class="segment-rank-num">#{{item.rank}}</text>
          </view>
          <text class="segment-pr-tag" wx:if="{{item.isPr}}">PR</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ====== 海拔剖面图（Strava 风格灰色面积图） ====== -->
  <view class="section-card" wx:if="{{hasElevation}}">
    <view class="elevation-header">
      <text class="elevation-title">海拔</text>
    </view>
    <view class="elevation-canvas-wrap">
      <canvas type="2d" id="elevationCanvas" class="elevation-canvas"></canvas>
    </view>
    <view class="elevation-stats">
      <view class="elevation-stat-row">
        <text class="elevation-stat-label">爬升海拔</text>
        <text class="elevation-stat-value">{{elevationGainText}} m</text>
      </view>
      <view class="elevation-stat-row">
        <text class="elevation-stat-label">最高海拔</text>
        <text class="elevation-stat-value">{{maxElevation}} m</text>
      </view>
    </view>
  </view>

  <!-- ====== 速度卡片 ====== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-dot speed"></view>
      <text class="section-title">速度</text>
    </view>
    <view class="metric-row">
      <view class="metric">
        <text class="metric-value speed">{{activity.avg_speed || '-'}}</text>
        <text class="metric-sub">km/h</text>
        <text class="metric-label">平均</text>
      </view>
      <view class="metric">
        <text class="metric-value speed">{{activity.max_speed || '-'}}</text>
        <text class="metric-sub">km/h</text>
        <text class="metric-label">最高</text>
      </view>
      <view class="metric" wx:if="{{activity.avg_cadence}}">
        <text class="metric-value speed">{{activity.avg_cadence}}</text>
        <text class="metric-sub">rpm</text>
        <text class="metric-label">踏频</text>
      </view>
    </view>
  </view>

  <!-- ====== 功率卡片 ====== -->
  <view class="section-card" wx:if="{{activity.avg_power}}">
    <view class="section-header">
      <view class="section-dot power"></view>
      <text class="section-title">功率</text>
    </view>
    <view class="metric-row">
      <view class="metric">
        <text class="metric-value power">{{activity.avg_power}}</text>
        <text class="metric-sub">W</text>
        <text class="metric-label">平均</text>
      </view>
      <view class="metric">
        <text class="metric-value power">{{activity.max_power || '-'}}</text>
        <text class="metric-sub">W</text>
        <text class="metric-label">最大</text>
      </view>
      <view class="metric" wx:if="{{activity.calories}}">
        <text class="metric-value power">{{activity.calories}}</text>
        <text class="metric-sub">kcal</text>
        <text class="metric-label">热量</text>
      </view>
    </view>

    <!-- 功率区间可视化 -->
    <view class="zones" wx:if="{{activity.power_zones.length}}">
      <view class="zones-label">功率区间分布</view>
      <view class="zone-row" wx:for="{{activity.power_zones}}" wx:key="zone">
        <text class="zone-tag" style="background: {{item.color || '#FF9500'}};">Z{{item.zone}}</text>
        <view class="zone-track">
          <view class="zone-fill" style="width: {{item.percent > 0 ? item.percent : 0.5}}%; background: {{item.color || '#FF9500'}};"></view>
        </view>
        <text class="zone-pct">{{item.percent}}%</text>
        <text class="zone-time">{{item.name || ''}}</text>
      </view>
    </view>
  </view>

  <!-- ====== 心率卡片 ====== -->
  <view class="section-card" wx:if="{{activity.avg_hr}}">
    <view class="section-header">
      <view class="section-dot hr"></view>
      <text class="section-title">心率</text>
    </view>
    <view class="metric-row">
      <view class="metric">
        <text class="metric-value hr">{{activity.avg_hr}}</text>
        <text class="metric-sub">bpm</text>
        <text class="metric-label">平均</text>
      </view>
      <view class="metric">
        <text class="metric-value hr">{{activity.max_hr || '-'}}</text>
        <text class="metric-sub">bpm</text>
        <text class="metric-label">最高</text>
      </view>
    </view>
  </view>

  <!-- ====== 每公里分段 ====== -->
  <view class="section-card" wx:if="{{activity.splits.length}}">
    <view class="section-header">
      <view class="section-dot split"></view>
      <text class="section-title">每公里分段</text>
    </view>
    <view class="split-table">
      <view class="split-head">
        <text class="split-cell km">KM</text>
        <text class="split-cell">均速</text>
        <text class="split-cell" wx:if="{{activity.avg_power}}">功率</text>
        <text class="split-cell" wx:if="{{activity.avg_hr}}">心率</text>
        <text class="split-cell">爬升</text>
      </view>
      <view class="split-row" wx:for="{{activity.splits}}" wx:key="index">
        <text class="split-cell km">{{index + 1}}</text>
        <text class="split-cell">{{item.avg_speed || '-'}}</text>
        <text class="split-cell" wx:if="{{activity.avg_power}}">{{item.avg_power || '-'}}</text>
        <text class="split-cell" wx:if="{{activity.avg_hr}}">{{item.avg_hr || '-'}}</text>
        <text class="split-cell">{{item.elevation_gain || '-'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部留白（防止被 tabBar 遮挡） -->
  <view style="height: 60rpx;"></view>
</view>
