<!--
  骑行详情页 — 一次骑行的完整报告
  设计参考：Strava 骑行详情 + Apple Fitness 卡片风格
  布局顺序：hero → 途经赛段 → 海拔剖面 → 速度 → 功率 → 心率 → 分段表
-->

<wxs src="../../utils/format.wxs" module="f" />

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:if="{{!loading && activity}}">

  <!-- ====== 深色头部卡片（距离/时长/爬升） ====== -->
  <view class="hero-card">
    <view class="hero-top">
      <view class="hero-title-wrap">
        <text class="hero-title">{{activity.title || '骑行记录'}}</text>
        <text class="hero-date">{{dateText}}</text>
      </view>
      <!-- task-4.6：隐私设置入口（仅 owner 可见） -->
      <view class="privacy-btn" wx:if="{{isOwner}}" bindtap="togglePrivacyDrawer">
        <text class="privacy-icon">⚙</text>
      </view>
    </view>
    <view class="hero-stats">
      <view class="hero-item">
        <text class="hero-value">{{f.km(activity.distance || 0)}}</text>
        <text class="hero-unit">km</text>
        <text class="hero-label">距离</text>
      </view>
      <view class="hero-sep"></view>
      <view class="hero-item">
        <text class="hero-value">{{headerTimeText}}</text>
        <text class="hero-unit"> </text>
        <text class="hero-label">时长</text>
      </view>
      <view class="hero-sep"></view>
      <view class="hero-item">
        <text class="hero-value">{{elevationGainText}}</text>
        <text class="hero-unit">m</text>
        <text class="hero-label">爬升</text>
      </view>
    </view>
  </view>

  <!-- ====== 途经赛段（Strava Segment Efforts 风格） ====== -->
  <view class="section-card" wx:if="{{hasSegments}}">
    <view class="segment-header">
      <text class="segment-title">途经赛段</text>
      <text class="segment-count">{{segments.length}} 个</text>
    </view>
    <view class="segment-list">
      <view class="segment-item {{item.isPr ? 'segment-pr' : ''}}" wx:for="{{segments}}" wx:key="segment_id"
            bindtap="goSegment" data-id="{{item.segment_id}}">
        <view class="segment-left">
          <text class="segment-name">{{item.name}}</text>
          <view class="segment-meta">
            <text class="segment-time">{{item.timeText}}</text>
            <text class="segment-speed" wx:if="{{item.avgSpeed}}">{{item.avgSpeed}} km/h</text>
            <text class="segment-power" wx:if="{{item.avgPower}}">{{item.avgPower}} W</text>
          </view>
        </view>
        <view class="segment-right">
          <view class="segment-rank-badge {{item.rank <= 3 ? 'top3' : ''}}">
            <text class="segment-rank-num">#{{item.rank}}</text>
          </view>
          <text class="segment-pr-tag" wx:if="{{item.isPr}}">PR</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ====== 海拔剖面图（Strava 风格灰色面积图） ====== -->
  <view class="section-card" wx:if="{{hasElevation}}">
    <view class="elevation-header">
      <text class="elevation-title">海拔</text>
    </view>
    <view class="elevation-canvas-wrap">
      <canvas type="2d" id="elevationCanvas" class="elevation-canvas"
              data-chart="elevation"
              bindtouchstart="onChartTouchStart"
              bindtouchmove="onChartTouchMove"
              bindtouchend="onChartTouchEnd"
              bindtouchcancel="onChartTouchEnd"></canvas>
    </view>
    <view class="elevation-stats">
      <view class="elevation-stat-row">
        <text class="elevation-stat-label">爬升海拔</text>
        <text class="elevation-stat-value">{{elevationGainText}} m</text>
      </view>
      <view class="elevation-stat-row">
        <text class="elevation-stat-label">最高海拔</text>
        <text class="elevation-stat-value">{{maxElevation}} m</text>
      </view>
    </view>
  </view>

  <!-- ====== 速度卡片（含曲线图） ====== -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-dot speed"></view>
      <text class="section-title">速度</text>
    </view>
    <view class="chart-canvas-wrap" hidden="{{!hasTimeseries}}">
      <canvas type="2d" id="speedCanvas" class="chart-canvas"
              data-chart="speed"
              bindtouchstart="onChartTouchStart"
              bindtouchmove="onChartTouchMove"
              bindtouchend="onChartTouchEnd"
              bindtouchcancel="onChartTouchEnd"></canvas>
    </view>
    <view class="metric-list">
      <!-- 缺失整行隐藏，不显示 - 占位（!= null 防 truthiness：0 视为合法值仍显示） -->
      <view class="metric-row" wx:if="{{activity.avg_speed != null}}">
        <text class="metric-label">平均速度</text>
        <text class="metric-value">{{activity.avg_speed}}<text class="metric-unit">km/h</text></text>
      </view>
      <view class="metric-row" wx:if="{{activity.max_speed != null}}">
        <text class="metric-label">最大速度</text>
        <text class="metric-value">{{activity.max_speed}}<text class="metric-unit">km/h</text></text>
      </view>
      <!-- movingTimeText 缺失时 JS 返 ''，整行隐藏 -->
      <view class="metric-row" wx:if="{{movingTimeText}}">
        <text class="metric-label">移动时间</text>
        <text class="metric-value">{{movingTimeText}}</text>
      </view>
      <view class="metric-row" wx:if="{{durationText}}">
        <text class="metric-label">全程耗时</text>
        <text class="metric-value">{{durationText}}</text>
      </view>
    </view>
  </view>

  <!-- ====== 功率卡片（含曲线图） ====== -->
  <view class="section-card" wx:if="{{activity.avg_power}}">
    <view class="section-header">
      <view class="section-dot power"></view>
      <text class="section-title">功率</text>
    </view>
    <view class="chart-canvas-wrap" hidden="{{!hasTimeseries || !hasPowerChart}}">
      <canvas type="2d" id="powerCanvas" class="chart-canvas"
              data-chart="power"
              bindtouchstart="onChartTouchStart"
              bindtouchmove="onChartTouchMove"
              bindtouchend="onChartTouchEnd"
              bindtouchcancel="onChartTouchEnd"></canvas>
    </view>
    <view class="metric-list">
      <view class="metric-row">
        <text class="metric-label">平均功率</text>
        <text class="metric-value power">{{activity.avg_power}}<text class="metric-unit">W</text></text>
      </view>
      <!-- 缺失整行隐藏，不显示 - 占位 -->
      <view class="metric-row" wx:if="{{activity.max_power != null}}">
        <text class="metric-label">最大功率</text>
        <text class="metric-value">{{activity.max_power}}<text class="metric-unit">W</text></text>
      </view>
      <view class="metric-row" wx:if="{{activity.power_per_kg}}">
        <text class="metric-label">W/kg</text>
        <text class="metric-value power">{{activity.power_per_kg}}<text class="metric-unit">w/kg</text></text>
      </view>
      <view class="metric-row" wx:if="{{activity.normalized_power}}">
        <text class="metric-label">标准化功率 NP</text>
        <text class="metric-value power">{{activity.normalized_power}}<text class="metric-unit">W</text></text>
      </view>
      <view class="metric-row" wx:if="{{activity.intensity_factor}}">
        <text class="metric-label">强度系数 IF</text>
        <text class="metric-value">{{activity.intensity_factor}}</text>
      </view>
      <view class="metric-row" wx:if="{{activity.tss}}">
        <text class="metric-label">训练分数 TSS</text>
        <text class="metric-value">{{activity.tss}}</text>
      </view>
      <view class="metric-row" wx:if="{{activity.calories}}">
        <text class="metric-label">热量</text>
        <text class="metric-value power">{{activity.calories}}<text class="metric-unit">kcal</text></text>
      </view>
    </view>

    <!-- 功率区间可视化 -->
    <view class="zones" wx:if="{{activity.power_zones.length}}">
      <view class="zones-meta">
        <text wx:if="{{activity.snapshot_ftp}}">按 FTP {{activity.snapshot_ftp}}W 算 / </text>
        <text>默认不计 0W</text>
      </view>
      <view class="zones-label">功率区间分布</view>
      <view class="zone-row" wx:for="{{activity.power_zones}}" wx:key="zone">
        <text class="zone-tag" style="background: {{item.color || '#FF9500'}};">{{item.zoneLabel || item.zone}}</text>
        <view class="zone-track">
          <view class="zone-fill" style="width: {{item.percent > 0 ? item.percent : 0.5}}%; background: {{item.color || '#FF9500'}};"></view>
        </view>
        <text class="zone-pct">{{item.percent}}%</text>
        <text class="zone-time">{{item.name || ''}} {{item.timeText || ''}}</text>
      </view>
    </view>
  </view>

  <!-- ====== 单次 activity 功率曲线分析（独立组件，自己请求/自己画图） ====== -->
  <activity-power-curve-card activity-id="{{activity.id}}"></activity-power-curve-card>

  <!-- ====== 心率卡片（含曲线图） ====== -->
  <view class="section-card" wx:if="{{activity.avg_hr}}">
    <view class="section-header">
      <view class="section-dot hr"></view>
      <text class="section-title">心率</text>
    </view>
    <view class="chart-canvas-wrap" hidden="{{!hasTimeseries || !hasHrChart}}">
      <canvas type="2d" id="hrCanvas" class="chart-canvas"
              data-chart="hr"
              bindtouchstart="onChartTouchStart"
              bindtouchmove="onChartTouchMove"
              bindtouchend="onChartTouchEnd"
              bindtouchcancel="onChartTouchEnd"></canvas>
    </view>
    <view class="metric-list">
      <view class="metric-row">
        <text class="metric-label">平均心率</text>
        <text class="metric-value hr">{{activity.avg_hr}}<text class="metric-unit">bpm</text></text>
      </view>
      <!-- 缺失整行隐藏，不显示 - 占位 -->
      <view class="metric-row" wx:if="{{activity.max_hr != null}}">
        <text class="metric-label">最大心率</text>
        <text class="metric-value">{{activity.max_hr}}<text class="metric-unit">bpm</text></text>
      </view>
    </view>
  </view>

  <!-- ====== 踏频卡片（含曲线图，仅有踏频数据时显示） ====== -->
  <view class="section-card" wx:if="{{hasTimeseries && hasCadenceChart}}">
    <view class="section-header">
      <view class="section-dot cadence"></view>
      <text class="section-title">踏频</text>
    </view>
    <view class="chart-canvas-wrap">
      <canvas type="2d" id="cadenceCanvas" class="chart-canvas"
              data-chart="cadence"
              bindtouchstart="onChartTouchStart"
              bindtouchmove="onChartTouchMove"
              bindtouchend="onChartTouchEnd"
              bindtouchcancel="onChartTouchEnd"></canvas>
    </view>
    <view class="metric-list">
      <view class="metric-row" wx:if="{{activity.avg_cadence}}">
        <text class="metric-label">平均踏频</text>
        <text class="metric-value cadence">{{activity.avg_cadence}}<text class="metric-unit">rpm</text></text>
      </view>
      <view class="metric-row" wx:if="{{activity.max_cadence}}">
        <text class="metric-label">最大踏频</text>
        <text class="metric-value cadence">{{activity.max_cadence}}<text class="metric-unit">rpm</text></text>
      </view>
    </view>
  </view>

  <!-- ====== 每公里分段 ====== -->
  <view class="section-card" wx:if="{{activity.splits.length}}">
    <view class="section-header">
      <view class="section-dot split"></view>
      <text class="section-title">每公里分段</text>
    </view>
    <view class="split-table">
      <view class="split-head">
        <text class="split-cell km">KM</text>
        <text class="split-cell">均速</text>
        <text class="split-cell" wx:if="{{activity.avg_power}}">功率</text>
        <text class="split-cell" wx:if="{{activity.avg_hr}}">心率</text>
        <text class="split-cell">爬升</text>
      </view>
      <!-- 表格列固定，缺失值留空（不渲染 - 占位）；直接渲染原值能正确显示 0，
           而 || '-' 会把 0 误显示成 '-' -->
      <view class="split-row" wx:for="{{activity.splits}}" wx:key="index">
        <text class="split-cell km">{{index + 1}}</text>
        <text class="split-cell">{{item.avg_speed}}</text>
        <text class="split-cell" wx:if="{{activity.avg_power}}">{{item.avg_power}}</text>
        <text class="split-cell" wx:if="{{activity.avg_hr}}">{{item.avg_hr}}</text>
        <text class="split-cell">{{item.elevation_gain}}</text>
      </view>
    </view>
  </view>

  <!-- 底部留白（防止被 tabBar 遮挡） -->
  <view style="height: 60rpx;"></view>
</view>

<!-- task-4.6：隐私设置抽屉（点齿轮 → 弹出底部抽屉 / 3 个 switch） -->
<view class="privacy-mask" wx:if="{{privacyDrawerOpen}}" bindtap="togglePrivacyDrawer"></view>
<view class="privacy-drawer {{privacyDrawerOpen ? 'open' : ''}}">
  <view class="privacy-drawer-head">
    <text class="privacy-drawer-title">隐私设置</text>
    <text class="privacy-drawer-close" bindtap="togglePrivacyDrawer">完成</text>
  </view>
  <view class="privacy-row">
    <view class="privacy-row-text">
      <text class="privacy-row-label">仅自己可见</text>
      <text class="privacy-row-desc">开启后，他人将看不到这条骑行</text>
    </view>
    <switch checked="{{privacyForm.visibility === 'private'}}" bindchange="onPrivacyVisibilityChange" color="#FF6B00" />
  </view>
  <view class="privacy-row">
    <view class="privacy-row-text">
      <text class="privacy-row-label">隐藏功率数据</text>
      <text class="privacy-row-desc">他人查看时功率卡片整块消失</text>
    </view>
    <switch checked="{{privacyForm.hide_power}}" bindchange="onPrivacyHidePowerChange" color="#FF6B00" />
  </view>
  <view class="privacy-row">
    <view class="privacy-row-text">
      <text class="privacy-row-label">隐藏心率数据</text>
      <text class="privacy-row-desc">他人查看时心率卡片整块消失</text>
    </view>
    <switch checked="{{privacyForm.hide_heartrate}}" bindchange="onPrivacyHideHeartrateChange" color="#FF6B00" />
  </view>
</view>
