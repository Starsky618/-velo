/* 骑行详情页样式 — Apple Fitness 风格 */

/* ── 加载中 ── */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-divider);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-3);
}

/* ══════ 深色头部卡片 ══════ */
.hero-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, #1D1D1F, #2C2C2E);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  position: relative;
}

/* 装饰光效（克制的，不是液态玻璃那种） */
.hero-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 45, 85, 0.15), transparent 70%);
  pointer-events: none;
}

.hero-top {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  letter-spacing: -0.5rpx;
}

.hero-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
  display: block;
}

.hero-stats {
  display: flex;
  align-items: center;
}

.hero-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1rpx;
}

.hero-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

.hero-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
  font-weight: 500;
}

.hero-sep {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ══════ 海拔剖面图 ══════ */

/*
 * 海拔区块的标题用 Strava 风格：大号加粗，没有彩色圆点。
 * 和下面速度/功率/心率卡片的小圆点标题形成层级差异——
 * 海拔是"大区块"（有图表），速度等是"数据卡片"（纯数字）。
 */
.elevation-header {
  margin-bottom: 16rpx;
}

.elevation-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-1);
  letter-spacing: -0.5rpx;
}

/* Canvas 容器：固定高度，宽度撑满卡片 */
.elevation-canvas-wrap {
  width: 100%;
  height: 300rpx;
}

.elevation-canvas {
  width: 100%;
  height: 100%;
}

/* 海拔汇总数据（图表下方的"爬升海拔"/"最高海拔"） */
.elevation-stats {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-divider);
}

.elevation-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

/* 和 Strava 保持一致：左侧标签偏灰，右侧数值加粗 */
.elevation-stat-label {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.elevation-stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

/* ══════ 数据卡片通用 ══════ */
.section-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 28rpx 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* 彩色小圆点标识 */
.section-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.section-dot.speed { background: #5AC8FA; }
.section-dot.power { background: #FF9500; }
.section-dot.hr { background: #FF2D55; }
.section-dot.split { background: #AF52DE; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
}

/* ── 数据指标行 ── */
.metric-row {
  display: flex;
  justify-content: space-around;
}

.metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 140rpx;
}

.metric-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-1);
  line-height: 1;
  letter-spacing: -1rpx;
}

/* 不同类型用不同颜色 */
.metric-value.speed { color: #5AC8FA; }
.metric-value.power { color: #FF9500; }
.metric-value.hr { color: #FF2D55; }

.metric-sub {
  font-size: 20rpx;
  color: var(--color-text-3);
  margin-top: 4rpx;
}

.metric-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: 4rpx;
}

/* ══════ 功率区间可视化 ══════ */
.zones {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-divider);
}

.zones-label {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-bottom: 16rpx;
}

.zone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.zone-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  width: 48rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.zone-track {
  flex: 1;
  height: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 10rpx;
  overflow: hidden;
}

.zone-fill {
  height: 100%;
  border-radius: 10rpx;
  min-width: 4rpx;
}

.zone-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}

.zone-time {
  font-size: 20rpx;
  color: var(--color-text-3);
  width: 80rpx;
  flex-shrink: 0;
}

/* ══════ 分段表格 ══════ */
.split-table {
  margin-top: 4rpx;
}

.split-head {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.split-head .split-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-3);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.split-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.03);
}

.split-row:last-child {
  border-bottom: none;
}

.split-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-1);
}

.split-cell.km {
  flex: 0.6;
  font-weight: 600;
  color: var(--color-text-2);
}
