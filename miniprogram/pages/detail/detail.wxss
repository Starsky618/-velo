/* 骑行详情页样式 — Apple Fitness 风格 */

/* ── 加载中 ── */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-divider);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-3);
}

/* ══════ 深色头部卡片 ══════ */
.hero-card {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(145deg, #1c1c1e, #2C2C2E);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  position: relative;
}

/* 装饰光效（克制的，不是液态玻璃那种） */
.hero-card::after {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 45, 85, 0.15), transparent 70%);
  pointer-events: none;
}

.hero-top {
  margin-bottom: 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-title-wrap {
  flex: 1;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
  letter-spacing: -0.5rpx;
}

.hero-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
  display: block;
}

/* task-4.6：隐私设置入口按钮（齿轮图标） */
.privacy-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  flex-shrink: 0;
}

.privacy-icon {
  color: #FFFFFF;
  font-size: 32rpx;
}

/* task-4.6：隐私设置抽屉 */
.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.privacy-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 32rpx 60rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s ease-out;
}

.privacy-drawer.open {
  transform: translateY(0);
}

.privacy-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid #F2F2F7;
}

.privacy-drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.privacy-drawer-close {
  font-size: 28rpx;
  color: #FF9500;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F2F2F7;
}

.privacy-row:last-child {
  border-bottom: none;
}

.privacy-row-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
}

.privacy-row-label {
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.privacy-row-desc {
  font-size: 24rpx;
  color: #8a8a8e;
  margin-top: 6rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
}

.hero-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-value {
  font-size: 52rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1rpx;
}

.hero-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

.hero-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 8rpx;
  font-weight: 500;
}

.hero-sep {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ══════ 途经赛段 ══════ */

/*
 * Strava 风格赛段列表：每行一个赛段，左侧名称+数据，右侧排名徽章。
 * PR（个人纪录）行用金色左边框高亮，让用户一眼看到自己刷新了纪录。
 */
.segment-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.segment-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
  letter-spacing: -0.5rpx;
}

.segment-count {
  font-size: 24rpx;
  color: var(--color-text-3);
}

.segment-list {
  /* 列表容器，子项之间用 border-bottom 分隔 */
}

.segment-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.segment-item:last-child {
  border-bottom: none;
}

/* PR 行：左侧加金色边框，背景微微发金 */
.segment-item.segment-pr {
  border-left: 6rpx solid #FFD700;
  padding-left: 16rpx;
  margin-left: -4rpx;
  background: rgba(255, 215, 0, 0.04);
  border-radius: 4rpx;
}

.segment-left {
  flex: 1;
  min-width: 0; /* 防止长名称撑破布局 */
}

.segment-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.segment-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 6rpx;
}

.segment-time {
  font-size: 24rpx;
  color: var(--color-text-2);
  font-weight: 500;
}

.segment-speed {
  font-size: 24rpx;
  color: #5AC8FA;
}

.segment-power {
  font-size: 24rpx;
  color: #FF9500;
}

.segment-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 排名徽章：圆角灰底 */
.segment-rank-badge {
  background: rgba(0, 0, 0, 0.06);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

/* 前三名用深色背景突出 */
.segment-rank-badge.top3 {
  background: var(--color-text-1);
}

.segment-rank-badge.top3 .segment-rank-num {
  color: #ffffff;
}

.segment-rank-num {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-2);
}

/* PR 金色标签 */
.segment-pr-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFD700;
  background: rgba(255, 215, 0, 0.12);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

/* ══════ 海拔剖面图 ══════ */

/*
 * 海拔区块的标题用 Strava 风格：大号加粗，没有彩色圆点。
 * 和下面速度/功率/心率卡片的小圆点标题形成层级差异——
 * 海拔是"大区块"（有图表），速度等是"数据卡片"（纯数字）。
 */
.elevation-header {
  margin-bottom: 16rpx;
}

.elevation-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
  letter-spacing: -0.5rpx;
}

/* Canvas 容器：固定高度，宽度撑满卡片 */
.elevation-canvas-wrap {
  width: 100%;
  height: 360rpx;
}

.elevation-canvas {
  width: 100%;
  height: 100%;
}

/* 海拔汇总数据（图表下方的"爬升海拔"/"最高海拔"） */
.elevation-stats {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-divider);
}

.elevation-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

/* 和 Strava 保持一致：左侧标签偏灰，右侧数值加粗 */
.elevation-stat-label {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.elevation-stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

/* ══════ 通用曲线图容器（速度/功率/心率/踏频共用） ══════ */

.chart-canvas-wrap {
  width: 100%;
  height: 340rpx;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* ══════ 数据卡片通用 ══════ */
.section-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 28rpx 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* 彩色小圆点标识 */
.section-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
}

.section-dot.speed { background: #007AFF; }
.section-dot.power { background: #AF52DE; }
.section-dot.hr { background: #FF3B30; }
.section-dot.cadence { background: #30B0C7; }
.section-dot.split { background: #5856D6; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
}

/* ── 数据指标列表（label 左 / value 右，逐行分隔） ── */
/*
 * 设计语言：和 .elevation-stat-row 同款 — 左侧灰色 label，右侧加粗大字。
 * 横向改纵向后扫读更快、视觉更克制，Strava / Apple Fitness 一致风格。
 */
.metric-list {
  margin-top: 4rpx;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.metric-row:last-child {
  border-bottom: none;
}

.metric-label {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.metric-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
  letter-spacing: -0.5rpx;
  line-height: 1.1;
}

/*
 * 数值统一用 text-1 黑色（Strava / 图 1 风格），不再按类型染色。
 * 区块归属靠 section 顶部彩色小圆点（.section-dot.speed/.power/.hr/.cadence）传达。
 */

/* 单位字号略小，颜色随父级 metric-value 走 */
.metric-unit {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 6rpx;
}

/* ══════ 功率区间可视化 ══════ */
.zones {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-divider);
}

.zones-meta {
  font-size: 22rpx;
  color: #8a8a8e;
  margin-bottom: 8rpx;
}

.zones-label {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-bottom: 16rpx;
}

.zone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.zone-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  width: 48rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.zone-track {
  flex: 1;
  height: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 10rpx;
  overflow: hidden;
}

.zone-fill {
  height: 100%;
  border-radius: 10rpx;
  min-width: 4rpx;
}

.zone-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}

.zone-time {
  font-size: 20rpx;
  color: var(--color-text-3);
  width: 128rpx;
  line-height: 1.25;
  flex-shrink: 0;
}

/* ══════ 分段表格 ══════ */
.split-table {
  margin-top: 4rpx;
}

.split-head {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.split-head .split-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-3);
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.split-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.03);
}

.split-row:last-child {
  border-bottom: none;
}

.split-cell {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-1);
}

.split-cell.km {
  flex: 0.6;
  font-weight: 600;
  color: var(--color-text-2);
}
