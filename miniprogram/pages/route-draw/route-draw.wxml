<view class="route-draw-page">
  <view class="route-draw-map-wrap {{showSketchLayer ? 'is-sketching' : ''}}">
    <map
      id="route-draw-map"
      class="route-draw-map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="14"
      polyline="{{drawPolylines}}"
      markers="{{markers}}"
      show-location="{{false}}"
      enable-traffic="{{false}}"
      enable-3D="{{false}}"
      enable-rotate="{{false}}"
      enable-scroll="{{mapScrollEnabled}}"
      enable-zoom="{{mapScrollEnabled}}"
      setting="{{mapInteractionSettings}}"
      bindtap="onMapTap"
      bindregionchange="onMapRegionChange">
    </map>

    <cover-view wx:if="{{!showSketchLayer}}" class="map-tool route-draw-close-tool" catchtap="onTapClose">关闭</cover-view>

    <canvas
      wx:if="{{showSketchLayer}}"
      type="2d"
      id="routeSketchCanvas"
      class="route-draw-touch-layer"
      disable-scroll="{{true}}"
      catchtouchstart="onDrawTouchStart"
      catchtouchmove="onDrawTouchMove"
      catchtouchend="onDrawTouchEnd"
      catchtouchcancel="onDrawTouchEnd">
    </canvas>
  </view>

  <view class="route-draw-panel {{showSketchLayer ? 'sketch-panel' : ''}}">
    <view wx:if="{{notLoggedIn}}" class="login-card">
      <view class="panel-title">登录后规划路线</view>
      <view class="panel-subtitle">登录后才能贴路和保存。</view>
      <button class="primary-button" bindtap="onTapGoLogin">去登录</button>
    </view>

    <block wx:elif="{{showSketchLayer}}">
      <view class="sketch-panel-title">用手指画出你的路线</view>
      <view class="sketch-panel-subtitle">沿确认可骑的道路画线；手绘会保留原线，不再自动绕路。</view>
      <image class="sketch-illustration" src="/assets/route-placeholder.svg" mode="aspectFit"></image>
      <view wx:if="{{!sketchViewportReady}}" class="sketch-preparing">地图准备中…</view>
      <button class="sketch-cancel-button" bindtap="onTapCancelSketch">取消手绘</button>
    </block>

    <block wx:else>
      <view class="route-draw-actions-row">
        <button class="route-draw-action-button" bindtap="onTapSearchLocation">搜地点</button>
        <button class="route-draw-action-button" bindtap="onTapLocate">定位</button>
        <button class="route-draw-action-button" bindtap="onTapStartSketch">手绘</button>
        <button class="route-draw-action-button {{actionCount ? '' : 'is-disabled'}}" bindtap="onTapUndoAction">撤销</button>
      </view>

      <view class="status-row">
        <view class="status-copy">
          <view class="panel-title">{{modeTitle}}</view>
          <view class="panel-subtitle">{{modeHelp}}</view>
          <view class="status-text {{requestStatus === 'previewing' ? 'is-busy' : ''}}">{{statusText}}</view>
        </view>
      </view>

      <view class="stats-row">
        <view class="stat-box">
          <view class="stat-label">距离</view>
          <view class="stat-value">{{routeStats.distanceText}}</view>
        </view>
        <view class="stat-box">
          <view class="stat-label">累计爬升</view>
          <view class="stat-value">{{routeStats.climbText}}</view>
        </view>
        <view class="stat-box">
          <view class="stat-label">爬坡组成</view>
          <view class="stat-value stat-value-time">{{routeStats.climbSequenceText}}</view>
        </view>
      </view>

      <view wx:if="{{elevationStatus === 'ready'}}" class="elevation-card">
        <view class="elevation-title">海拔与爬坡分段</view>
        <canvas type="2d" id="routeElevationCanvas" class="route-elevation-canvas"></canvas>
        <view class="climb-sequence">{{climbPlanView.sequence}}</view>
        <view wx:if="{{climbPlanView.climbs.length}}" class="climb-list">
          <view wx:for="{{climbPlanView.climbs}}" wx:key="order" class="climb-row">
            <view class="climb-category" style="background: {{item.color}}">{{item.category}}</view>
            <view class="climb-copy">
              <view class="climb-main">第{{item.order}}坡 · {{item.shape}} · {{item.distance}} / {{item.grade}}</view>
              <view class="climb-sub">{{item.startKm}}–{{item.endKm}}km {{item.max500}} {{item.candidate ? '· 地形候选' : ''}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{climbPlanView.riderScenarios.length}}" class="rider-scenario-list">
          <view wx:for="{{climbPlanView.riderScenarios}}" wx:key="key" class="rider-scenario-row">
            <view class="rider-scenario-label">{{item.label}}</view>
            <view class="rider-scenario-value">{{item.power}} · {{item.powerPerKg}} · {{item.time}}</view>
            <view wx:if="{{item.timeRange}}" class="rider-scenario-range">情景范围 {{item.timeRange}}</view>
            <view wx:if="{{item.climbTargets}}" class="rider-scenario-range">{{item.climbTargets}}</view>
          </view>
        </view>
        <view wx:if="{{climbPlanView.riderLine}}" class="rider-climb-line">{{climbPlanView.riderLine}}</view>
        <view wx:if="{{climbPlanView.riderContextLine}}" class="climb-boundary-hint">{{climbPlanView.riderContextLine}}</view>
      </view>
      <view wx:elif="{{elevationStatus === 'loading'}}" class="elevation-state">{{elevationMessage}}</view>
      <view wx:elif="{{elevationStatus === 'error'}}" class="elevation-state is-error" bindtap="onTapRetryElevation">
        {{elevationMessage}} 点此重试
      </view>

      <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
      <view wx:if="{{warnings.length}}" class="warning-text">{{warnings[0]}}</view>

      <view wx:if="{{requestStatus === 'confirming'}}" class="detour-actions">
        <button class="detour-button is-secondary" bindtap="onTapSketchDetour">手绘这一小段</button>
        <button class="detour-button is-primary" bindtap="onTapAcceptDetour">接受绕行</button>
      </view>

      <view class="save-card">
        <input
          class="route-name-input"
          value="{{routeName}}"
          maxlength="40"
          disabled="{{pendingSaveLocked}}"
          placeholder="路线名，例如：晋祠晨骑"
          bindinput="onRouteNameInput" />
        <button
          wx:if="{{savedRouteBookId}}"
          class="primary-button"
          bindtap="onTapOpenSavedRoute">打开已保存路线</button>
        <button
          wx:elif="{{requestStatus === 'unknown'}}"
          class="primary-button"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="onTapConfirmPendingSave">确认上次保存</button>
        <button
          wx:else
          class="primary-button {{!canSaveRoute ? 'is-disabled' : ''}}"
          loading="{{saving}}"
          disabled="{{!canSaveRoute}}"
          bindtap="onTapSave">保存路线</button>
      </view>

      <button
        wx:if="{{requestStatus === 'unknown' && pendingSaveLocked}}"
        class="pending-abandon-button"
        bindtap="onTapAbandonPendingSave">放弃确认并继续编辑</button>

      <view wx:if="{{confirmedPointCount < 2}}" class="save-hint">点地图设置起点和终点后即可保存</view>
    </block>
  </view>
</view>
