page {
  background: #f2f2f7;
}

.route-draw-page {
  min-height: 100vh;
  background: #f2f2f7;
}

.route-draw-map-wrap {
  position: relative;
  width: 100%;
  height: 66vh;
}

.route-draw-map {
  width: 100%;
  height: 100%;
  background: #eef3ee;
}

.route-draw-crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 54rpx;
  height: 54rpx;
  margin-left: -27rpx;
  margin-top: -54rpx;
}

.crosshair-ring {
  position: absolute;
  left: 3rpx;
  top: 3rpx;
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #ff9500;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.16);
  box-sizing: border-box;
}

.crosshair-dot {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1c1c1e;
}

.route-draw-topbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
}

.map-tool {
  min-width: 88rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
  pointer-events: auto;
}

.center-add-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  z-index: 3;
  display: flex;
  justify-content: center;
}

.center-add-button {
  min-width: 184rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 28rpx;
  border-radius: 35rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.18);
}

.center-add-button.is-busy {
  background: #6e6e73;
}

.route-draw-toolbox {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 112rpx;
  z-index: 2;
  display: flex;
  gap: 12rpx;
}

.mode-tool {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
}

.mode-tool.is-active {
  background: #1c1c1e;
  color: #ffffff;
}

.route-draw-touch-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: rgba(28, 28, 30, 0.04);
}

.sketch-layer-hint {
  position: absolute;
  left: 50%;
  bottom: 126rpx;
  width: 220rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-left: -110rpx;
  border-radius: 28rpx;
  background: rgba(28, 28, 30, 0.82);
  color: #ffffff;
  font-size: 24rpx;
  text-align: center;
}

.route-draw-panel {
  margin: -28rpx 24rpx 28rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.10);
  position: relative;
  z-index: 3;
}

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-copy {
  min-width: 0;
}

.panel-title {
  color: #1c1c1e;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.panel-subtitle,
.status-text {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-text {
  color: #3a3a3c;
}

.point-pill {
  flex: 0 0 auto;
  min-width: 88rpx;
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #ff9500;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.stat-box {
  min-width: 0;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f7f9;
}

.stat-value {
  color: #1c1c1e;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
  white-space: nowrap;
}

.stat-label {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
}

.route-meta-row {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.route-meta-item {
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f7f7f9;
}

.route-meta-label {
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 1.3;
}

.route-meta-value {
  margin-top: 6rpx;
  color: #1c1c1e;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.route-meta-value.muted {
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 500;
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
  color: #6e6e73;
  font-size: 22rpx;
  line-height: 1.4;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 50%;
}

.legend-dot.confirmed {
  background: #ff9500;
}

.legend-dot.raw {
  background: #8e8e93;
}

.legend-dot.preview {
  background: #30b0c7;
}

.error-text,
.warning-text {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.error-text {
  background: #fff1f2;
  color: #b42318;
}

.warning-text {
  background: #fff7ed;
  color: #b45309;
}

.save-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 188rpx;
  gap: 12rpx;
  margin-top: 20rpx;
}

.route-name-input {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 26rpx;
  box-sizing: border-box;
}

.action-button,
.primary-button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
}

.primary-button {
  background: #ff9500;
  color: #ffffff;
}

.pending-abandon-button {
  margin-top: 12rpx;
  background: transparent;
  color: #8e8e93;
  font-size: 24rpx;
}

.is-disabled {
  opacity: 0.5;
}

.save-hint {
  margin-top: 12rpx;
  color: #8a8a8e;
  font-size: 22rpx;
}

.login-card {
  text-align: left;
}

.login-card .primary-button {
  margin-top: 20rpx;
}
