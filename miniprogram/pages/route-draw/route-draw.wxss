page {
  background: #ffffff;
}

.route-draw-page {
  min-height: 100vh;
  background: #ffffff;
}

.route-draw-map-wrap {
  position: relative;
  width: 100%;
  height: 58vh;
  min-height: 620rpx;
  background: #eef3ee;
}

.route-draw-map-wrap.is-sketching {
  height: 64vh;
}

.route-draw-map {
  width: 100%;
  height: 100%;
  background: #eef3ee;
}

.route-draw-topbar {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 4;
  pointer-events: none;
}

.route-draw-map-side-tools {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 4;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  pointer-events: none;
}

.map-tool,
.mode-tool {
  min-width: 96rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #1c1c1e;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.14);
  pointer-events: auto;
}

.route-draw-toolbox {
  position: absolute;
  right: 24rpx;
  bottom: 32rpx;
  z-index: 4;
  display: flex;
  gap: 16rpx;
}

.mode-tool {
  min-width: 128rpx;
  padding: 0 28rpx;
}

.mode-tool.is-disabled {
  color: #aeaeb2;
}

.route-draw-touch-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: rgba(255, 255, 255, 0.01);
}

.sketch-cancel-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 30rpx;
  z-index: 5;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.sketch-cancel-button {
  min-width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 44rpx;
  background: #fc4c02;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  pointer-events: auto;
}

.route-draw-panel {
  position: relative;
  z-index: 6;
  margin: -28rpx 0 0;
  padding: 34rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.route-draw-panel.sketch-panel {
  min-height: 360rpx;
  padding-top: 44rpx;
  text-align: center;
}

.status-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.status-copy {
  min-width: 0;
}

.panel-title,
.sketch-panel-title {
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
}

.panel-subtitle,
.status-text,
.sketch-panel-subtitle {
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-text {
  color: #3a3a3c;
}

.sketch-panel-subtitle {
  max-width: 560rpx;
  margin: 16rpx auto 0;
}

.sketch-illustration {
  display: block;
  width: 300rpx;
  height: 170rpx;
  margin: 18rpx auto 0;
  border-radius: 24rpx;
}

.sketch-preparing {
  margin-top: 22rpx;
  color: #fc4c02;
  font-size: 24rpx;
}

.stats-row {
  display: grid;
  grid-template-columns: 0.9fr 0.9fr 1.2fr;
  gap: 20rpx;
  margin-top: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

.stat-box {
  min-width: 0;
}

.stat-label {
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 1.3;
}

.stat-value {
  margin-top: 8rpx;
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-value-time {
  font-size: 28rpx;
  line-height: 1.35;
}

.elevation-card {
  margin-top: 24rpx;
}

.elevation-title {
  color: #3a3a3c;
  font-size: 23rpx;
  font-weight: 600;
}

.route-elevation-canvas {
  display: block;
  width: 100%;
  height: 176rpx;
  margin-top: 10rpx;
}

.elevation-state {
  min-height: 44px;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.elevation-state.is-error {
  background: #fff4ef;
  color: #b53a00;
}

.error-text,
.warning-text {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.error-text {
  background: #fff1f2;
  color: #b42318;
}

.warning-text {
  background: #fff7ed;
  color: #b45309;
}

.detour-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detour-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 44rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 44px;
  box-sizing: border-box;
}

.detour-button.is-secondary {
  background: #f2f2f7;
  color: #1c1c1e;
}

.detour-button.is-primary {
  background: #fc4c02;
  color: #ffffff;
}

.save-card {
  margin-top: 26rpx;
}

.route-name-input {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 26rpx;
  box-sizing: border-box;
}

.primary-button {
  display: block;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  margin: 18rpx 0 0;
  padding: 0;
  border-radius: 46rpx;
  background: #fc4c02;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.save-card > .primary-button {
  width: 100% !important;
  max-width: none;
  margin-left: 0;
  margin-right: 0;
}

.pending-abandon-button {
  margin-top: 14rpx;
  background: transparent;
  color: #8e8e93;
  font-size: 24rpx;
}

.is-disabled {
  opacity: 0.45;
}

.save-hint {
  margin-top: 14rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  text-align: center;
}

.login-card {
  text-align: left;
}
