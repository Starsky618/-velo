/* 上传页（选文件 → 开奖 → 成绩卡）——苹果方案（MASTER v0.4）。
   本次重写：深底夜场区（开奖 #0b0e13 / 成绩卡 #121722 / 荧光绿）
   全部退场——这是全 app 最后一块旧设计语言飞地。开奖仪式感保留在
   "数字逐行浮现 + 成绩卡放大浮现"的动画上，不靠深底。
   中文字重 ≤600 铁律（旧 700/800/900 全清）；数据数字 tabular-nums。 */

.center-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 24rpx;
}

.upload-zone {
  margin: 32rpx 24rpx;
  padding: 76rpx 48rpx;
  background: var(--color-card);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  border: 4rpx dashed var(--color-divider);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.upload-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: rgba(255, 149, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  width: 64rpx;
  height: 64rpx;
}

.upload-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.upload-hint {
  font-size: 26rpx;
  color: var(--color-text-2);
  text-align: center;
  line-height: 1.5;
}

.upload-ext {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.brand-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  padding: 0 48rpx;
}

.brand-tag {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-3);
  background: var(--color-divider);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.upload-note {
  margin-top: 32rpx;
  padding: 0 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}

.confirm-card {
  width: 100%;
  max-width: 640rpx;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.file-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(255, 149, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-icon {
  width: 44rpx;
  height: 44rpx;
}

.file-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.file-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 460rpx;
}

.file-meta {
  font-size: 24rpx;
  color: var(--color-text-2);
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.confirm-btns {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-upload,
.btn-detail,
.btn-again,
.btn-retry {
  min-height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-cancel {
  flex: 1;
  background: var(--color-divider);
  color: var(--color-text-1);
}

.btn-upload {
  flex: 2;
  background: var(--color-primary);
  color: #ffffff;
}

.progress-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--color-divider);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
  text-align: center;
}

.progress-hint {
  font-size: 24rpx;
  color: var(--color-text-3);
}

.steps-list {
  width: 100%;
  max-width: 500rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-3);
}

.step-item.active {
  color: var(--color-text-1);
  font-weight: 600;
}

.step-item.done {
  color: var(--color-success);
  font-weight: 600;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--color-divider);
  flex-shrink: 0;
}

.step-item.active .step-dot { background: var(--color-primary); }
.step-item.done .step-dot { background: var(--color-success); }

/* ── 开奖区：白卡上数字逐行浮现（深底退场，仪式感在动画和大数字）── */
.reveal-section {
  margin: 24rpx;
  padding: 28rpx 30rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  font-size: 24rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.file-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #ff9500;
  animation: pulse 1s infinite;
  flex-shrink: 0;
}

@keyframes pulse {
  50% { opacity: 0.3; }
}

.parse-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-height: 44rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.parse-count {
  color: #e07f00;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 30rpx 8rpx;
  border-bottom: 1rpx solid #e5e5ea;
  opacity: 0;
  transform: translateY(28rpx);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.stat-row.show {
  opacity: 1;
  transform: translateY(0);
}

.stat-label {
  color: #8a8a8e;
  font-size: 28rpx;
}

.stat-value-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value {
  color: #1c1c1e;
  font-size: 52rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-unit {
  color: #8a8a8e;
  font-size: 24rpx;
}

.elevation-wrap {
  margin-top: 28rpx;
  height: 150rpx;
}

.elevation-canvas {
  width: 100%;
  height: 150rpx;
}

/* ── 成绩卡：白卡 + 橙 VELO 标（深底卡退场；未来形态 = 照片水印，本卡是过渡）── */
.score-section {
  padding: 24rpx 24rpx 48rpx;
}

.score-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  opacity: 0;
  transform: scale(0.94);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.score-card.show {
  opacity: 1;
  transform: scale(1);
}

.card-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-logo {
  color: #ff9500;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-date {
  color: #8a8a8e;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.card-route {
  display: block;
  color: #1c1c1e;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
  margin-bottom: 8rpx;
}

.card-rider {
  display: block;
  color: #8a8a8e;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 28rpx 18rpx;
  margin-bottom: 28rpx;
}

.card-grid-value {
  color: #1c1c1e;
  font-size: 36rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.card-grid-unit {
  color: #8a8a8e;
  font-size: 20rpx;
  margin-left: 4rpx;
}

.card-grid-label {
  display: block;
  color: #8a8a8e;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.btn-detail {
  background: var(--color-primary);
  color: #ffffff;
}

.btn-again {
  background: #fff;
  color: #1c1c1e;
  border: 1rpx solid #d1d1d6;
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.error-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  text-align: center;
  line-height: 1.5;
}

.btn-retry {
  padding: 0 64rpx;
  background: var(--color-primary);
  color: #ffffff;
}
