/* 上传页样式 */

.center-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 24rpx;
}

.meetup-banner {
  margin: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #11151c;
  border: 2rpx solid #2a3140;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meetup-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.meetup-sub {
  display: block;
  font-size: 24rpx;
  color: #8b94a6;
}

.meetup-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(200, 255, 61, 0.12);
  color: #c8ff3d;
  font-size: 22rpx;
  font-weight: 700;
}

.upload-zone {
  margin: 32rpx 24rpx;
  padding: 76rpx 48rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  border: 4rpx dashed var(--color-divider);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.upload-icon-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 72rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-icon { font-size: 64rpx; }

.upload-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.upload-hint {
  font-size: 26rpx;
  color: var(--color-text-2);
  text-align: center;
  line-height: 1.5;
}

.upload-ext {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.brand-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  padding: 0 48rpx;
}

.brand-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-3);
  background: var(--color-divider);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.upload-note {
  margin-top: 32rpx;
  padding: 0 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
  line-height: 1.6;
}

.confirm-card {
  width: 100%;
  max-width: 640rpx;
}

.file-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.file-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #FF6B35, #FF9500);
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-icon { font-size: 44rpx; }

.file-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.file-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 460rpx;
}

.file-meta {
  font-size: 24rpx;
  color: var(--color-text-2);
}

.confirm-btns {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-upload,
.btn-detail,
.btn-again,
.btn-report,
.btn-retry,
.btn-share {
  min-height: 88rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.btn-cancel {
  flex: 1;
  background: var(--color-divider);
  color: var(--color-text-1);
}

.btn-upload {
  flex: 2;
  background: var(--color-primary);
  color: #ffffff;
}

.progress-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--color-divider);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-1);
  text-align: center;
}

.progress-hint {
  font-size: 24rpx;
  color: var(--color-text-3);
}

.steps-list {
  width: 100%;
  max-width: 500rpx;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-3);
}

.step-item.active {
  color: var(--color-text-1);
  font-weight: 700;
}

.step-item.done {
  color: var(--color-success);
  font-weight: 700;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background: var(--color-divider);
  flex-shrink: 0;
}

.step-item.active .step-dot { background: var(--color-primary); }
.step-item.done .step-dot { background: var(--color-success); }

.reveal-section {
  padding: 28rpx 28rpx 48rpx;
  background: #0b0e13;
  min-height: 640rpx;
}

.file-chip {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #151a23;
  border: 2rpx solid #2a3140;
  color: #aeb6c5;
  font-size: 24rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}

.file-chip text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #c8ff3d;
  animation: pulse 1s infinite;
  flex-shrink: 0;
}

@keyframes pulse {
  50% { opacity: 0.3; }
}

.parse-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-height: 44rpx;
  color: #697386;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.parse-count {
  color: #c8ff3d;
  font-weight: 800;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 30rpx 8rpx;
  border-bottom: 2rpx solid #161b24;
  opacity: 0;
  transform: translateY(28rpx);
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.stat-row.show {
  opacity: 1;
  transform: translateY(0);
}

.stat-label {
  color: #8b94a6;
  font-size: 28rpx;
}

.stat-value-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.stat-unit {
  color: #697386;
  font-size: 24rpx;
}

.elevation-wrap {
  margin-top: 28rpx;
  height: 150rpx;
  opacity: 1;
}

.elevation-canvas {
  width: 100%;
  height: 150rpx;
}

.score-section {
  padding: 28rpx;
  background: #0b0e13;
  min-height: 100vh;
}

.score-card {
  background: #121722;
  border: 2rpx solid #2a3140;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  opacity: 0;
  transform: scale(0.94);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.score-card.show {
  opacity: 1;
  transform: scale(1);
}

.card-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-logo {
  color: #c8ff3d;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.card-date {
  color: #697386;
  font-size: 22rpx;
}

.card-route {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 8rpx;
}

.card-rider {
  display: block;
  color: #8b94a6;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 28rpx 18rpx;
  margin-bottom: 28rpx;
}

.card-grid-value {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.card-grid-unit {
  color: #697386;
  font-size: 20rpx;
  margin-left: 4rpx;
}

.card-grid-label {
  display: block;
  color: #697386;
  font-size: 20rpx;
  margin-top: 6rpx;
}

.first-banner {
  margin-top: 10rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(200, 255, 61, 0.22);
  background: rgba(200, 255, 61, 0.08);
}

.first-title {
  display: block;
  color: #c8ff3d;
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.first-hint {
  display: block;
  color: #8b94a6;
  font-size: 23rpx;
  line-height: 1.6;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 28rpx;
}

.btn-share {
  width: 100%;
  padding: 0;
  border: none;
  background: #c8ff3d;
  color: #0b0e13;
  line-height: 1;
}

.btn-share::after {
  border: none;
}

.btn-report {
  background: transparent;
  color: #c8ff3d;
  border: 2rpx solid rgba(200, 255, 61, 0.35);
}

.btn-detail {
  background: var(--color-primary);
  color: #ffffff;
}

.btn-again {
  background: #202632;
  color: #aeb6c5;
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.error-icon { font-size: 80rpx; }

.error-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-1);
  text-align: center;
  line-height: 1.5;
}

.btn-retry {
  padding: 0 64rpx;
  background: var(--color-primary);
  color: #ffffff;
}
