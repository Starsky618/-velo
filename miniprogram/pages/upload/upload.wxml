<!--
  上传页 — 从"选文件"到"开奖成绩卡"的完整交卷流程。
  这里不判断文件内部内容，只把后端已经解析出的字段按是否存在来展示。
-->

<view class="page-header">
  <text class="subtitle">VELO</text>
  <text class="title">上传骑行</text>
</view>

<view class="meetup-banner" wx:if="{{meetupBannerVisible}}">
  <view>
    <text class="meetup-title">{{meetupTitle}}</text>
    <text class="meetup-sub">{{meetupRiderCount}} 人报名 · {{meetupSubmittedCount}} 人交卷</text>
  </view>
  <view class="meetup-pill">约骑交卷</view>
</view>

<view wx:if="{{step === 'idle'}}">
  <view class="upload-zone" bindtap="chooseFile">
    <view class="upload-icon-wrap">
      <image class="upload-icon" src="/assets/icons/file-up.svg" mode="aspectFit" />
    </view>
    <text class="upload-title">选择你的码表文件</text>
    <text class="upload-hint">从微信聊天记录里选择原文件</text>
    <text class="upload-ext">支持 .fit / .gpx</text>
  </view>

  <view class="brand-list">
    <text class="brand-tag" wx:for="{{['iGPSport', '迈金', '高驰', '佳明', 'Wahoo']}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="upload-note">
    <text>上传后会自动生成距离、速度、爬升和成绩卡</text>
  </view>
</view>

<view wx:if="{{step === 'confirming'}}" class="center-content">
  <view class="confirm-card card">
    <view class="file-info">
      <view class="file-icon-wrap">
        <image class="file-icon" src="/assets/icons/meetup/file-text.svg" mode="aspectFit" />
      </view>
      <view class="file-detail">
        <text class="file-name">{{fileName}}</text>
        <text class="file-meta">码表文件 · {{fileSizeKB}} KB</text>
      </view>
    </view>

    <view class="confirm-btns">
      <view class="btn-cancel" bindtap="cancel">
        <text>取消</text>
      </view>
      <view class="btn-upload" bindtap="startUpload">
        <text>开始上传</text>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{step === 'uploading' || step === 'polling'}}" class="center-content">
  <view class="progress-section">
    <view class="spinner"></view>
    <text class="progress-title">{{statusText}}</text>
    <text class="progress-hint" wx:if="{{step === 'polling' && pollSeconds <= 5}}">通常几秒内生成成绩</text>
    <text class="progress-hint" wx:if="{{step === 'polling' && pollSeconds > 5 && pollSeconds <= 30}}">轨迹较长时会多等一会儿</text>
  </view>

  <view class="steps-list">
    <view class="step-item {{step === 'polling' ? 'done' : 'active'}}">
      <view class="step-dot"></view>
      <text>文件上传</text>
    </view>
    <view class="step-item {{step === 'polling' ? 'active' : ''}}">
      <view class="step-dot"></view>
      <text>读取轨迹</text>
    </view>
    <view class="step-item">
      <view class="step-dot"></view>
      <text>计算成绩</text>
    </view>
    <view class="step-item">
      <view class="step-dot"></view>
      <text>生成卡片</text>
    </view>
  </view>
</view>

<view class="reveal-section" hidden="{{step !== 'reveal'}}">
  <view class="file-chip">
    <view class="chip-dot"></view>
    <text>{{fileName}}</text>
  </view>
  <view class="parse-line">
    <text>{{statusText}}</text>
    <text class="parse-count" wx:if="{{parsePointCount > 0}}">{{parsePointCount}}</text>
  </view>

  <view class="stat-row {{item.visible ? 'show' : ''}}" wx:for="{{revealStats}}" wx:key="key">
    <text class="stat-label">{{item.label}}</text>
    <view class="stat-value-wrap">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
    </view>
  </view>

  <view class="elevation-wrap" hidden="{{!hasElevationProfile || !elevationRevealed}}">
    <canvas type="2d" id="uploadElevationCanvas" class="elevation-canvas" hidden="{{!hasElevationProfile || !elevationRevealed}}"></canvas>
  </view>
</view>

<view wx:if="{{step === 'done' && scoreCard}}" class="score-section">
  <view class="score-card {{revealDone ? 'show' : ''}}">
    <view class="card-brand">
      <text class="card-logo">VELO</text>
      <text class="card-date" wx:if="{{scoreCard.dateText}}">{{scoreCard.dateText}}</text>
    </view>
    <text class="card-route">{{scoreCard.title}}</text>
    <text class="card-rider">{{scoreCard.rider}}</text>

    <view class="card-grid">
      <view class="card-grid-item" wx:for="{{scoreCard.items}}" wx:key="key">
        <view>
          <text class="card-grid-value">{{item.value}}</text>
          <text class="card-grid-unit" wx:if="{{item.unit}}">{{item.unit}}</text>
        </view>
        <text class="card-grid-label">{{item.label}}</text>
      </view>
    </view>

    <view class="first-banner" wx:if="{{scoreCard.firstText}}">
      <text class="first-title">{{scoreCard.firstText}}</text>
      <text class="first-hint" wx:if="{{scoreCard.firstHint}}">{{scoreCard.firstHint}}</text>
    </view>
  </view>

  <view class="result-actions">
    <button wx:if="{{meetupBannerVisible}}" class="btn-share" open-type="share">发到群里，催他们交卷</button>
    <view wx:if="{{meetupBannerVisible}}" class="btn-report" bindtap="viewReport">
      <text>看本场战报</text>
    </view>
    <!-- 约骑场景下"发到群里"才是主操作，详情按钮降级为描边，避免两个橙实底打架 -->
    <view class="btn-detail {{meetupBannerVisible ? 'btn-detail-secondary' : ''}}" bindtap="viewDetail">
      <text>查看骑行详情</text>
    </view>
    <view class="btn-again" bindtap="reset">
      <text>再传一个</text>
    </view>
  </view>
</view>

<view wx:if="{{step === 'error'}}" class="center-content">
  <view class="error-section">
    <text class="error-title">{{errorMsg}}</text>
    <view class="btn-retry" bindtap="reset">
      <text>重新上传</text>
    </view>
  </view>
</view>
