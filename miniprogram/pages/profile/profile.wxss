/* 个人中心页样式 */

/* ── 登录卡片 ── */
.login-card {
  margin: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 48rpx;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 28rpx;
  color: var(--color-text-2);
  margin-bottom: 32rpx;
}

.login-btn {
  background: var(--color-primary);
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
}

.login-btn-text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

/* ── 用户信息卡片 ── */
.user-card {
  margin: 32rpx 24rpx 24rpx;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* city 徽章（D9 fallback / 名片右上角小标签 / Sprint 4 task-4.1） */
.city-badge {
  margin-left: auto;
  background: var(--color-primary);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.city-badge-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.user-id {
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* 体能参数行 */
.params-row {
  display: flex;
  justify-content: space-around;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-divider);
}

.param {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.param-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.param-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: 8rpx;
}

/* ── 累计统计卡片 ── */
.stats-card {
  margin: 0 24rpx 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-2);
  display: block;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-1);
  line-height: 1;
}

.stat-unit {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-left: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: 8rpx;
}

/* ── v4 新增：菜单卡片（我的荣誉 / 设置） ── */
.menu-card {
  margin: 0 24rpx 24rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  gap: 20rpx;
}

.menu-item-hover {
  background: rgba(0, 0, 0, 0.02);
}

.menu-emoji {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text-1);
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--color-text-3);
  line-height: 1;
}

.menu-divider {
  height: 2rpx;
  background: var(--color-divider);
  margin-left: 76rpx;
}

/* ── 退出登录 ── */
.logout-btn {
  margin: 48rpx 24rpx;
  padding: 24rpx;
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--color-card);
}

.logout-text {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════════════ */
/* Sprint 6 task-4：profile 页改造样式（hero / stats / map / medals / rides）  */
/* 旧的 .user-card / .params-* / .logout-* 等 class 已被 wxml 重写废弃         */
/* 暂留作 deprecated（不主动删 / 防其他历史页面引用）/ 未来集中清理            */
/* ═══════════════════════════════════════════════════════════════════════ */

/* ── 块 1：头像区（hero-card / 数字 + 身份名片视觉冲击）── */
.hero-card {
  margin: 32rpx 24rpx 24rpx;
  padding: 40rpx 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  position: relative;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hero-avatar-wrap {
  flex-shrink: 0;
}

.hero-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-bg);
}

/* 头像 button reset 已废弃（Tim 2026-05-16 二次真用拍：button open-type chooseAvatar
   在 hero-top flex 行拦截 hero-info 点击事件 / 退回 image bindtap 模式 / 微信一键导入留 tech-debt） */

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.hero-edit-hint {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.hero-city {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-2);
}

.hero-city-icon {
  font-size: 22rpx;
}

.hero-city-text {
  font-size: 24rpx;
}

.hero-settings {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  padding: 12rpx;
}

.hero-settings-icon {
  font-size: 40rpx;
}

/* bio 签名（task-1） */
.hero-bio {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
}

.hero-bio-text {
  font-size: 26rpx;
  color: var(--color-text-1);
  line-height: 1.5;
}

.hero-bio-placeholder {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--color-text-3);
  background: var(--color-bg);
  border-radius: 16rpx;
}

/* 徽章行（task-2 / chip 样式） */
.badge-row {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.badge-item {
  padding: 8rpx 20rpx;
  background: var(--color-primary);
  border-radius: 32rpx;
}

.badge-label {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
}

/* ── 块 2：训练统计（数字 hero 化 / 2 列 grid）── */
.stats-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
}

.stats-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.stats-period {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx 24rpx;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* 数字 hero 化关键：大字号 + 加粗 */
.stats-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-1);
  line-height: 1.1;
}

.stats-unit {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ── 块 3：热图卡片 ── */
.map-card {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
}

.map-title-row {
  margin-bottom: 24rpx;
}

.map-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.heatmap-area {
  min-height: 200rpx;
}

.heatmap-preview {
  font-size: 24rpx;
  color: var(--color-text-2);
}

.heatmap-empty {
  font-size: 24rpx;
  color: var(--color-text-3);
  text-align: center;
  padding: 40rpx 0;
}

/* ── 块 3.5：城市勋章墙（6 城 grid / unlocked 高亮 / locked 灰）── */
.medals-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
}

.medals-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.medals-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.medals-progress {
  font-size: 24rpx;
  color: var(--color-text-2);
}

.medals-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.medal-cell {
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
  background: var(--color-bg);
}

.medal-city {
  font-size: 26rpx;
  font-weight: 500;
}

.medal-unlocked {
  background: var(--color-primary);
}

.medal-unlocked .medal-city {
  color: #ffffff;
}

.medal-locked .medal-city {
  color: var(--color-text-3);
}

/* ── 块 4：活动列表 ── */
.rides-section {
  margin: 0 24rpx 32rpx;
  padding: 32rpx 32rpx 16rpx;
  background: var(--color-card);
  border-radius: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.section-count {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.rides-loading,
.rides-loadmore {
  font-size: 24rpx;
  color: var(--color-text-3);
  text-align: center;
  padding: 24rpx 0;
}

/* PERSONA_START / Persona Engine task-5 / NPC 老登一句样式 */
.persona-line {
  font-size: 26rpx;
  color: var(--color-text-3);
  margin-top: 16rpx;
  padding: 0 8rpx;
  /* 文案过长单行 truncate / 防溢出（宪法 §2.5 字数 5-25 上限基本不会触发 / 但兜底） */
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  /* 略带斜体让 NPC 一句有"另一个声音"的感觉 / 不与正文混 */
  font-style: italic;
}
/* PERSONA_END */
