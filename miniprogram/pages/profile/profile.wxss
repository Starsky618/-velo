/* 我的（骑手身份名片）——苹果方案（MASTER v0.4）。
   本次重写：① 清掉文件上半 224 行 v4 deprecated 样式（wxml 早已不引用，
   页面级 wxss 不会被其他页面共享，留着只添噪音）② 功能入口从 4 张分散
   小卡合并成 iOS inset-grouped 单卡 ③ emoji 图标换 lucide SVG
   ④ 卡语言统一：圆角 28rpx + 轻阴影 + 字重 ≤600 + 数据数字 tabular。 */

page {
  background: #f2f2f7;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ── 块 1：头像区 ── */
.hero-card {
  margin: 24rpx 24rpx 20rpx;
  padding: 36rpx 30rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.hero-avatar-wrap {
  flex-shrink: 0;
}

.hero-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f2f2f7;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.3;
}

.hero-edit-hint {
  font-size: 30rpx;
  color: #c5c5c7;
  font-weight: 600;
}

.hero-city {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.hero-city-icon {
  width: 26rpx;
  height: 26rpx;
}

.hero-city-text {
  font-size: 26rpx;
  color: #8a8a8e;
  line-height: 1.4;
}

.hero-settings {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 12rpx;
}

.hero-settings-icon {
  width: 40rpx;
  height: 40rpx;
}

/* bio 签名：纯文字展示（灰框退场——编辑入口在设置页，对齐微信惯例）*/
.hero-bio {
  margin-top: 22rpx;
}

.hero-bio-text {
  font-size: 27rpx;
  color: #3a3a3c;
  line-height: 1.6;
}

/* ── 块 2：本周训练 ── */
.stats-card {
  margin: 0 24rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.stats-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

/* 本周 | 生涯 segmented（iOS UISegmentedControl 语言：灰胶囊底 + 选中白片浮起）*/
.stats-seg {
  display: flex;
  padding: 4rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
}

.stats-seg-item {
  min-width: 96rpx;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 32rpx;
}

.stats-seg-item.active {
  background: #fff;
  color: #1c1c1e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.stats-period {
  font-size: 24rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.weekly-goal-progress {
  margin-bottom: 26rpx;
}

.goal-progress-track {
  width: 100%;
  height: 10rpx;
  overflow: hidden;
  background: #f2f2f7;
  border-radius: 999rpx;
}

.goal-progress-fill {
  height: 100%;
  background: #ff9500;
  border-radius: 999rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx 24rpx;
}

.stats-cell {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stats-value {
  font-size: 52rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stats-unit {
  font-size: 23rpx;
  color: #8a8a8e;
}

/* ── 功能入口：iOS inset-grouped 单卡（行间 hairline + chevron）── */
.action-group {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.action-row + .action-row {
  border-top: 1rpx solid #e5e5ea;
}

.action-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.35;
}

.action-subtitle {
  font-size: 23rpx;
  color: #8a8a8e;
  line-height: 1.4;
}

.action-arrow {
  flex: 0 0 auto;
  font-size: 40rpx;
  color: #c5c5c7;
  font-weight: 600;
  line-height: 1;
}

/* ── 块 4：最近活动 ── */
.rides-section {
  margin: 0 24rpx 32rpx;
  padding: 30rpx 30rpx 16rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.section-count {
  font-size: 23rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.rides-loading,
.rides-loadmore {
  font-size: 25rpx;
  color: #8a8a8e;
  text-align: center;
  padding: 24rpx 0;
}

/* ── 未登录态 ── */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.login-brand {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: #ff9500;
}

.login-title {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #8a8a8e;
}

.login-btn {
  margin-top: 48rpx;
  padding: 0 64rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff9500;
  border-radius: 999rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.login-btn:active {
  background: #e07f00;
}
