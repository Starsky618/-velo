<!-- profile 页 —— 骑手身份名片 -->
<!-- 4 模块：① 头像区（含 bio 签名 + 徽章）② 训练统计（本周 / period=week） -->
<!--          ③ 热图 + 城市勋章墙 ④ 活动列表（复用 ride-card 组件） -->
<!-- 字段全部对齐后端真 schema（app/user/schemas.py / app/activity/schemas.py）： -->
<!--   GET /api/user/profile → UserProfile（nickname / avatar_url / city / bio / ftp / -->
<!--                                          weight / bike_type / weekly_goal / badges[]） -->
<!--   GET /api/user/stats?period=week → StatsResponse（distance公里 / rides / -->
<!--                                                     elevation_gain米 / duration秒 / -->
<!--                                                     weekly_goal / goal_percent） -->
<!--     ⚠️ self stats endpoint **不返** avg_power_w —— 那字段只在 GET /{user_id}/profile 看他人时返 -->
<!--   GET /api/user/me/city-medals → CityMedalsResponse（unlocked_count / total / medals[]） -->
<!--     CityMedal: city / label / unlocked（无 icon 字段） -->
<!--   GET /api/user/me/heatmap → HeatmapResponse（city / tracks / activity_count） -->
<!--   GET /api/activities?page=N&page_size=N → ActivityListResponse（items[] / total / page / page_size） -->
<!-- 设计：缺失字段整块 wx:if 隐藏 / 禁用 "-" 占位（永久规则） -->

<wxs src="../../utils/format.wxs" module="f" />

<view class="page" wx:if="{{isLoggedIn}}">

  <!-- ============== 块 1：头像区 ============== -->
  <view class="hero-card">
    <view class="hero-top">
      <!-- 头像点击 → wx.chooseMedia 拍照/相册（Tim 2026-05-16 二次真用拍：
           前一版 <button open-type="chooseAvatar"> 在 hero-top flex 行内拦截 hero-info 区
           点击事件 / 导致 city 不可点击 / 退回 image bindtap 模式 /
           微信一键头像导入留 tech-debt 后续找方案如放 settings 页或独立链接） -->
      <!-- 头像：有 avatar_url 用真头像图；没有则回落字母占位（灰底+昵称首字）。
           不引用 /images/avatar-default.png——该图与 images/ 目录均不存在，旧写法导致没头像时 404 破图。
           两种形态都挂 onEditAvatar，点击换头像交互不变。 -->
      <view class="hero-avatar-wrap">
        <image
          wx:if="{{profile.avatar_url}}"
          class="hero-avatar tappable"
          src="{{profile.avatar_url}}"
          mode="aspectFill"
          bindtap="onEditAvatar"
        />
        <view
          wx:else
          class="hero-avatar hero-avatar--letter tappable"
          bindtap="onEditAvatar"
        >
          <!-- 昵称首字（WXML 支持字符串下标）；无昵称兜底一个骑行小符号，不留空白圈 -->
          <text>{{profile.nickname ? profile.nickname[0] : '骑'}}</text>
        </view>
      </view>

      <view class="hero-info">
        <view class="hero-name-row tappable" bindtap="onEditNickname">
          <text class="hero-name">{{profile.nickname || '未设置昵称'}}</text>
          <text class="hero-edit-hint">›</text>
        </view>
        <!-- city 用小程序原生 picker mode="region" 三级选省/市/区（Tim 2026-05-17 真用拍放宽全国）
             picker 内置全国行政区数据 / 不用自己维护 / 选完 bindchange 传 [省 市 区] 数组 -->
        <picker mode="region" bindchange="onRegionChange" value="{{regionArr}}">
          <view class="hero-city">
            <image class="hero-city-icon" src="/assets/icons/map-pin.svg" mode="aspectFit" />
            <text class="hero-city-text" wx:if="{{profile.city}}">{{profile.city}}</text>
            <text class="hero-city-text" wx:else>选择家乡</text>
          </view>
        </picker>
      </view>

      <view class="hero-settings tappable" bindtap="onTapSettings">
        <image class="hero-settings-icon" src="/assets/icons/settings.svg" mode="aspectFit" />
      </view>
    </view>

    <!-- bio 签名：纯展示（Tim 2026-06-12 拍：去灰框，编辑入口移设置页，对齐微信"我的页只展示、设置页才能改"惯例）。
         无 bio 整块隐藏（不显示占位引导） -->
    <view class="hero-bio" wx:if="{{profile.bio}}">
      <text class="hero-bio-text">{{profile.bio}}</text>
    </view>

    <!-- 徽章行 Tim 2026-05-16 真用拍砍（初期没用 / 后端 + schema 保留 / 仅前端隐藏）
         未来产品需要时取消注释即可恢复 -->
  </view>

  <!-- ============== 块 2：训练统计（本周 / period=week） ============== -->
  <!-- StatsResponse 真字段：distance(公里) / rides / elevation_gain(米int) / duration(秒) / -->
  <!--                       weekly_goal / goal_percent -->
  <!-- ⚠️ 不渲染当月平均功率 W：self stats endpoint 不返 avg_power_w / 见 tech-debt P3 -->
  <!-- 训练统计卡：本周 | 生涯 两档切换（iOS segmented 语言）。
       生涯 = period=all（后端原生支持，不加时间条件）；周目标进度只在"本周"档显示 -->
  <view class="stats-card" wx:if="{{stats}}">
    <view class="stats-title-row">
      <!-- MASTER §4.5.2 选中态滑动：灰底胶囊 + 一个绝对定位的白滑片，
           切档时滑片用 transform 滑过去（不再瞬间换底色）。
           滑片位置只由外层 is-all 状态 class 决定，js 逻辑零改动。 -->
      <view class="stats-seg {{statsPeriod === 'all' ? 'is-all' : ''}}">
        <view class="stats-seg-thumb"></view>
        <view class="stats-seg-item {{statsPeriod === 'week' ? 'active' : ''}}" data-period="week" bindtap="onSwitchStatsPeriod">本周</view>
        <view class="stats-seg-item {{statsPeriod === 'all' ? 'active' : ''}}" data-period="all" bindtap="onSwitchStatsPeriod">生涯</view>
      </view>
      <text class="stats-period" wx:if="{{statsPeriod === 'week' && stats.goal_percent !== null && stats.goal_percent !== undefined}}">目标 {{stats.goal_percent}}%</text>
    </view>

    <view class="weekly-goal-progress" wx:if="{{statsPeriod === 'week' && stats.goal_percent !== null && stats.goal_percent !== undefined}}">
      <view class="goal-progress-track">
        <view class="goal-progress-fill" style="width: {{stats.goal_percent > 100 ? 100 : stats.goal_percent}}%;"></view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stats-cell" wx:if="{{stats.distance !== null && stats.distance !== undefined}}">
        <view class="stats-value">{{f.km(stats.distance)}}</view>
        <view class="stats-unit">公里</view>
      </view>
      <view class="stats-cell" wx:if="{{stats.rides !== null && stats.rides !== undefined}}">
        <view class="stats-value">{{stats.rides}}</view>
        <view class="stats-unit">次骑行</view>
      </view>
      <view class="stats-cell" wx:if="{{stats.elevation_gain !== null && stats.elevation_gain !== undefined}}">
        <view class="stats-value">{{stats.elevation_gain}}</view>
        <view class="stats-unit">{{statsPeriod === 'week' ? '本周爬升 m' : '累计爬升 m'}}</view>
      </view>
      <view class="stats-cell" wx:if="{{stats.duration !== null && stats.duration !== undefined}}">
        <view class="stats-value">{{f.secToHm(stats.duration)}}</view>
        <view class="stats-unit">{{statsPeriod === 'week' ? '本周时长' : '累计时长'}}</view>
      </view>
    </view>
  </view>

  <!-- 功率曲线：已有组件 / 只在我的页挂载，不新增后端接口 -->
  <power-curve-card />

  <!-- ============== 块 3：热图（复用 heatmap-card / 单张真实底图 + 轨迹层） ============== -->
  <!-- Tim 2026-05-16 真用拍：原占位 area 不真渲染热图 → 改用既有组件
       组件 self-contained / 自己调 GET /api/user/me/heatmap + 用原生 map 渲染轨迹 / 不需要 profile 传数据 -->
  <heatmap-card />

  <!-- 功能入口：iOS inset-grouped 语言——整组一张大圆角白卡、行间 hairline -->
  <view class="action-group">
    <view class="action-row tappable" bindtap="onTapHonor">
      <view class="action-main">
        <text class="action-title">我的荣誉</text>
        <text class="action-subtitle">查看 KOM 和赛段前十成绩</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-row tappable" bindtap="onTapTrainingAnalysis">
      <view class="action-main">
        <text class="action-title">训练分析</text>
        <text class="action-subtitle">看 30/90/全年训练负荷曲线</text>
      </view>
      <text class="action-arrow">›</text>
    </view>

    <view class="action-row tappable" bindtap="onTapTrainingDistribution">
      <view class="action-main">
        <text class="action-title">训练结构</text>
        <text class="action-subtitle">看最近 6 周训练时间怎么分布</text>
      </view>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <!-- 城市勋章墙 Tim 2026-05-16 真用拍砍（莫名其妙 / 后端 + endpoint 保留 / 仅前端隐藏）
       未来想恢复时取消注释 medals-section 即可 -->

  <!-- ============== 块 4：活动列表（ride-card 组件 / 复用首页同款） ============== -->
  <!-- 字段直接透传 ActivitySummary：id / title / distance(公里) / duration(秒) / -->
  <!--                              elevation_gain(米) / avg_speed(km/h) / started_at -->
  <view class="rides-section">
    <view class="section-title-row">
      <text class="section-title">最近活动</text>
      <text class="section-count" wx:if="{{totalRides > 0}}">{{totalRides}} 条</text>
    </view>

    <ride-card
      rides="{{rides}}"
      show-empty="{{!ridesLoading}}"
      empty-text="还没有骑行记录"
      empty-subtext="上传 GPX/FIT 文件记录第一次骑行"
      bind:tap-ride="onRideTap"
    />

    <view class="rides-loadmore" wx:if="{{hasMoreRides && !ridesLoading}}" bindtap="onLoadMoreRides">
      <text>加载更多</text>
    </view>
    <view class="rides-loading" wx:if="{{ridesLoading}}">
      <text>加载中...</text>
    </view>
  </view>

</view>

<!-- 未登录态 -->
<view class="login-prompt" wx:else>
  <view class="login-brand">VELO</view>
  <view class="login-title">登录后查看你的骑行档案</view>
  <button class="login-btn" bindtap="onLogin">微信登录</button>
</view>
