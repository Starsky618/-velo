<!--
  个人中心页
  两种状态：未登录（显示登录按钮） / 已登录（显示用户信息）
  wx:if / wx:else 是小程序的条件渲染，类似 JS 的 if-else
-->

<view class="page-header">
  <text class="subtitle">VELO</text>
  <text class="title">我的</text>
</view>

<!-- ====== 未登录状态 ====== -->
<view class="login-card card" wx:if="{{!isLoggedIn}}">
  <text class="login-icon">👤</text>
  <text class="login-title">登录以查看你的骑行数据</text>
  <view class="login-btn" bindtap="handleLogin">
    <text class="login-btn-text">{{loading ? '登录中...' : '微信一键登录'}}</text>
  </view>
</view>

<!-- ====== 已登录状态（5 区块结构 / Sprint 4 task-4.1） ====== -->
<view wx:else>
  <!-- 区块 1：用户信息名片（含 city badge 自动渲染） -->
  <view class="user-card card">
    <view class="user-header">
      <view class="avatar">
        <text class="avatar-text">{{profile.nickname ? profile.nickname[0] : '骑'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{profile.nickname || '骑行者'}}</text>
        <text class="user-id">ID: {{profile.id}}</text>
      </view>
      <!-- city badge 自动 fallback：city 为 null / "unknown" / "" 三种 case 全部不显示，不弹引导（D9 严守） -->
      <view class="city-badge" wx:if="{{profile.city && profile.city !== 'unknown'}}">
        <text class="city-badge-text">{{cityLabel}}</text>
      </view>
    </view>

    <!-- 体能参数 -->
    <view class="params-row" wx:if="{{profile.ftp || profile.weight}}">
      <view class="param" wx:if="{{profile.ftp}}">
        <text class="param-value">{{profile.ftp}}</text>
        <text class="param-label">FTP (W)</text>
      </view>
      <view class="param" wx:if="{{profile.weight}}">
        <text class="param-value">{{profile.weight}}</text>
        <text class="param-label">体重 (kg)</text>
      </view>
      <view class="param" wx:if="{{wpkg}}">
        <text class="param-value">{{wpkg}}</text>
        <text class="param-label">W/kg</text>
      </view>
    </view>
  </view>

  <!-- 区块 2：累计骑行卡片（不变） -->
  <view class="stats-card card">
    <text class="stats-title">累计骑行</text>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{stats ? stats.distance : 0}}</text>
        <text class="stat-unit">km</text>
        <text class="stat-label">总里程</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats ? stats.rides : 0}}</text>
        <text class="stat-unit">次</text>
        <text class="stat-label">总骑行</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats ? stats.elevation_gain : 0}}</text>
        <text class="stat-unit">m</text>
        <text class="stat-label">总爬升</text>
      </view>
    </view>
  </view>

  <!-- 区块 3：功率曲线（task-4.2.A 接入 / power-curve-card 自治 component / D21 模块化） -->
  <power-curve-card />

  <!-- 区块 4：骑行热力图（task-4.2.B 接入 / heatmap-card 自治 component / D21 模块化）
       wx:if="{{profile}}" 等 profile fetch 完才挂载，防 profile=null 时 city='' attach 触发的 race condition：
       - 旧设计：attached 时 profile=null / city='' / fallback unknown / 发 /heatmap?city=unknown
       - profile 返回后 observer 再发真实 city 请求 / 旧 unknown 响应可能后到覆盖真值（Codex 异源审 I1）
       - 修复：page 层等 profile 真值才挂载 component / 一发请求即真值 / 0 race -->
  <heatmap-card wx:if="{{profile}}" city="{{profile.city}}" />

  <!-- 区块 5：导航卡片（我的荣誉 + 设置 / 不变） -->
  <view class="menu-card card">
    <navigator url="/pages/honor/honor" class="menu-item" hover-class="menu-item-hover">
      <text class="menu-emoji">🏆</text>
      <text class="menu-label">我的荣誉</text>
      <text class="menu-arrow">›</text>
    </navigator>
    <view class="menu-divider"></view>
    <navigator url="/pages/settings/settings" class="menu-item" hover-class="menu-item-hover">
      <text class="menu-emoji">⚙️</text>
      <text class="menu-label">设置</text>
      <text class="menu-arrow">›</text>
    </navigator>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="handleLogout">
    <text class="logout-text">退出登录</text>
  </view>
</view>
