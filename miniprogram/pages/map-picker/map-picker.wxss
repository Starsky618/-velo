page {
  background: #f2f2f7;
}

.map-picker-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.map-picker-map-shell {
  position: relative;
  overflow: hidden;
  height: 62vh;
  min-height: 720rpx;
  border-radius: 28rpx;
  background: #eef3ee;
}

.map-picker-map {
  width: 100%;
  height: 100%;
}

.map-picker-pin {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 52rpx;
  height: 52rpx;
  margin-left: -26rpx;
  margin-top: -52rpx;
  border: 8rpx solid #ff9500;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
  pointer-events: none;
}

.map-picker-pin-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  margin-top: -7rpx;
  border-radius: 50%;
  background: #ff9500;
  pointer-events: none;
}

.map-picker-panel {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.picker-title {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.picker-search {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 12rpx;
  margin-top: 20rpx;
}

.picker-search-input {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #1c1c1e;
}

.picker-search-btn {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: #1c1c1e;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-search-results {
  margin-top: 12rpx;
}

.picker-search-result {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7ed;
}

.picker-result-title {
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.picker-result-address {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.picker-field {
  margin-top: 20rpx;
}

.picker-field text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.picker-field input {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #1c1c1e;
}

.picker-coords {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #9ca3af;
}

.picker-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.picker-cancel,
.picker-confirm {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.picker-cancel {
  background: #f3f4f6;
  color: #1c1c1e;
}

.picker-confirm {
  background: #ff9500;
  color: #fff;
}

.picker-confirm:active {
  background: #e07f00;
}
