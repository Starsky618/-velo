<view class="map-picker-page">
  <view class="map-picker-map-shell">
    <map wx:if="{{paperMapHasCustomStyle}}"
         id="picker-map"
         class="map-picker-map"
         latitude="{{latitude}}"
         longitude="{{longitude}}"
         scale="14"
         subkey="{{paperMapSubkey}}"
         layer-style="{{paperMapLayerStyle}}"
         enable-poi="{{false}}"
         enable-building="{{false}}"
         enable-traffic="{{false}}"
         enable-3D="{{false}}"
         enable-rotate="{{false}}"
         show-location="{{false}}"
         bindregionchange="onRegionChange">
      <cover-view class="map-picker-wash"></cover-view>
      <cover-view class="map-picker-pin">
        <cover-view class="map-picker-pin-core"></cover-view>
      </cover-view>
    </map>
    <map wx:else
         id="picker-map"
         class="map-picker-map"
         latitude="{{latitude}}"
         longitude="{{longitude}}"
         scale="14"
         enable-poi="{{false}}"
         enable-building="{{false}}"
         enable-traffic="{{false}}"
         enable-3D="{{false}}"
         enable-rotate="{{false}}"
         show-location="{{false}}"
         bindregionchange="onRegionChange">
      <cover-view class="map-picker-wash"></cover-view>
      <cover-view class="map-picker-pin">
        <cover-view class="map-picker-pin-core"></cover-view>
      </cover-view>
    </map>
  </view>

  <view class="map-picker-panel">
    <view class="picker-title">{{title}}</view>
    <view class="picker-field">
      <text>位置名称</text>
      <input value="{{name}}" bindinput="onNameInput" placeholder="例如：晋祠公园东门" />
    </view>
    <view class="picker-coords">{{latitude}}，{{longitude}}</view>
    <view class="picker-actions">
      <button class="picker-cancel" bindtap="onTapCancel">取消</button>
      <button class="picker-confirm" bindtap="selectMapPoint">{{confirmText}}</button>
    </view>
  </view>
</view>
