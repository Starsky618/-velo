<view class="map-picker-page">
  <view class="map-picker-map-shell">
    <map id="picker-map"
         class="map-picker-map"
         latitude="{{latitude}}"
         longitude="{{longitude}}"
         scale="14"
         enable-traffic="{{false}}"
         enable-3D="{{false}}"
         enable-rotate="{{false}}"
         show-location="{{false}}"
         bindregionchange="onRegionChange">
      <cover-view class="map-picker-pin">
        <cover-view class="map-picker-pin-core"></cover-view>
      </cover-view>
    </map>
  </view>

  <view class="map-picker-panel">
    <view class="picker-title">{{title}}</view>
    <view class="picker-search" wx:if="{{kind === 'meeting'}}">
      <input class="picker-search-input" value="{{searchKeyword}}" maxlength="40" bindinput="onSearchKeywordInput" placeholder="搜索地点，例如：晋祠公园" />
      <button class="picker-search-btn" loading="{{searchingPlace}}" bindtap="onTapSearchPlace">搜索</button>
    </view>
    <view class="picker-search-results" wx:if="{{placeSearchResults.length}}">
      <view class="picker-search-result" wx:for="{{placeSearchResults}}" wx:key="title" data-index="{{index}}" bindtap="onTapSearchResult">
        <view class="picker-result-title">{{item.title}}</view>
        <view class="picker-result-address">{{item.address}}</view>
      </view>
    </view>
    <view class="picker-field">
      <text>位置名称</text>
      <input value="{{name}}" maxlength="40" bindinput="onNameInput" placeholder="例如：晋祠公园东门" />
    </view>
    <view class="picker-coords">{{latitude}}，{{longitude}}</view>
    <view class="picker-actions">
      <button class="picker-cancel" bindtap="onTapCancel">取消</button>
      <button class="picker-confirm" bindtap="selectMapPoint">{{confirmText}}</button>
    </view>
  </view>
</view>
