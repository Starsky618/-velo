/* 设置页 —— 骑手身份摘要 + iOS inset-grouped 设置组。 */

page {
  background: #f2f2f7;
}

.settings-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 72rpx;
  box-sizing: border-box;
}

/* ── 骑手身份摘要 ── */
.identity-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 204rpx;
  padding: 16rpx 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.identity-avatar-wrap {
  flex: 0 0 auto;
}

.identity-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #f2f2f7;
}

.identity-avatar-initial {
  font-size: 46rpx;
  line-height: 1;
  color: #8a8a8e;
  font-weight: 600;
}

.identity-main {
  flex: 1;
  min-width: 0;
}

.identity-name-row {
  display: flex;
  min-height: 44px;
  width: 100%;
  max-width: 100%;
  align-items: center;
  gap: 10rpx;
}

.identity-name {
  max-width: 360rpx;
  overflow: hidden;
  font-size: 38rpx;
  line-height: 50rpx;
  color: #1c1c1e;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-edit-arrow {
  flex: 0 0 auto;
  font-size: 34rpx;
  line-height: 1;
  color: #c5c5c7;
  font-weight: 600;
}

.identity-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44px;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #8a8a8e;
  white-space: nowrap;
}

.identity-pin {
  flex: 0 0 auto;
  width: 27rpx;
  height: 27rpx;
  opacity: 0.58;
}

.identity-bio {
  display: flex;
  align-items: center;
  min-height: 44px;
  overflow: hidden;
  font-size: 27rpx;
  line-height: 38rpx;
  color: #5f636d;
}

.identity-bio-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-bio .muted {
  color: #aeaeb2;
}

/* 组标题：iOS 设置组眉（小号灰字，卡外左上）。 */
.group-title {
  margin: 36rpx 28rpx 12rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #8a8a8e;
}

/* 组：一张大圆角白卡，行间 hairline */
.group {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 组脚注：iOS footer 说明文字（卡外小灰字）*/
.group-foot {
  margin: 14rpx 28rpx 0;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8a8a8e;
}

/* 行：label 左 / 值 + chevron 右 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 108rpx;
  padding: 18rpx 30rpx;
  box-sizing: border-box;
}

.row-divider {
  border-top: 1rpx solid #e5e5ea;
}

/* open-type=contact 必须使用原生 button；用透明点击层覆盖标准 row，避免原生 button 改写可见布局。 */
.contact-row {
  position: relative;
}

.contact-hit-target {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  opacity: 0;
}

.contact-hit-target::after {
  border: none;
}

.row-label {
  flex: 0 0 auto;
  font-size: 29rpx;
  line-height: 40rpx;
  color: #1c1c1e;
}

.row-leading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.row-icon {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.row-value {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.row-value.muted {
  color: #aeaeb2;
}

.row-arrow {
  flex: 0 0 auto;
  font-size: 36rpx;
  color: #c5c5c7;
  font-weight: 600;
  line-height: 1;
}

/* ── 中性账号入口：危险操作只在二级页出现。 ── */
.account-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 126rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.account-entry-icon {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
}

.account-entry-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
}

.account-entry-title {
  font-size: 29rpx;
  line-height: 40rpx;
  color: #1c1c1e;
  font-weight: 500;
}

.account-entry-subtitle {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

/* ═══════ FTP 估算 / Breakthrough 弹窗（手写 modal，逻辑沿袭 Sprint 9）═══════ */

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 28rpx;
  width: 600rpx;
  padding: 48rpx 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-body {
  padding: 16rpx 0 32rpx;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── insufficient 失败态 ── */
.estimate-fail {
  text-align: center;
  width: 100%;
}

.estimate-fail-text {
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.estimate-fail-hint {
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.5;
  padding: 0 16rpx;
}

/* ── 有估算值成功态 ── */
.estimate-success {
  text-align: center;
  width: 100%;
}

.estimate-hint {
  font-size: 26rpx;
  color: #3a3a3c;
  margin-bottom: 16rpx;
}

.estimate-value {
  font-size: 88rpx;
  font-weight: 600;
  color: #ff9500;
  line-height: 1;
  margin-bottom: 16rpx;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.estimate-unit {
  font-size: 36rpx;
  font-weight: 500;
  color: #ff9500;
  margin-left: 8rpx;
}

.confidence-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 8rpx;
}

/* confidence 4 档颜色：high 绿 / medium+low 橙 / insufficient 灰 */
.confidence {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.confidence.high {
  color: #fff;
  background: #34c759;
}

.confidence.medium,
.confidence.low {
  color: #fff;
  background: #ff9500;
}

.confidence.insufficient {
  color: #fff;
  background: #aeaeb2;
}

.r2-text {
  font-size: 22rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* ── modal 操作区 ── */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx !important;
  line-height: 80rpx !important;
  height: 80rpx !important;
  border-radius: 20rpx !important;
  margin: 0 !important;
}

.primary-btn {
  background: #ff9500 !important;
  color: #fff !important;
}

.cancel-btn {
  background: #f2f2f7 !important;
  color: #1c1c1e !important;
  border: none !important;
}

.cancel-btn::after {
  border: none;
}

/* ── FTP Breakthrough 弹窗：老 → 新值视觉对比 ── */
.breakthrough-success {
  text-align: center;
  width: 100%;
}

.breakthrough-ftp-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 24rpx 0;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.breakthrough-old {
  font-size: 48rpx;
  font-weight: 600;
  color: #aeaeb2;          /* 灰：旧值 */
}

.breakthrough-arrow {
  font-size: 40rpx;
  color: #aeaeb2;
}

.breakthrough-new {
  font-size: 64rpx;
  font-weight: 600;
  color: #34c759;          /* 绿：新值/进步 */
}
