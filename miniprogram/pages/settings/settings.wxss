/* 设置页 —— 苹果方案（MASTER v0.4）iOS 设置语言：
   inset-grouped 多组白卡 + 组标题/组脚注 + 行式编辑（label 左 / 值+chevron 右）。
   危险操作（退出/注销）= 居中红字行（iOS 惯例，替代旧全宽大红按钮防误触）。
   中文字重 ≤600；数据数字 tabular-nums；hairline #e5e5ea。 */

page {
  background: #f2f2f7;
}

.settings-page {
  min-height: 100vh;
  padding: 12rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 组标题：iOS 设置组眉（小号灰字，卡外左上）*/
.group-title {
  margin: 28rpx 30rpx 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #8a8a8e;
}

/* 组：一张大圆角白卡，行间 hairline */
.group {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.group-spaced {
  margin-top: 28rpx;
}

/* 组脚注：iOS footer 说明文字（卡外小灰字）*/
.group-foot {
  margin: 12rpx 30rpx 0;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #8a8a8e;
}

/* 行：label 左 / 值 + chevron 右 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 100rpx;
  padding: 16rpx 30rpx;
  box-sizing: border-box;
}

.row + .row,
picker + .row,
.row + picker .row,
picker + picker .row,
.row-button + .row {
  border-top: 1rpx solid #e5e5ea;
}

/* 整行型 button（意见反馈 open-type=contact）：重置微信 button 默认样式成普通行 */
.row-button {
  width: 100%;
  margin: 0;
  border-radius: 0;
  background: #fff;
  font-weight: 400;
  text-align: left;
  line-height: inherit;
}

.row-button::after {
  border: none;
}

.row-label {
  flex: 0 0 auto;
  font-size: 29rpx;
  line-height: 40rpx;
  color: #1c1c1e;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.row-value {
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.row-value.muted {
  color: #aeaeb2;
}

.row-arrow {
  flex: 0 0 auto;
  font-size: 36rpx;
  color: #c5c5c7;
  font-weight: 600;
  line-height: 1;
}

/* 危险操作行：居中红字（iOS 设置页"退出登录"惯例）*/
.row-center {
  justify-content: center;
}

.row-danger {
  font-size: 29rpx;
  line-height: 40rpx;
  color: #ff3b30;
  font-weight: 500;
}

/* ═══════ FTP 估算 / Breakthrough 弹窗（手写 modal，逻辑沿袭 Sprint 9）═══════ */

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 28rpx;
  width: 600rpx;
  padding: 48rpx 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1c1e;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-body {
  padding: 16rpx 0 32rpx;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── insufficient 失败态 ── */
.estimate-fail {
  text-align: center;
  width: 100%;
}

.estimate-fail-text {
  font-size: 30rpx;
  color: #1c1c1e;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.estimate-fail-hint {
  font-size: 24rpx;
  color: #8a8a8e;
  line-height: 1.5;
  padding: 0 16rpx;
}

/* ── 有估算值成功态 ── */
.estimate-success {
  text-align: center;
  width: 100%;
}

.estimate-hint {
  font-size: 26rpx;
  color: #3a3a3c;
  margin-bottom: 16rpx;
}

.estimate-value {
  font-size: 88rpx;
  font-weight: 600;
  color: #ff9500;
  line-height: 1;
  margin-bottom: 16rpx;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.estimate-unit {
  font-size: 36rpx;
  font-weight: 500;
  color: #ff9500;
  margin-left: 8rpx;
}

.confidence-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 8rpx;
}

/* confidence 4 档颜色：high 绿 / medium+low 橙 / insufficient 灰 */
.confidence {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.confidence.high {
  color: #fff;
  background: #34c759;
}

.confidence.medium,
.confidence.low {
  color: #fff;
  background: #ff9500;
}

.confidence.insufficient {
  color: #fff;
  background: #aeaeb2;
}

.r2-text {
  font-size: 22rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* ── modal 操作区 ── */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx !important;
  line-height: 80rpx !important;
  height: 80rpx !important;
  border-radius: 20rpx !important;
  margin: 0 !important;
}

.primary-btn {
  background: #ff9500 !important;
  color: #fff !important;
}

.cancel-btn {
  background: #f2f2f7 !important;
  color: #1c1c1e !important;
  border: none !important;
}

.cancel-btn::after {
  border: none;
}

/* ── FTP Breakthrough 弹窗：老 → 新值视觉对比 ── */
.breakthrough-success {
  text-align: center;
  width: 100%;
}

.breakthrough-ftp-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 24rpx 0;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.breakthrough-old {
  font-size: 48rpx;
  font-weight: 600;
  color: #aeaeb2;          /* 灰：旧值 */
}

.breakthrough-arrow {
  font-size: 40rpx;
  color: #aeaeb2;
}

.breakthrough-new {
  font-size: 64rpx;
  font-weight: 600;
  color: #34c759;          /* 绿：新值/进步 */
}
