/*
 * 设置页样式（Sprint 6 task-5 大幅扩写）
 *
 * 视觉规则：
 *   - 浅灰背景（#F2F1F6）+ 白色卡片：iOS 设置页同款 / 用户直觉熟悉
 *   - section 之间有 24rpx 间距：分组清晰 / 防误点跨区
 *   - 危险按钮（解绑 / 退出）红底白字：系统级危险提示
 *   - 行高 100rpx：触控友好 / 老年用户也能稳点
 */

page {
  background: #F2F1F6;
  min-height: 100vh;
}

.settings-page {
  padding: 24rpx 0;
}

/* 卡片式分组 */
.section {
  background: #fff;
  margin: 0 0 24rpx 0;
  padding: 0 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8a8a8e;
  padding: 20rpx 0 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  padding: 16rpx 0 24rpx;
}

/* 单行：左标签 + 右值 + 箭头 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  min-height: 60rpx;
}

.row-label {
  font-size: 30rpx;
  color: #000;
  flex-shrink: 0;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-value {
  font-size: 28rpx;
  color: #333;
}

.row-value.muted {
  color: #999;                /* "未绑定" 用灰色 / 视觉降权 */
}

.row-arrow {
  font-size: 32rpx;
  color: #c7c7cc;             /* iOS 灰箭头同色 */
}

/* ========== 按钮样式 ========== */

/* 行内 mini 按钮（已绑定/解绑 / 未绑定/绑定 / 与 row-value 并排） */
.inline-btn {
  font-size: 24rpx;
  line-height: 1.6;
  padding: 4rpx 24rpx;
  margin: 0;
  border-radius: 28rpx;
}

/* 全宽按钮（退出登录 / 单独占一行） */
.full-width-btn {
  width: 100%;
  font-size: 32rpx;
  line-height: 88rpx;
  height: 88rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
}

/* 危险动作按钮（解绑 / 退出）：系统红 / 高对比 / 提示用户慎点 */
.danger-btn {
  background: #e64340 !important;
  color: #fff !important;
  border: none !important;
}

.danger-btn::after {
  border: none;                /* 去掉 wx-button 默认外描边 */
}

/* 主操作按钮（绑定 Strava）：品牌蓝（沿用 profile 页同色系） */
.primary-btn {
  background: #2d8cf0 !important;
  color: #fff !important;
  border: none !important;
}

.primary-btn::after {
  border: none;
}

/* ═════════════════════════════════════════════════════════════════════════ */
/* Sprint 9 task-6：FTP 估算按钮 + 弹窗样式                                    */
/* ═════════════════════════════════════════════════════════════════════════ */

/* "让系统估算"按钮（FTP 未设时显示 / 跟"未设置"文字并排 / 视觉前置突出） */
.estimate-btn {
  background: #2d8cf0 !important;
  color: #fff !important;
  border: none !important;
  font-size: 22rpx !important;
  padding: 0 20rpx !important;
}

.estimate-btn::after {
  border: none;
}

/* task-6 Critical fix (2026-05-21 quality reviewer 抓 / 微信硬上限 #2 button 拦截兄弟 tap):
   button 移出 .row-right flex 行 / 单独占一行 / 不再拦截 row-value + row-arrow tap */
.estimate-btn-block {
  background: #2d8cf0 !important;
  color: #fff !important;
  border: none !important;
  font-size: 26rpx !important;
  padding: 8rpx 24rpx !important;
  margin: 16rpx 32rpx 8rpx 32rpx !important;
  display: block !important;
}

.estimate-btn-block::after {
  border: none;
}

/* ── modal 遮罩 + 内容容器 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  padding: 48rpx 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-body {
  padding: 16rpx 0 32rpx;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── insufficient 失败态 ── */
.estimate-fail {
  text-align: center;
  width: 100%;
}

.estimate-fail-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.estimate-fail-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.estimate-fail-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  padding: 0 16rpx;
}

/* ── 有估算值成功态 ── */
.estimate-success {
  text-align: center;
  width: 100%;
}

.estimate-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.estimate-value {
  font-size: 88rpx;
  font-weight: 700;
  color: #2d8cf0;
  line-height: 1;
  margin-bottom: 16rpx;
}

.estimate-unit {
  font-size: 36rpx;
  font-weight: 500;
  color: #2d8cf0;
  margin-left: 8rpx;
}

.confidence-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 8rpx;
}

/* confidence 4 档颜色：high 绿 / medium+low 橙 / insufficient 灰 */
.confidence {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
}

.confidence.high {
  color: #fff;
  background: #34c759;
}

.confidence.medium {
  color: #fff;
  background: #ff9500;
}

.confidence.low {
  color: #fff;
  background: #ff9500;
}

.confidence.insufficient {
  color: #fff;
  background: #999;
}

.r2-text {
  font-size: 22rpx;
  color: #999;
}

/* ── modal 操作区 ── */
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx !important;
  line-height: 80rpx !important;
  height: 80rpx !important;
  border-radius: 12rpx !important;
  margin: 0 !important;
}

.cancel-btn {
  background: #f2f1f6 !important;
  color: #333 !important;
  border: none !important;
}

.cancel-btn::after {
  border: none;
}

/* ═════════════════════════════════════════════════════════════════════════ */
/* Sprint 9 task-8：FTP Breakthrough 弹窗专属样式                              */
/* ═════════════════════════════════════════════════════════════════════════ */

/* 复用 .modal-mask / .modal-content / .modal-title / .modal-body / .modal-actions
   只新增 breakthrough 特有的 ftp-row（老 → 新值的视觉对比） */

.breakthrough-success {
  text-align: center;
  width: 100%;
}

.breakthrough-ftp-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 24rpx 0;
}

.breakthrough-old {
  font-size: 48rpx;
  font-weight: 600;
  color: #999;            /* 灰：表示"旧值" */
}

.breakthrough-arrow {
  font-size: 40rpx;
  color: #999;
}

.breakthrough-new {
  font-size: 64rpx;
  font-weight: 700;
  color: #34c759;         /* 绿：表示"新值/进步" / 与 confidence.high 同色系 */
}
