/*
 * 设置页样式（Sprint 6 task-5 大幅扩写）
 *
 * 视觉规则：
 *   - 浅灰背景（#F2F1F6）+ 白色卡片：iOS 设置页同款 / 用户直觉熟悉
 *   - section 之间有 24rpx 间距：分组清晰 / 防误点跨区
 *   - 危险按钮（解绑 / 退出）红底白字：系统级危险提示
 *   - 行高 100rpx：触控友好 / 老年用户也能稳点
 */

page {
  background: #F2F1F6;
  min-height: 100vh;
}

.settings-page {
  padding: 24rpx 0;
}

/* 卡片式分组 */
.section {
  background: #fff;
  margin: 0 0 24rpx 0;
  padding: 0 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8a8a8e;
  padding: 20rpx 0 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  padding: 16rpx 0 24rpx;
}

/* 单行：左标签 + 右值 + 箭头 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  min-height: 60rpx;
}

.row-label {
  font-size: 30rpx;
  color: #000;
  flex-shrink: 0;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-value {
  font-size: 28rpx;
  color: #333;
}

.row-value.muted {
  color: #999;                /* "未绑定" 用灰色 / 视觉降权 */
}

.row-arrow {
  font-size: 32rpx;
  color: #c7c7cc;             /* iOS 灰箭头同色 */
}

/* ========== 按钮样式 ========== */

/* 行内 mini 按钮（已绑定/解绑 / 未绑定/绑定 / 与 row-value 并排） */
.inline-btn {
  font-size: 24rpx;
  line-height: 1.6;
  padding: 4rpx 24rpx;
  margin: 0;
  border-radius: 28rpx;
}

/* 全宽按钮（退出登录 / 单独占一行） */
.full-width-btn {
  width: 100%;
  font-size: 32rpx;
  line-height: 88rpx;
  height: 88rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
}

/* 危险动作按钮（解绑 / 退出）：系统红 / 高对比 / 提示用户慎点 */
.danger-btn {
  background: #e64340 !important;
  color: #fff !important;
  border: none !important;
}

.danger-btn::after {
  border: none;                /* 去掉 wx-button 默认外描边 */
}

/* 主操作按钮（绑定 Strava）：品牌蓝（沿用 profile 页同色系） */
.primary-btn {
  background: #2d8cf0 !important;
  color: #fff !important;
  border: none !important;
}

.primary-btn::after {
  border: none;
}
