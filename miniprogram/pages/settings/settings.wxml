<!--
  设置页（Sprint 6 task-5）— 三区块结构

  这一页是用户的"控制台"，把"每天不点 / 但出问题时一定要能点到"的几件事集中起来：
  - 账号资料：FTP 编辑（其他敏感字段未来扩展）
  - 第三方账号：Strava 绑定 / 解绑状态
  - 登录态：退出登录（危险操作 / 强制二次确认）

  类比：手机的"设置" App——平时不进，但出问题时（换号、退账号、改重要参数）
  必须能找到入口。

  入口来源：从"我的"页右上角设置 icon（task-4）跳进来。

  红线（v0.2/v0.3 task 卡）：
  - 解绑 / 退出**必须二次确认**（wx.showModal confirm）
  - bound 状态走 GET /api/strava/status 的 `bound` 字段（不从 profile 拉）
  - "-" 占位符永久规则：FTP 未设时显示 "未设置"（不是 "-"）
-->
<view class="settings-page">

  <!-- 区块 1：账号资料 -->
  <view class="section">
    <view class="section-title">账号资料</view>

    <!-- FTP 行：未设时多一个"让系统估算"按钮（Sprint 9 task-6 / 入口前置） -->
    <!-- task-6 Critical fix (quality reviewer 2026-05-21 抓 / 微信硬上限 #2)：button 嵌 flex 行拦截兄弟 tap →
         button 移到 row 外单独一行 / 保留 row-value "未设置" + "›" 手动填入口 -->
    <view class="row" bindtap="onEditFtp">
      <text class="row-label">FTP</text>
      <view class="row-right">
        <text class="row-value">{{ftp ? ftp + ' W' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <button
      class="estimate-btn-block"
      wx:if="{{!ftp}}"
      bindtap="onEstimateFtp"
      size="mini">让系统估算</button>
    <text class="section-hint">骑行实力评估的核心参数 / 影响功率区间统计</text>

    <!-- 体重行（Sprint 9 task-6 / 可选 / 算 W/kg 用） -->
    <view class="row" bindtap="onEditWeight">
      <text class="row-label">体重</text>
      <view class="row-right">
        <text class="row-value">{{weight ? weight + ' kg' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <text class="section-hint">可选 / 用于计算 W/kg（功重比 / 衡量爬坡能力）</text>

    <!-- 年龄 + 最大心率（Sprint 10 / 后端存 birth_year，不存会过期的 age） -->
    <view class="row" bindtap="onEditBirthYear">
      <text class="row-label">年龄</text>
      <view class="row-right">
        <text class="row-value">{{displayAge ? displayAge + ' 岁' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <text class="section-hint">编辑时填写出生年份 / 用于缺少最大心率时估算心率门槛</text>

    <view class="row" bindtap="onEditMaxHr">
      <text class="row-label">最大心率</text>
      <view class="row-right">
        <text class="row-value">{{maxHr ? maxHr + ' bpm' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <text class="section-hint">可选 / FTP 自动估算会优先用它判断 20 分钟是否真的够强</text>
  </view>

  <!-- Sprint 9 task-6：FTP 估算结果弹窗（手写 modal / 不用 wx.showModal 因为要展示富内容） -->
  <view class="modal-mask" wx:if="{{ftpEstimateModal}}" bindtap="onCloseEstimateModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">系统估算结果</view>
      <view class="modal-body">
        <!-- insufficient：历史数据不足 / 引导手动填 -->
        <view wx:if="{{estimateResult.confidence === 'insufficient'}}" class="estimate-fail">
          <view class="estimate-fail-icon">📉</view>
          <view class="estimate-fail-text">历史活动数据不足</view>
          <view class="estimate-fail-hint">需要最近 90 天内 20 分钟高强度窗口，且同一窗口同时有功率和心率 / 请补最大心率或手动填 FTP</view>
        </view>
        <!-- 有估算值：显示数字 + confidence 配色 + R² -->
        <view wx:else class="estimate-success">
          <view class="estimate-hint">我估算你的 FTP 大约</view>
          <view class="estimate-value">{{estimateResult.ftp}}<text class="estimate-unit">W</text></view>
          <view class="confidence-row">
            <text class="confidence {{estimateResult.confidence}}">{{estimateResult.confidence}} 置信度</text>
            <text class="r2-text">R² = {{estimateResult.r2}}</text>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn primary-btn" bindtap="onAcceptEstimate" wx:if="{{estimateResult.ftp}}">用这个值</button>
        <button class="modal-btn cancel-btn" bindtap="onCloseEstimateModal">手动填</button>
      </view>
    </view>
  </view>

  <!-- Sprint 9 task-8：FTP Breakthrough 弹窗（worker 自动检测出的突破事件） -->
  <!-- 弹窗内容 = 当前 ftp → 建议新 ftp / 用户点"更新 FTP" 或 "暂不更新" -->
  <!-- task-8 quality reviewer Minor 修：mask tap 改成 onCloseBreakthrough（只关弹窗 / 不调 PATCH rejected / 防误触永久 reject）-->
  <view class="modal-mask" wx:if="{{breakthroughModal}}" bindtap="onCloseBreakthrough">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">🎉 检测到 FTP 突破</view>
      <view class="modal-body">
        <view class="breakthrough-success">
          <view class="estimate-hint">你最近的训练表现超出当前 FTP</view>
          <view class="breakthrough-ftp-row">
            <text class="breakthrough-old">{{breakthroughEvent.old_ftp}}W</text>
            <text class="breakthrough-arrow">→</text>
            <text class="breakthrough-new">{{breakthroughEvent.suggested_ftp}}W</text>
          </view>
          <view class="estimate-hint">是否更新 FTP？后续新活动将用新值计算 IF/TSS</view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn primary-btn" bindtap="onAcceptBreakthrough">更新 FTP</button>
        <button class="modal-btn cancel-btn" bindtap="onRejectBreakthrough">暂不更新</button>
      </view>
    </view>
  </view>

  <!-- 区块 2：第三方账号 -->
  <view class="section">
    <view class="section-title">第三方账号</view>
    <view class="row">
      <text class="row-label">Strava</text>
      <view class="row-right">
        <text class="row-value" wx:if="{{stravaBound}}">已绑定</text>
        <text class="row-value muted" wx:else>未绑定</text>
        <button
          class="inline-btn danger-btn"
          wx:if="{{stravaBound}}"
          bindtap="onUnbindStrava"
          size="mini">解绑</button>
        <button
          class="inline-btn primary-btn"
          wx:else
          bindtap="onBindStrava"
          size="mini">绑定</button>
      </view>
    </view>
    <text class="section-hint" wx:if="{{stravaBound}}">解绑后历史活动保留 / 不再自动同步新活动</text>
  </view>

  <!-- 区块 3：登录态 -->
  <view class="section">
    <view class="section-title">登录态</view>
    <button class="full-width-btn danger-btn" bindtap="onLogout">退出登录</button>
  </view>

</view>
