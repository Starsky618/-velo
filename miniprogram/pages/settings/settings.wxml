<!--
  设置页 —— iOS 设置语言重构（2026-06-12 Tim 拍："像普通软件一样设计设置页"）。

  信息架构（五组 inset-grouped，每组一张白卡、行间 hairline、行点击编辑）：
  1. 个人资料：骑行宣言（从 profile 页移来——我的页只展示，设置页才能改）/ 每周目标 / 车型
  2. 训练参数：FTP（手动/估算）/ 体重 / 年龄 / 最大心率（原有逻辑全保留）
  3. 账号与同步：Strava（行式：右侧状态 + 点行操作，替代旧 inline 大按钮）
  4. 通用：清除缓存（真功能：显示占用 + 保留登录态清理）/ 关于 VELO（版本号）
  5. 账号操作：退出登录 / 注销账号——iOS 惯例"居中红字行"（替代旧全宽大红按钮，防误触；
     二次确认红线全保留：退出 1 道 / 注销 2 道）

  红线（沿袭 v0.2/v0.3 + 永久规则）：
  - 解绑 / 退出 / 注销必须二次确认（wx.showModal confirm）
  - bound 状态走 GET /api/strava/status 的 bound 字段
  - 未设置显示"未设置"，永不显示 "-"
-->
<view class="settings-page">

  <!-- 组 1：个人资料 -->
  <view class="group-title">个人资料</view>
  <view class="group">
    <view class="row tappable" bindtap="onEditBio">
      <text class="row-label">骑行宣言</text>
      <view class="row-right">
        <text class="row-value {{bio ? '' : 'muted'}}">{{bio || '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="row tappable" bindtap="onEditWeeklyGoal">
      <text class="row-label">每周目标</text>
      <view class="row-right">
        <text class="row-value {{weeklyGoal ? '' : 'muted'}}">{{weeklyGoal ? weeklyGoal + ' km' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <picker mode="selector" range="{{bikeTypeOptions}}" range-key="label" value="{{bikeTypeIndex}}" bindchange="onBikeTypeChange">
      <view class="row">
        <text class="row-label">车型</text>
        <view class="row-right">
          <text class="row-value {{bikeTypeLabel ? '' : 'muted'}}">{{bikeTypeLabel || '未设置'}}</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 组 2：训练参数 -->
  <view class="group-title">训练参数</view>
  <view class="group">
    <view class="row tappable" bindtap="onEditFtp">
      <text class="row-label">FTP</text>
      <view class="row-right">
        <text class="row-value {{ftp ? '' : 'muted'}}">{{ftp ? ftp + ' W' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <view class="row tappable" bindtap="onEditWeight">
      <text class="row-label">体重</text>
      <view class="row-right">
        <text class="row-value {{weight ? '' : 'muted'}}">{{weight ? weight + ' kg' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
    <picker
      mode="selector"
      range="{{birthYearOptions}}"
      value="{{birthYearIndex}}"
      bindchange="onBirthYearPickerChange">
      <view class="row">
        <text class="row-label">年龄</text>
        <view class="row-right">
          <text class="row-value {{displayAge ? '' : 'muted'}}">{{displayAge ? displayAge + ' 岁' : '未设置'}}</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </picker>
    <view class="row tappable" bindtap="onEditMaxHr">
      <text class="row-label">最大心率</text>
      <view class="row-right">
        <text class="row-value {{maxHr ? '' : 'muted'}}">{{maxHr ? maxHr + ' bpm' : '未设置'}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>
  <view class="group-foot">FTP 影响功率区间与训练强度计算；点 FTP 可选"让系统估算"，最大心率与年龄用于估算时的心率门槛。</view>

  <!-- 组 3：账号与同步 -->
  <view class="group-title">账号与同步</view>
  <view class="group">
    <view class="row tappable" bindtap="onTapStrava">
      <text class="row-label">Strava</text>
      <view class="row-right">
        <text class="row-value" wx:if="{{stravaBound}}">已绑定</text>
        <text class="row-value muted" wx:else>未绑定</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>
  <view class="group-foot" wx:if="{{stravaBound}}">解绑后历史活动保留，不再自动同步新活动。</view>

  <!-- 组 4：通用（调研定稿：缓存清理不做——小程序 storage 微信统管且本项目只存登录态；
       单位/多语言/深色模式不做——纯国内公制用户 + Komoot 官方把语言甩给系统 + Strava 2024 才上深色）-->
  <view class="group-title">通用</view>
  <view class="group">
    <!-- 整行即 button（open-type=contact 拉起微信客服会话，零后端的真反馈通道）；
         无兄弟元素，不踩"button 嵌 flex 行拦截兄弟 tap"陷阱 -->
    <button class="row row-button tappable" open-type="contact">
      <text class="row-label">意见反馈</text>
      <view class="row-right">
        <text class="row-arrow">›</text>
      </view>
    </button>
    <view class="row tappable" bindtap="onAbout">
      <text class="row-label">关于 VELO</text>
      <view class="row-right">
        <text class="row-value muted" wx:if="{{versionText}}">{{versionText}}</text>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 组 5：账号操作（iOS 惯例：居中红字行 + 各自独立成卡，防误触）-->
  <view class="group group-spaced">
    <view class="row row-center tappable" bindtap="onLogout">
      <text class="row-danger">退出登录</text>
    </view>
  </view>
  <view class="group group-spaced">
    <view class="row row-center tappable" bindtap="onDeleteAccount">
      <text class="row-danger">注销账号</text>
    </view>
  </view>
  <view class="group-foot">注销将彻底删除你的全部数据（骑行记录、赛段成绩、功率与训练数据），不可恢复。</view>

  <!-- Sprint 9 task-6：FTP 估算结果弹窗（手写 modal / 不用 wx.showModal 因为要展示富内容） -->
  <view class="modal-mask" wx:if="{{ftpEstimateModal}}" bindtap="onCloseEstimateModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">系统估算结果</view>
      <view class="modal-body">
        <!-- insufficient：历史数据不足 / 引导手动填 -->
        <view wx:if="{{estimateResult.confidence === 'insufficient'}}" class="estimate-fail">
          <view class="estimate-fail-text">历史活动数据不足</view>
          <view class="estimate-fail-hint">需要最近 90 天内 20 分钟高强度窗口，且同一窗口同时有功率和心率 / 请补最大心率或手动填 FTP</view>
        </view>
        <!-- 有估算值：显示数字 + confidence 配色 + R² -->
        <view wx:else class="estimate-success">
          <view class="estimate-hint">我估算你的 FTP 大约</view>
          <view class="estimate-value">{{estimateResult.ftp}}<text class="estimate-unit">W</text></view>
          <view class="confidence-row">
            <text class="confidence {{estimateResult.confidence}}">{{estimateResult.confidence}} 置信度</text>
            <text class="r2-text">R² = {{estimateResult.r2}}</text>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn primary-btn" bindtap="onAcceptEstimate" wx:if="{{estimateResult.ftp}}">用这个值</button>
        <button class="modal-btn cancel-btn" bindtap="onManualFillFromEstimate">手动填</button>
      </view>
    </view>
  </view>

  <!-- Sprint 9 task-8：FTP Breakthrough 弹窗（worker 自动检测出的突破事件） -->
  <view class="modal-mask" wx:if="{{breakthroughModal}}" bindtap="onCloseBreakthrough">
    <view class="modal-content" catchtap="noop">
      <view class="modal-title">检测到 FTP 突破</view>
      <view class="modal-body">
        <view class="breakthrough-success">
          <view class="estimate-hint">你最近的训练表现超出当前 FTP</view>
          <view class="breakthrough-ftp-row">
            <text class="breakthrough-old">{{breakthroughEvent.old_ftp}}W</text>
            <text class="breakthrough-arrow">→</text>
            <text class="breakthrough-new">{{breakthroughEvent.suggested_ftp}}W</text>
          </view>
          <view class="estimate-hint">是否更新 FTP？后续新活动将用新值计算 IF/TSS</view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn primary-btn" bindtap="onAcceptBreakthrough">更新 FTP</button>
        <button class="modal-btn cancel-btn" bindtap="onRejectBreakthrough">暂不更新</button>
      </view>
    </view>
  </view>

</view>
