/* 首页样式 — Apple Fitness / Strava 风格骑行卡片 */

/* ══════ 页头布局（左标题 + 右铃铛） ══════ */
/* 注意：全局 .page-header 默认可能是竖排；这里局部覆盖成横排，
   保证铃铛靠右——只对首页生效，不影响其他页 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.page-header-left {
  display: flex;
  flex-direction: column;
}

.bell-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  margin-bottom: 4rpx;
}

.bell-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 红点：数字显示在铃铛右上角，99+ 兜底大数 */
.red-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #FF3B30;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1rpx 4rpx rgba(255, 59, 48, 0.3);
  box-sizing: border-box;
}

.red-dot text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

/* ══════ 本周统计条 ══════ */
.week-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx 28rpx;
  padding: 20rpx 0;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.week-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 0 28rpx;
}

.week-value {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.week-label {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.week-sep {
  width: 2rpx;
  height: 28rpx;
  background: var(--color-divider);
}

/* ══════ 登录引导 ══════ */
.login-card {
  margin: 48rpx 24rpx;
  padding: 64rpx 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.login-text {
  font-size: 28rpx;
  color: var(--color-text-2);
}

.login-btn {
  margin-top: 8rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

/* ══════ 骑行卡片 ══════ */
.feed {
  padding: 0 24rpx;
}

.activity-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ── 卡片头部 ── */
.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.card-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-avatar text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.card-user {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
}

.card-date {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ── 活动标题 ── */
.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-1);
  display: block;
  margin-bottom: 20rpx;
}

/* ── 加载更多 footer（v5 onReachBottom 触发）── */
.feed-footer {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* ── importing 状态卡片整体淡化（视觉对比 / 让"完成"和"解析中"一眼区分）── */
.activity-card.is-pending {
  opacity: 0.65;
  background: linear-gradient(135deg, #f2f2f7 0%, #ffffff 100%);
}

/* ── 解析中文字 + 脉冲动画（视觉"在涨" / 不是死的）── */
.card-pending {
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--color-text-3);
  animation: pulse-fade 1.6s ease-in-out infinite;
}

@keyframes pulse-fade {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ── 核心三项数据块：去"卡中卡"灰底，竖分隔排版（与路线详情 stat-row 同语言） ── */
.card-stats {
  display: flex;
  margin-bottom: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
}

.stat-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stat-block + .stat-block {
  border-left: 1rpx solid var(--color-divider);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-1);
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.stat-unit {
  font-size: 20rpx;
  color: var(--color-text-3);
}

.stat-name {
  font-size: 20rpx;
  color: var(--color-text-3);
  margin-top: 2rpx;
}

/* ── 次要数据行 ── */
.card-secondary {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0 12rpx;
}

.sec-item {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-2);
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.sec-item.power {
  color: #FF9500;
}

.sec-item.hr {
  color: #FF3B30;
}

.sec-dot {
  font-size: 24rpx;
  color: var(--color-text-3);
}

/* ══════ 赛段匹配结果 ══════ */
.card-segments {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.seg-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.seg-rank {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--color-text-2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  min-width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.seg-rank.pr {
  background: var(--color-primary);
}

.seg-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-1);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seg-time {
  font-size: 24rpx;
  color: var(--color-text-3);
  flex-shrink: 0;
}

/* ══════ 空状态 ══════ */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.empty-btn {
  margin-top: 28rpx;
  padding: 16rpx 56rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--color-text-3);
  text-align: center;
  line-height: 1.6;
}
