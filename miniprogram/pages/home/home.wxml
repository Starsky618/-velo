<!--
  首页 — 骑行动态流
  每条骑行记录 = 一张卡片 = 产品核心内容单元
-->

<wxs src="../../utils/format.wxs" module="f" />

<view class="page-header">
  <view class="page-header-left">
    <text class="subtitle">VELO</text>
    <text class="title">动态</text>
  </view>
  <!-- 右上角铃铛 + 红点（未登录时隐藏，避免给陌生用户制造噪音） -->
  <view class="bell-btn tappable" bindtap="goNotifications" wx:if="{{isLoggedIn}}">
    <image class="bell-icon" src="/assets/icons/bell.svg" />
    <view class="red-dot" wx:if="{{unreadCount > 0}}">
      <text wx:if="{{unreadCount < 100}}">{{unreadCount}}</text>
      <text wx:else>99+</text>
    </view>
  </view>
</view>

<!-- ====== 本周统计 ====== -->
<view class="week-bar" wx:if="{{isLoggedIn}}">
  <view class="week-item">
    <text class="week-value">{{f.km(weeklyKm)}}</text>
    <text class="week-label">km</text>
  </view>
  <view class="week-sep"></view>
  <view class="week-item">
    <text class="week-value">{{weeklyRides}}</text>
    <text class="week-label">次骑行</text>
  </view>
  <view class="week-sep"></view>
  <view class="week-item">
    <text class="week-value">{{weeklyElev}}</text>
    <text class="week-label">m 爬升</text>
  </view>
</view>

<!-- ====== 未登录 ====== -->
<view class="login-card" wx:if="{{!isLoggedIn}}">
  <text class="login-text">登录后查看你的骑行动态</text>
  <!-- profile 在 tabBar：navigator 默认 navigate 跳 tabBar 页会静默 fail，必须显式 switchTab -->
  <navigator url="/pages/profile/profile" open-type="switchTab" class="login-btn">
    <text>去登录</text>
  </navigator>
</view>

<!-- ====== 骑行卡片流 ====== -->
<view class="feed" wx:if="{{isLoggedIn}}">

  <!-- 首屏加载骨架（MASTER 体验止血）：仅"首次加载 + 还没任何数据"时显示 2 张灰卡，
       数据来了 loading 转 false 自动消失换真卡。守卫 rides.length===0 防止下拉刷新/加载更多时也冒骨架。
       简化版：不精确还原 pending/completed 多状态，就是头像+标题+数据条的通用灰块。 -->
  <view class="sk-activity-card" wx:if="{{loading && rides.length === 0}}" wx:for="{{[1,2]}}" wx:key="*this">
    <view class="sk-head">
      <view class="sk-avatar sk-shimmer"></view>
      <view class="sk-head-lines">
        <view class="sk-line sk-line-name sk-shimmer"></view>
        <view class="sk-line sk-line-date sk-shimmer"></view>
      </view>
    </view>
    <view class="sk-line sk-line-title sk-shimmer"></view>
    <view class="sk-stats">
      <view class="sk-stat sk-shimmer"></view>
      <view class="sk-stat sk-shimmer"></view>
      <view class="sk-stat sk-shimmer"></view>
    </view>
  </view>

  <!-- 骑行卡片：改用 ride-card 组件 cover 大图卡模式（对齐探索页大图卡语言）。
       组件自己 wx:for 整个 rides 数组 + 自画轨迹缩略大图；
       showEmpty=false 关掉组件自带空态（home 用下面带"去上传"按钮的自定义空态）；
       tap-ride 事件回到 onRideTap 跳详情。loading 首屏时骨架占位、组件先不渲染避免重叠。 -->
  <ride-card
    wx:if="{{!loading || rides.length > 0}}"
    layout="cover"
    rides="{{rides}}"
    show-empty="{{false}}"
    bind:tap-ride="onRideTap"
  />

  <!-- 加载更多 footer（v5 / onReachBottom 触发）-->
  <view class="feed-footer" wx:if="{{rides.length > 0}}">
    <text wx:if="{{loadingMore}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">— 没有更多了 —</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && rides.length === 0}}">
    <text class="empty-title">还没有骑行记录</text>
    <text class="empty-sub">上传你的第一条 GPX，从码表 App 分享到微信即可</text>
    <view class="empty-btn" bindtap="goUpload">去上传</view>
  </view>
</view>
