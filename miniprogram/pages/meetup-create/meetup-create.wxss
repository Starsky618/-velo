/* 发起约骑（三步向导：路线 → 编辑 → 确认）——苹果方案（MASTER v0.4）。
   本次重写废弃了旧版"逐像素还原红色原型 ×0.879"的整套字号与配色：
   - 旧 #ff1744 红系全部退场，强调色统一系统橙 #ff9500（按压 #e07f00）
   - 字号全面抬升：正文 ≥26rpx、辅助 ≥22rpx（旧版 13-19rpx 蚂蚁字是
     "真机字特别小"的直接根源——原型 px×0.879 的换算把桌面预览稿的小字
     直接压成不可读，本次按 iOS 字号节奏重建）
   - 编辑步行内控件从 absolute 贴右改回文档流（grid auto 1fr auto），
     消除控件与标题/徽标重叠的结构性隐患
   - 中文字重 ≤600 铁律；数据数字 tabular-nums；卡圆角 28rpx；hairline #e5e5ea */

page {
  background: #f2f2f7;
}

.create-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

/* ===== 顶部标题区 ===== */
.wiz-head {
  margin: 8rpx 0 20rpx;
  text-align: center;
}

.wiz-title {
  color: #1c1c1e;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.wiz-subtitle {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ===== 步骤指示器：圆圈 + 连接线，三态（done / current / todo）===== */
.wiz-steps {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
  padding: 0 6rpx;
}

.wiz-step {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  color: #3a3a3c;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.wiz-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border: 2rpx solid #ff9500;
  border-radius: 50%;
  background: #fff;
  color: #ff9500;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

.wiz-mark-icon {
  width: 26rpx;
  height: 26rpx;
}

.wiz-step.current {
  color: #1c1c1e;
  font-weight: 600;
}

.wiz-step.current .wiz-mark {
  border: 0;
  background: #ff9500;
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(255, 149, 0, 0.25);
}

.wiz-step.todo {
  color: #8a8a8e;
}

.wiz-step.todo .wiz-mark {
  border-color: #d1d1d6;
  color: #aeaeb2;
}

.wiz-step-label {
  flex: 0 0 auto;
}

.wiz-line {
  flex: 1 1 auto;
  height: 1rpx;
  min-width: 16rpx;
  margin-left: 12rpx;
  background: #d1d1d6;
}

/* ===== 第 1 步：选路线 ===== */
.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  margin: 20rpx 4rpx 0;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.route-card {
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.route-card.selected {
  border-color: #ff9500;
  background: rgba(255, 149, 0, 0.06);
}

.route-card view {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.route-card text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.tencent-route-box {
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tencent-points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.point-button,
.generate-button {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.point-button {
  overflow: hidden;
  background: #f2f2f7;
  color: #1c1c1e;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tencent-route-name {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 18rpx;
  background: #fff;
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 82rpx;
}

/* "生成路线"是卡内操作，用 tinted（浅橙底橙字）和底部主按钮区分层级 */
.generate-button {
  width: 100%;
  margin-top: 18rpx;
  background: rgba(255, 149, 0, 0.12);
  color: #e07f00;
}

.route-preview-shell {
  position: relative;
  overflow: hidden;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: #eef3ee;
}

.route-preview-canvas {
  width: 100%;
  height: 100%;
}

.route-preview-label {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 底部按钮栏（route 步单按钮 / edit·confirm 步双按钮）===== */
.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(28, 28, 30, 0.06);
}

.bottom-actions button:only-child {
  grid-column: 1 / 3;
}

.primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #ff9500;
  color: #fff;
}

.primary:active {
  background: #e07f00;
}

.pub-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 260rpx 1fr;
  column-gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(28, 28, 30, 0.06);
}

.pub-draft-btn,
.pub-publish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.pub-draft-btn {
  border: 1rpx solid #d1d1d6;
  color: #1c1c1e;
  background: #fff;
}

.pub-publish-btn {
  color: #fff;
  background: #ff9500;
}

.pub-publish-btn:active {
  background: #e07f00;
}

/* ============================================================
   第 2 步：就地编辑（pub-*）——iOS 设置页语言：
   一张大白卡，行结构 = 图标盒 + 标题列 + 右侧控件（全部文档流，
   grid auto 1fr auto，旧版 absolute 贴右的控件全部撤销）
   ============================================================ */

.pub-card {
  display: block;
  padding: 0;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.pub-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  column-gap: 20rpx;
  min-height: 118rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e5e5ea;
}

/* 整行可点的行（集合地点）：iOS 式右侧 chevron 提示"点我进下一页" */
.pub-row-tappable:active {
  background: #f7f7f9;
}

.pub-row-chevron {
  color: #c5c5c7;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1;
}

/* 图标盒：浅灰圆角方块 */
.pub-iconbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f2f2f7;
}

.pub-icon {
  width: 38rpx;
  height: 38rpx;
}

.pub-icon-route {
  width: 38rpx;
  height: 38rpx;
}

.pub-row-body {
  min-width: 0;
}

.pub-row-title {
  color: #1c1c1e;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 600;
}

.pub-optional {
  margin-left: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  font-weight: 400;
}

.pub-row-sub {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 25rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.pub-row-sub-muted {
  color: #8a8a8e;
}

/* 路线行：左侧轨迹缩略线（canvas）。
   ⚠ 旧 canvas API：120×104rpx 必须与 js 绘制坐标 60×52px 保持 2:1，改一处同步另一处 */
.pub-route-thumb {
  width: 120rpx;
  height: 104rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.pub-route-thumb .route-thumb-canvas {
  width: 120rpx;
  height: 104rpx;
}

.pub-route-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* "路线已生成"徽标：成功语义绿 tinted（文档流第三列，不再 absolute）*/
.pub-route-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #248a46;
  background: rgba(52, 199, 89, 0.12);
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 人数加减器：白底胶囊，两端圆形按钮 + 中间数字 */
.pub-stepper {
  display: grid;
  grid-template-columns: 48rpx 76rpx 48rpx;
  align-items: center;
  height: 64rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 999rpx;
  background: #fff;
  text-align: center;
}

.pub-stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f2f2f7;
}

.pub-stepper-icon {
  width: 26rpx;
  height: 26rpx;
}

.pub-stepper-value {
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* 右侧就地编辑控件：文档流内右对齐 */
.pub-edit-col {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 400rpx;
}

.pub-edit-col-time {
  gap: 10rpx;
}

.pub-input {
  min-width: 0;
  width: 300rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: right;
}

.pub-place-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 16rpx 28rpx 0;
}

.pub-place-btn {
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 25rpx;
  font-weight: 600;
}

.pub-place-btn-save {
  background: #fff7ed;
  color: #e07f00;
}

.pub-favorite-places {
  width: 100%;
  padding: 16rpx 28rpx 4rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.pub-favorite-place {
  display: inline-block;
  min-width: 180rpx;
  max-width: 280rpx;
  margin-right: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
  vertical-align: top;
}

.pub-favorite-name {
  overflow: hidden;
  color: #1c1c1e;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pub-favorite-address {
  overflow: hidden;
  margin-top: 2rpx;
  color: #8a8a8e;
  font-size: 21rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pub-picker {
  display: flex;
  align-items: center;
}

.pub-picker-value {
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* 活动照片行：标题行 + 4 列照片网格（整行块级，自带下分隔线由 .pub-row 提供）*/
.pub-row-photos {
  display: block;
  padding: 0;
}

.pub-photo-head {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  column-gap: 20rpx;
  padding: 20rpx 28rpx 0;
}

.pub-photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 20rpx 28rpx 28rpx;
}

.pub-photo-item {
  position: relative;
  width: 100%;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.pub-photo-img {
  display: block;
  width: 100%;
  height: 100%;
}

.pub-photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 28, 30, 0.6);
}

.pub-photo-remove-icon {
  width: 20rpx;
  height: 20rpx;
}

.pub-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 120rpx;
  border: 1rpx dashed #c7c7cc;
  border-radius: 12rpx;
  color: #8a8a8e;
  background: #fff;
  box-sizing: border-box;
}

.pub-photo-add-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 6rpx;
}

.pub-photo-add-icon {
  width: 36rpx;
  height: 36rpx;
}

.pub-photo-add text {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #8a8a8e;
}

/* 发布前检查：卡内嵌的浅边框提示小卡 */
.pub-check {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  column-gap: 16rpx;
  margin: 20rpx 28rpx 24rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 16rpx;
  background: #fff;
}

.pub-check-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.pub-check-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.pub-check-body,
.pv-gate-body,
.pv-visibility-text {
  min-width: 0;
}

.pub-check-title {
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.pub-check-sub {
  margin-top: 4rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 30rpx;
}

.pub-chev,
.pub-chev-static {
  width: 28rpx;
  height: 28rpx;
}

/* ============================================================
   第 3 步：发布前总览确认（pv-*）——白卡组，字号按 iOS 节奏重建
   （旧版 13-19rpx 原型换算字号全部废弃）
   ============================================================ */

.pv-page {
  display: block;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.pv-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.pv-section {
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
}

.pv-section-title {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
}

/* —— 路线卡：左轨迹缩略线 + 右名称/数据 —— */
.pv-route-card {
  display: grid;
  grid-template-columns: 160rpx 1fr;
  column-gap: 24rpx;
  padding: 24rpx;
}

/* ⚠ 旧 canvas API：160×132rpx 必须与 js 绘制坐标 80×66px 保持 2:1 */
.pv-map-thumb {
  width: 160rpx;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f2f2f7;
}

.pv-map-thumb .route-thumb-canvas {
  width: 160rpx;
  height: 132rpx;
}

.pv-map-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.pv-map-fallback-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.pv-route-main {
  min-width: 0;
  padding-top: 2rpx;
}

.pv-route-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.pv-route-title {
  overflow: hidden;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #1c1c1e;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* "已生成"徽标：成功语义绿 tinted */
.pv-status-chip {
  flex: 0 0 auto;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #248a46;
  background: rgba(52, 199, 89, 0.12);
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 600;
}

.pv-route-line {
  height: 1rpx;
  margin-top: 16rpx;
  background: #e5e5ea;
}

.pv-route-stats {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-top: 18rpx;
}

.pv-stat {
  display: grid;
  grid-template-columns: 28rpx auto;
  grid-template-rows: auto auto;
  column-gap: 8rpx;
  margin-right: 28rpx;
}

.pv-stat-icon {
  grid-row: 1 / 3;
  align-self: center;
  width: 24rpx;
  height: 24rpx;
}

.pv-stat-num {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 29rpx;
  line-height: 34rpx;
  font-weight: 600;
  color: #1c1c1e;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.pv-stat-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #8a8a8e;
}

.pv-stat-label {
  grid-column: 2;
  color: #8a8a8e;
  font-size: 21rpx;
  line-height: 28rpx;
}

.pv-route-detail {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
  padding-top: 6rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  white-space: nowrap;
}

.pv-route-detail-chev {
  width: 24rpx;
  height: 24rpx;
}

/* —— 适合谁：pill 网格 —— */
.pv-pills {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx 14rpx;
  margin-top: 22rpx;
}

.pv-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 16rpx;
  background: #fff;
  color: #3a3a3c;
  font-size: 25rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.pv-pill-icon {
  width: 30rpx;
  height: 30rpx;
}

.pv-pill.active {
  border-color: #ff9500;
  color: #1c1c1e;
  font-weight: 600;
  background: rgba(255, 149, 0, 0.06);
}

/* 女性友好：橙胶囊（矮一档、圆角胶囊）*/
.pv-pill.soft {
  height: 56rpx;
  padding: 0 24rpx;
  border-color: #ff9500;
  border-radius: 999rpx;
  color: #e07f00;
  font-weight: 600;
}

.pv-pill.soft.active {
  background: rgba(255, 149, 0, 0.1);
}

/* 新手慎选：灰胶囊（选中也保持灰）*/
.pv-pill.muted {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border-color: #d1d1d6;
  color: #8a8a8e;
  font-weight: 400;
}

.pv-pill.muted .pv-pill-icon {
  width: 26rpx;
  height: 26rpx;
}

.pv-pill.muted.active {
  border-color: #d1d1d6;
  color: #8a8a8e;
  background: #fff;
}

/* 选中态右下角角标：白底圆 + 橙勾（check.svg 是描边色，深底上看不见）*/
.pv-check-dot {
  position: absolute;
  right: -6rpx;
  bottom: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #ff9500;
  box-shadow: 0 2rpx 6rpx rgba(255, 149, 0, 0.25);
}

.pv-check-dot-icon {
  width: 16rpx;
  height: 16rpx;
}

.pv-audience-note {
  margin-top: 16rpx;
  color: #8a8a8e;
  font-size: 23rpx;
  line-height: 32rpx;
}

/* —— 节奏与门槛：3 列 —— */
.pv-pace-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  margin-top: 24rpx;
}

.pv-pace-col {
  min-height: 70rpx;
  border-right: 1rpx solid #e5e5ea;
}

.pv-pace-col:nth-child(2) {
  padding-left: 22rpx;
}

.pv-pace-col:nth-child(3) {
  padding-left: 22rpx;
  border-right: 0;
}

.pv-pace-label {
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 30rpx;
}

.pv-pace-picker {
  display: block;
}

.pv-pace-value {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
  color: #1c1c1e;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.pv-pace-input {
  width: 150rpx;
  height: 48rpx;
  margin-top: 8rpx;
  padding: 0;
  color: #1c1c1e;
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.pv-pace-chev {
  width: 18rpx;
  height: 18rpx;
}

.pv-divider {
  height: 1rpx;
  margin-top: 26rpx;
  background: #e5e5ea;
}

/* 报名门槛行 */
.pv-gate-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  column-gap: 16rpx;
  min-height: 90rpx;
  padding-top: 8rpx;
}

.pv-round-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f2f2f7;
}

.pv-round-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.pv-gate-title {
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 34rpx;
}

.pv-gate-title-empty {
  color: #8a8a8e;
}

.pv-gate-sub {
  margin-top: 4rpx;
  color: #8a8a8e;
  font-size: 22rpx;
  line-height: 30rpx;
}

.pv-edit-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #e07f00;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.pv-edit-chev {
  width: 24rpx;
  height: 24rpx;
}

/* 展开的可编辑 textarea（门槛 / 安全提示共用）*/
.pv-edit-textarea {
  width: 100%;
  min-height: 130rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f2f2f7;
  font-size: 27rpx;
  line-height: 38rpx;
  color: #1c1c1e;
  box-sizing: border-box;
}

/* —— 报名规则：label + value 行 —— */
.pv-rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 76rpx;
}

.pv-rule-row-top {
  align-items: flex-start;
  padding-top: 16rpx;
}

.pv-rule-block {
  padding: 16rpx 0;
}

.pv-rule-label {
  flex: 0 0 auto;
  color: #8a8a8e;
  font-size: 27rpx;
  line-height: 36rpx;
}

.pv-rule-value {
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.pv-rule-value-r {
  flex: 1;
  text-align: right;
  font-weight: 400;
}

.pv-rule-chev {
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
}

/* 可见范围：两个并排盒子 */
.pv-visibility-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.pv-visibility-box {
  display: grid;
  grid-template-columns: 56rpx 1fr;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 14rpx 12rpx 16rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 16rpx;
  background: #fff;
  color: #3a3a3c;
  box-sizing: border-box;
}

.pv-visibility-box.active {
  border-color: #ff9500;
  color: #e07f00;
  background: rgba(255, 149, 0, 0.06);
}

.pv-visibility-icon {
  justify-self: center;
  width: 32rpx;
  height: 32rpx;
}

.pv-visibility-main {
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.pv-visibility-sub {
  margin-top: 2rpx;
  color: #8a8a8e;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.pv-visibility-box.active .pv-visibility-sub {
  color: #cf9a55;
}

/* 安全提示模板 chips */
.pv-template-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.pv-template-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  color: #3a3a3c;
  font-size: 23rpx;
  line-height: 30rpx;
}

/* —— 已邀请骑友 —— */
.pv-invite-card {
  margin-top: 20rpx;
  padding: 28rpx 30rpx;
}

.pv-invite-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-invite-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin: 0;
  padding: 0;
  line-height: 1.4;
  background: transparent;
  color: #e07f00;
  font-size: 24rpx;
  font-weight: 600;
}

.pv-invite-link::after {
  border: none;
}

.pv-invite-chev {
  width: 22rpx;
  height: 22rpx;
}

.pv-invite-empty {
  margin-top: 20rpx;
  color: #8a8a8e;
  font-size: 25rpx;
  line-height: 34rpx;
}

.pv-riders {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.pv-rider {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  margin-bottom: 18rpx;
}

.pv-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e5e5ea;
}

.pv-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  background: #ffb340;
}

.pv-rider-name {
  margin-top: 10rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #3a3a3c;
  font-size: 22rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.pv-rider-tag {
  margin-top: 4rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e5ea;
  background: #f9f9fb;
  color: #8a8a8e;
  font-size: 20rpx;
  line-height: 28rpx;
  white-space: nowrap;
}

.pv-rider-tag.organizer {
  border-color: rgba(255, 149, 0, 0.4);
  background: rgba(255, 149, 0, 0.1);
  color: #e07f00;
  font-weight: 600;
}

/* —— 反骚扰提示条 —— */
.pv-safety-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  color: #8a8a8e;
}

.pv-safety-icon {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
}

.pv-safety-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 30rpx;
}

.pv-learn-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex: 0 0 auto;
  color: #8a8a8e;
  font-size: 22rpx;
  white-space: nowrap;
}

.pv-learn-chev {
  width: 22rpx;
  height: 22rpx;
}
