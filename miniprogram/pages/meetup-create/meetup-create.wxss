page {
  background: #f2f1f6;
}

.create-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
}

.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.steps view {
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #6b7280;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.steps .active {
  background: #111827;
  color: #fff;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  margin: 18rpx 0 0;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 800;
  color: #111827;
}

.route-card,
.field,
.summary {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.route-card {
  border: 2rpx solid transparent;
}

.route-card.selected {
  border-color: #ff2d55;
  background: #fff5f7;
}

.route-card view {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111827;
}

.route-card text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.field text {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.field input,
.picker-value {
  min-height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #111827;
}

.field textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #111827;
}

.summary-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: #111827;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #374151;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(17, 24, 39, 0.08);
}

.bottom-actions button:only-child {
  grid-column: 1 / 3;
}

.primary,
.ghost {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary {
  background: #ff2d55;
  color: #fff;
}

.ghost {
  background: #fff;
  color: #111827;
  border: 1rpx solid #d1d5db;
}
