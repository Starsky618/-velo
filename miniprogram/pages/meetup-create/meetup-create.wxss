page {
  background: #f2f1f6;
}

.create-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
}

/* ===== 顶部标题区（原型 .top 的标题+副标题，去掉自绘 back，用系统原生返回）===== */
.wiz-head {
  margin: 8rpx 0 18rpx;
  text-align: center;
}

.wiz-title {
  color: #151820;
  font-size: 38rpx;       /* 原型 30px ×0.879 ≈ 26rpx，这里略放大到 38rpx 让标题更醒目（小程序无 phone 画框缩放，标题需独立可读）*/
  line-height: 48rpx;
  font-weight: 500;
}

.wiz-subtitle {
  margin-top: 8rpx;
  color: #868a94;
  font-size: 24rpx;       /* 原型 22px ×0.879 ≈ 19rpx → 取 24rpx 适配小程序正文最小可读 */
  line-height: 32rpx;
  font-weight: 400;
}

/* ===== 步骤指示器：圆圈 + 连接线（原型 .steps / .step / .step-mark）=====
   每个 .wiz-step 占等宽一格，内部横排：圆圈 → 文字 → 连接线（最后一步无线）。 */
.wiz-steps {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  padding: 0 6rpx;
}

.wiz-step {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  color: #171923;
  font-size: 22rpx;       /* 原型 23px ×0.879 ≈ 20rpx */
  line-height: 28rpx;
  font-weight: 400;
  white-space: nowrap;
}

/* 圆圈：默认（done / todo）红边白底；红字/灰字按状态区分 */
.wiz-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 42rpx;           /* 原型 48px ×0.879 ≈ 42rpx */
  height: 42rpx;
  margin-right: 12rpx;    /* 原型 column-gap 14px ×0.879 ≈ 12rpx */
  border: 2rpx solid #ff1744;
  border-radius: 50%;
  background: #fff;
  color: #ff1744;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.wiz-mark-icon {
  width: 26rpx;           /* 原型 svg 30px ×0.879 ≈ 26rpx */
  height: 26rpx;
}

/* 当前步：红底白字数字 + 阴影；文字也转红 */
.wiz-step.current {
  color: #ff1744;
}

.wiz-step.current .wiz-mark {
  border: 0;
  background: #ff1744;
  color: #fff;
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 23, 68, 0.2);
}

/* 待办步：灰边灰字（还没走到的步骤）*/
.wiz-step.todo .wiz-mark {
  border-color: #d5d6db;
  color: #b9bcc4;
}

.wiz-step-label {
  flex: 0 0 auto;
}

/* 连接线：两步之间的灰色细线，吃掉中间剩余空间 */
.wiz-line {
  flex: 1 1 auto;
  height: 1rpx;
  min-width: 16rpx;
  margin-left: 12rpx;
  background: #d5d6db;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  margin: 18rpx 0 0;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.route-card,
.field,
.summary {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.route-card {
  border: 2rpx solid transparent;
}

.route-card.selected {
  border-color: #ff9500;
  background: #fff5f7;
}

.route-card view {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.route-card text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.tencent-route-box {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.tencent-points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.point-button,
.generate-button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.point-button {
  overflow: hidden;
  background: #f3f4f6;
  color: #1c1c1e;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.generate-button {
  width: 100%;
  background: #1c1c1e;
  color: #fff;
}

.route-preview-shell {
  position: relative;
  overflow: hidden;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #eef3ee;
}

.route-preview-map {
  width: 100%;
  height: 100%;
}

.route-preview-label {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 800;
}

.field text {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #8a8a8e;
}

.field input,
.picker-value {
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #1c1c1e;
}

/* 出发/结束：日期占宽一点、时间窄一点，横向并排 */
.datetime {
  display: flex;
  gap: 12rpx;
}

.datetime .dt-date {
  flex: 3;
}

.datetime .dt-time {
  flex: 2;
}

.field textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #1c1c1e;
}

.summary-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: #1c1c1e;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #3a3a3c;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(17, 24, 39, 0.08);
}

.bottom-actions button:only-child {
  grid-column: 1 / 3;
}

.primary,
.ghost {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary {
  background: #ff9500;
  color: #fff;
}

.ghost {
  background: #fff;
  color: #1c1c1e;
  border: 1rpx solid #d1d5db;
}

/* 照片墙：标题行（左标题 + 右"加照片"）+ 多列 grid，风格照搬详情页保持一致 */
.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.add-media {
  font-size: 26rpx;
  color: #ff9500;
  font-weight: 700;
}

.media-empty {
  font-size: 26rpx;
  color: #86868b;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
}

.media-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  display: block;
}

.media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  font-size: 28rpx;
}

/* ============================================================
   发布前总览确认页（preview 步）逐像素还原原型 meetup-create-visual-clone.html
   缩放系数 750/853 ≈ 0.879，原型 px ×0.879 → rpx；颜色/圆角/阴影/字重 1:1
   全部 .pv-* 前缀，和 publish 步的 .pub-* / route 步的样式互不干扰
   ============================================================ */

/* 总览整页：取消向导默认 panel 间距，改由各卡片自带 margin 控制纵向节奏 */
.pv-page {
  display: block;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 白卡片通用容器（原型 .card）：803px 宽 → 占满，圆角 14px→12rpx，浅边 + 轻阴影 */
.pv-card {
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid #edeef2;
  border-radius: 12rpx;
  box-shadow: 0 9rpx 25rpx rgba(25, 28, 35, 0.035);
}

.pv-section {
  margin-top: 16rpx;          /* 18px ×0.879 */
  padding: 24rpx 20rpx;       /* 27px / 23px */
}

.pv-section-title {
  font-size: 26rpx;           /* 30px */
  line-height: 34rpx;
  font-weight: 500;
  color: #171923;
}

/* —— 路线卡（原型 .route-card）：左地图缩略图 + 右名称/数据 —— */
.pv-route-card {
  display: grid;
  grid-template-columns: 151rpx 1fr;   /* 172px 缩略图 */
  column-gap: 25rpx;                    /* 29px */
  padding: 20rpx;                       /* 23px */
}

/* 地图缩略图：复用 route-preview-shell 但覆盖成小尺寸（172×140px → 151×123rpx）*/
.pv-map-thumb {
  width: 151rpx;
  height: 123rpx;
  margin-top: 0;               /* 覆盖 route-preview-shell 的 margin-top:20rpx */
  border-radius: 7rpx;
  background: #eef3ee;
}

.pv-map-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.pv-map-fallback-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

.pv-route-main {
  min-width: 0;
  padding-top: 4rpx;
}

.pv-route-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.pv-route-title {
  overflow: hidden;
  font-size: 28rpx;            /* 32px */
  line-height: 37rpx;
  font-weight: 500;
  color: #171923;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pv-status-chip {
  flex: 0 0 auto;
  height: 25rpx;              /* 28px */
  padding: 0 8rpx;
  border: 1rpx solid #ff1744;
  border-radius: 5rpx;
  color: #ff1744;
  font-size: 16rpx;          /* 18px */
  line-height: 23rpx;
  text-align: center;
}

.pv-route-line {
  height: 1rpx;
  margin-top: 14rpx;
  background: #e7e8ec;
}

.pv-route-stats {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-top: 18rpx;          /* 22px */
}

.pv-stat {
  display: grid;
  grid-template-columns: 24rpx auto;
  grid-template-rows: auto auto;
  column-gap: 7rpx;
  margin-right: 28rpx;
  color: #191c25;
}

.pv-stat-icon {
  grid-row: 1 / 3;
  align-self: center;
  width: 20rpx;
  height: 20rpx;
}

.pv-stat-num {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  font-size: 24rpx;          /* 27px */
  line-height: 27rpx;
  font-weight: 600;
  color: #191c25;
}

.pv-stat-unit {
  font-size: 17rpx;          /* 19px */
  font-weight: 400;
}

.pv-stat-label {
  grid-column: 2;
  color: #81858e;
  font-size: 16rpx;          /* 18px */
  line-height: 23rpx;
}

.pv-route-detail {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
  padding-top: 4rpx;
  color: #797d86;
  font-size: 18rpx;          /* 20px */
  white-space: nowrap;
}

.pv-route-detail-chev {
  width: 24rpx;
  height: 24rpx;
}

/* —— 适合谁：pill 网格 —— */
.pv-pills {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 24rpx 12rpx;          /* 28px / 14px */
  margin-top: 18rpx;
}

.pv-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11rpx;
  height: 60rpx;             /* 68px */
  padding: 0 19rpx;          /* 22px */
  border: 1rpx solid #dfe1e7;
  border-radius: 7rpx;
  background: #fff;
  color: #292d36;
  font-size: 18rpx;          /* 21px */
  line-height: 25rpx;
  white-space: nowrap;
}

.pv-pill-icon {
  width: 28rpx;              /* 32px */
  height: 28rpx;
}

/* 选中态：红边 + 内描边淡红（原型 .pill.active）*/
.pv-pill.active {
  border-color: #ff1744;
  color: #1f232c;
  font-weight: 500;
  box-shadow: inset 0 0 0 1rpx rgba(255, 23, 68, 0.08);
}

/* 女性友好：红胶囊样式（原型 .pill.soft-active）。.soft 比普通 pill 矮、圆角胶囊、红字 */
.pv-pill.soft {
  height: 43rpx;            /* 49px */
  padding: 0 19rpx;
  border-color: #ff1744;
  border-radius: 999rpx;
  color: #ff1744;
  font-weight: 500;
}

.pv-pill.soft.active {
  box-shadow: none;          /* 胶囊态不要内描边 */
}

/* 新手慎选：灰胶囊（原型 .pill.muted）。选中也保持灰，不变红 */
.pv-pill.muted {
  height: 43rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border-color: #dfe1e7;
  color: #838791;
  font-weight: 400;
}

.pv-pill.muted .pv-pill-icon {
  width: 25rpx;
  height: 25rpx;
}

.pv-pill.muted.active {
  border-color: #dfe1e7;
  color: #838791;
  font-weight: 400;
  box-shadow: none;
}

/* 右下角红勾角标（原型 .check-dot）：原型是红圆白勾；
   烘好的 check.svg 是红色描边，红底上看不见 → 这里改成白底圆 + 红勾，保证勾可见（小程序无法运行时改 SVG 颜色）*/
.pv-check-dot {
  position: absolute;
  right: -4rpx;
  bottom: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 23rpx;             /* 26px */
  height: 23rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #ff1744;
  box-shadow: 0 2rpx 6rpx rgba(255, 23, 68, 0.25);
}

.pv-check-dot-icon {
  width: 14rpx;
  height: 14rpx;
}

.pv-audience-note {
  margin-top: 11rpx;
  color: #797d86;
  font-size: 18rpx;          /* 21px */
  line-height: 26rpx;
}

/* —— 节奏与门槛：3 列 —— */
.pv-pace-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  margin-top: 21rpx;          /* 24px */
}

.pv-pace-col {
  min-height: 60rpx;
  padding-left: 0;
  border-right: 1rpx solid #e7e8ec;
}

.pv-pace-col:nth-child(2) {
  padding-left: 24rpx;        /* 39px */
}

.pv-pace-col:nth-child(3) {
  padding-left: 24rpx;
  border-right: 0;
}

.pv-pace-label {
  color: #7d818b;
  font-size: 17rpx;          /* 19px */
  line-height: 24rpx;
}

.pv-pace-value {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  color: #181b23;
  font-size: 20rpx;          /* 24px（区间值偏长，略压一档防换行）*/
  line-height: 26rpx;
  font-weight: 500;
}

.pv-pace-chev {
  width: 16rpx;
  height: 16rpx;
}

.pv-divider {
  height: 1rpx;
  margin-top: 24rpx;          /* 28px */
  background: #e7e8ec;
}

/* 报名门槛行 */
.pv-gate-row {
  display: grid;
  grid-template-columns: 47rpx 1fr auto;   /* 54px 圆图标列 */
  align-items: center;
  column-gap: 13rpx;
  min-height: 73rpx;
}

.pv-round-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;             /* 45px */
  height: 40rpx;
  border-radius: 50%;
  background: #f4f5f7;
}

.pv-round-icon-img {
  width: 23rpx;
  height: 23rpx;
}

.pv-gate-title {
  color: #252933;
  font-size: 18rpx;          /* 21px */
  line-height: 25rpx;
}

.pv-gate-title-empty {
  color: #a1a5ad;
}

.pv-gate-sub {
  margin-top: 4rpx;
  color: #8b8f98;
  font-size: 15rpx;          /* 17px */
  line-height: 22rpx;
}

.pv-edit-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #777b86;
  font-size: 17rpx;          /* 19px */
  white-space: nowrap;
}

.pv-edit-chev {
  width: 22rpx;
  height: 22rpx;
}

/* 展开的可编辑 textarea（门槛 / 安全提示共用）*/
.pv-edit-textarea {
  width: 100%;
  min-height: 110rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f4f5f7;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #20242d;
}

/* —— 报名规则：每行 label + value —— */
.pv-rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 64rpx;
}

.pv-rule-row-top {
  align-items: flex-start;
}

.pv-rule-block {
  padding: 14rpx 0;
}

.pv-rule-label {
  flex: 0 0 auto;
  color: #20242d;
  font-size: 18rpx;          /* 21px */
  line-height: 26rpx;
}

.pv-rule-value {
  color: #272b34;
  font-size: 18rpx;
  line-height: 26rpx;
}

.pv-rule-value-r {
  flex: 1;
  text-align: right;
}

.pv-rule-chev {
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  margin-left: 8rpx;
}

/* 可见范围：两个并排盒子（原型 .visibility-box）*/
.pv-visibility-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.pv-visibility-box {
  display: grid;
  grid-template-columns: 50rpx 1fr;
  align-items: center;
  min-height: 65rpx;          /* 74px */
  padding: 0 12rpx 0 18rpx;
  border: 1rpx solid #dfe1e7;
  border-radius: 6rpx;
  background: #fff;
  color: #414650;
}

.pv-visibility-box.active {
  border-color: #ff1744;
  color: #ff1744;
  background: #fff4f6;
}

.pv-visibility-icon {
  justify-self: center;
  width: 27rpx;              /* 31px */
  height: 27rpx;
}

.pv-visibility-main {
  font-size: 18rpx;          /* 20px */
  line-height: 24rpx;
  font-weight: 500;
}

.pv-visibility-sub {
  margin-top: 2rpx;
  color: #8b8f98;
  font-size: 15rpx;          /* 17px */
  line-height: 20rpx;
  font-weight: 400;
}

.pv-visibility-box.active .pv-visibility-sub {
  color: #c98a96;
}

/* 安全提示模板 chips */
.pv-template-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.pv-template-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: #555a64;
  font-size: 18rpx;
  line-height: 26rpx;
}

/* —— 已邀请骑友 —— */
.pv-invite-card {
  margin-top: 16rpx;
  padding: 24rpx 20rpx;
}

.pv-invite-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pv-invite-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  line-height: 1.4;
  background: transparent;
  color: #ff1744;
  font-size: 16rpx;          /* 18px */
  font-weight: 500;
}

.pv-invite-link::after {
  border: none;              /* 去掉微信 button 默认边框 */
}

.pv-invite-chev {
  width: 20rpx;
  height: 20rpx;
}

.pv-invite-empty {
  margin-top: 20rpx;
  color: #86868b;
  font-size: 22rpx;
}

.pv-riders {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.pv-rider {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;               /* 5 列（原型 repeat(5,1fr)）*/
  margin-bottom: 16rpx;
}

.pv-avatar {
  width: 55rpx;             /* 62px */
  height: 55rpx;
  border-radius: 50%;
  background: #d8dce3;
}

.pv-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 27rpx;
  font-weight: 500;
}

.pv-rider-name {
  margin-top: 8rpx;
  color: #3d424d;
  font-size: 15rpx;          /* 17px */
  line-height: 21rpx;
  white-space: nowrap;
}

.pv-rider-tag {
  margin-top: 3rpx;
  padding: 0 8rpx;
  min-height: 21rpx;
  line-height: 19rpx;
  border: 1rpx solid #e3e5ea;
  border-radius: 5rpx;
  background: #fafafa;
  color: #9397a0;
  font-size: 13rpx;          /* 14px */
  white-space: nowrap;
}

.pv-rider-tag.organizer {
  border-color: #ff1744;
  background: #fff4f6;
  color: #ff1744;
  font-size: 14rpx;          /* 16px */
  font-weight: 500;
}

/* —— 反骚扰条 —— */
.pv-safety-strip {
  display: flex;
  align-items: center;
  gap: 13rpx;
  min-height: 47rpx;          /* 54px */
  padding: 14rpx 20rpx;
  color: #7b7f89;
}

.pv-safety-icon {
  flex: 0 0 auto;
  width: 27rpx;              /* 31px */
  height: 27rpx;
}

.pv-safety-text {
  flex: 1;
  font-size: 19rpx;          /* 22px */
  line-height: 26rpx;
}

.pv-learn-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
  color: #898d96;
  font-size: 16rpx;          /* 18px */
  white-space: nowrap;
}

.pv-learn-chev {
  width: 20rpx;
  height: 20rpx;
}

/* —— 确认并发布约骑红按钮（原型 .publish-button）—— */
.pv-publish-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 70rpx;             /* 80px */
  margin-top: 14rpx;         /* 16px */
  border-radius: 6rpx;
  background: #ff1744;
  color: #fff;
  font-size: 26rpx;          /* 29px */
  line-height: 34rpx;
  font-weight: 500;
}

.pv-publish-button::after {
  border: none;
}

.pv-publish-button:active {
  background: #f10f3c;
  transform: translateY(1rpx);
}

/* ============================================================
   发布步（第4步）逐像素还原原型 meetup-create-wizard-publish-clone.html
   缩放系数 750/853 ≈ 0.879，所有 px × 0.879 → rpx；颜色/圆角/阴影/字重 1:1
   ============================================================ */

/* 白卡片容器（原型 .form-card）。这里下边距给底部按钮栏留出 122rpx 高度 + 安全区 */
.pub-card {
  display: block;
  margin-top: 3rpx;
  padding: 0;
  border: 1rpx solid #f0f1f4;
  border-radius: 12rpx;          /* 14px ×0.879 */
  background: rgba(255, 255, 255, 0.985);
  box-shadow: 0 12rpx 30rpx rgba(31, 34, 42, 0.035);
  overflow: hidden;
}

/* 信息行（原型 .row）：120px 图标列 + 1fr 内容 + 82px 右操作列 */
.pub-row {
  position: relative;
  display: grid;
  grid-template-columns: 105rpx 1fr 72rpx;   /* 120/_/82 ×0.879 */
  min-height: 122rpx;                          /* 139px ×0.879 */
  border-bottom: 1rpx solid #e7e8ed;
}

.pub-row-route {
  min-height: 127rpx;                          /* 144px ×0.879 */
}

/* 图标盒（原型 .icon-box）：浅灰圆角方块，居中放图标 */
.pub-iconbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;                                /* 80px ×0.879 */
  height: 70rpx;
  margin: 28rpx 0 0 24rpx;                     /* 32 0 0 27 ×0.879 */
  border-radius: 14rpx;                        /* 16px ×0.879 */
  background: #f7f7f9;
}

.pub-icon {
  width: 38rpx;                                /* 43px ×0.879 */
  height: 38rpx;
}

/* 路线行图标盒用粉底（原型 .icon-box.pink），但路线行左侧改放真地图缩略图，
   缩略图加载不出时用 pub-route-thumb-fallback 里这个粉底图标兜底 */
.pub-icon-route {
  width: 38rpx;
  height: 38rpx;
}

/* 行内容（原型 .row-content）*/
.pub-row-body {
  padding-top: 30rpx;                          /* 34px ×0.879 ≈ 30rpx */
  min-width: 0;
}

.pub-row-title {
  color: #181b23;
  font-size: 25rpx;                            /* 28px ×0.879 */
  line-height: 32rpx;
  font-weight: 500;
}

.pub-optional {
  margin-left: 5rpx;
  color: #888c96;
  font-size: 19rpx;                            /* 22px ×0.879 */
  font-weight: 400;
}

.pub-row-sub {
  margin-top: 11rpx;                           /* 13px ×0.879 */
  color: #20242d;
  font-size: 22rpx;                            /* 25px ×0.879 */
  line-height: 30rpx;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pub-row-sub-muted {
  color: #7f838d;
}

/* 路线缩略图：把真 <map> 缩成左侧小图（替代原型那块假渐变缩略图）。
   宽度对齐图标列 + 一点内容区，高度撑满行 */
.pub-route-thumb {
  width: 105rpx;
  height: 90rpx;
  margin: 18rpx 0 0 16rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #eef3ee;
}

.pub-route-thumb .route-preview-map {
  width: 100%;
  height: 100%;
}

.pub-route-thumb-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff3f6;        /* 原型粉底 --red-soft */
}

/* 绿色"路线已生成"徽标（原型 .route-status）：右上角描边胶囊 */
.pub-route-status {
  position: absolute;
  top: 42rpx;                                  /* 48px ×0.879 */
  right: 62rpx;                                /* 71px ×0.879 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 125rpx;                               /* 142px ×0.879 */
  height: 42rpx;
  border: 1rpx solid #9bdcab;
  border-radius: 10rpx;
  color: #31b45f;
  background: #f5fff8;
  font-size: 20rpx;                            /* 23px ×0.879 */
  line-height: 26rpx;
  font-weight: 400;
}

/* 右侧小箭头（原型 .chev）：灰色 chevron-right SVG */
.pub-chev {
  position: absolute;
  right: 22rpx;                                /* 25px ×0.879 */
  top: 51rpx;                                  /* 58px ×0.879 */
  width: 30rpx;                                /* 34px ×0.879 */
  height: 30rpx;
}

/* 人数加减器（原型 .stepper）：白底胶囊，两端圆形按钮 + 中间数字 */
.pub-stepper {
  position: absolute;
  right: 26rpx;                                /* 30px ×0.879 */
  top: 38rpx;                                  /* 43px ×0.879 */
  display: grid;
  grid-template-columns: 42rpx 72rpx 42rpx;    /* 48/82/48 ×0.879 */
  align-items: center;
  width: 178rpx;                               /* 202px ×0.879 */
  height: 56rpx;                               /* 64px ×0.879 */
  border: 1rpx solid #dfe2e8;
  border-radius: 30rpx;                        /* 34px ×0.879 */
  background: #fff;
  text-align: center;
}

.pub-stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f7f8fa;
}

.pub-stepper-icon {
  width: 26rpx;                                /* 29px ×0.879 */
  height: 26rpx;
}

.pub-stepper-value {
  color: #151820;
  font-size: 22rpx;                            /* 25px ×0.879 */
  line-height: 30rpx;
  font-weight: 400;
}

/* 图二就地编辑控件（编辑步专属）。
   设计思路：原型每行右侧本是只读文字 + chevron 箭头；图二要"就地可编辑"，
   所以把右侧换成浅灰底圆角小输入框 / picker。
   定位：和加减器一样用 absolute 贴在行右侧、竖直居中——
   因为 .pub-row 的网格第三列只有 72rpx 太窄塞不下输入框，绝对定位才能不挤压标题列。
   风格：浅灰底(#f5f6f8) + 圆角 + 文字右对齐，贴合卡片观感。 */
.pub-edit-col {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  max-width: 360rpx;        /* 不越过图标列，给标题留空间 */
}

/* 出发时间行右侧并排两个 picker（日期 + 时间），间距小一点 */
.pub-edit-col-time {
  display: flex;
  gap: 10rpx;
}

/* 浅灰底圆角小输入框 */
.pub-input {
  min-width: 0;
  width: 320rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  color: #20242d;
  font-size: 22rpx;
  line-height: 56rpx;
  text-align: right;
}

/* picker 外观和输入框一致（浅灰圆角胶囊） */
.pub-picker {
  display: flex;
  align-items: center;
}

.pub-picker-value {
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  color: #20242d;
  font-size: 22rpx;
  line-height: 56rpx;
  text-align: center;
  white-space: nowrap;
}

/* 节奏 chip（原型 .pace-chip）：红描边胶囊红字 */
.pub-pace-chip {
  position: absolute;
  top: 46rpx;                                  /* 52px ×0.879 */
  right: 67rpx;                                /* 76px ×0.879 */
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 63rpx;                            /* 72px ×0.879 */
  height: 40rpx;                               /* 45px ×0.879 */
  padding: 0 14rpx;                            /* 0 16px ×0.879 */
  border: 1rpx solid rgba(255, 23, 68, 0.45);
  border-radius: 10rpx;
  color: #ff1744;
  background: #fff;
  font-size: 19rpx;                            /* 22px ×0.879 */
  line-height: 26rpx;
  font-weight: 400;
}

/* 活动照片行（原型 .row.photos）：标题行 block + 下方网格 */
.pub-row-photos {
  display: block;
  min-height: 251rpx;                          /* 286px ×0.879 */
}

.pub-photo-head {
  position: relative;
  display: grid;
  grid-template-columns: 105rpx 1fr 72rpx;
  min-height: 94rpx;                           /* 107px ×0.879 */
}

.pub-photo-head .pub-iconbox {
  margin-top: 26rpx;                           /* 30px ×0.879 */
}

.pub-photo-head .pub-row-body {
  padding-top: 27rpx;                          /* 31px ×0.879 */
}

/* 照片网格（原型 .photo-grid）：4 列 142px 缩 = 125rpx，左缩进对齐内容列 */
.pub-photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 125rpx);    /* 142px ×0.879 */
  column-gap: 18rpx;                           /* 21px ×0.879 */
  row-gap: 18rpx;
  margin-left: 130rpx;                         /* 148px ×0.879 */
  margin-top: 7rpx;
  padding-bottom: 20rpx;
}

.pub-photo-item {
  position: relative;
  width: 125rpx;
  height: 91rpx;                               /* 104px ×0.879 */
  border-radius: 6rpx;                         /* 7px ×0.879 */
  overflow: hidden;
  background: #eef0f3;
}

.pub-photo-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 照片右上角删除小圆（原型 .photo-remove）：白底描边，溢出到格子外一点 */
.pub-photo-remove {
  position: absolute;
  top: -8rpx;                                  /* -9px ×0.879 */
  right: -7rpx;                                /* -8px ×0.879 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;                                /* 30px ×0.879 */
  height: 26rpx;
  border: 1rpx solid #cfd2d8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
}

.pub-photo-remove-icon {
  width: 17rpx;                                /* 19px ×0.879 */
  height: 17rpx;
}

/* 添加照片虚线框（原型 .photo-add）：高度比缩略图高（137px），居中加号+文字 */
.pub-photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 125rpx;
  height: 120rpx;                              /* 137px ×0.879 */
  border: 1rpx dashed #bfc4ce;
  border-radius: 6rpx;
  color: #9aa0aa;
  background: #fff;
}

.pub-photo-add-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 9rpx;
}

.pub-photo-add-icon {
  width: 40rpx;                                /* 45px ×0.879 */
  height: 40rpx;
}

.pub-photo-add text {
  font-size: 16rpx;                            /* 18px ×0.879 */
  line-height: 21rpx;
  color: #9aa0aa;
}

/* 发布前检查（原型 .row.check）：卡片内嵌的浅边框小卡 */
.pub-check {
  position: relative;
  display: grid;
  grid-template-columns: 73rpx 1fr 40rpx;      /* 83/_/45 ×0.879 */
  align-items: center;
  min-height: 72rpx;                           /* 82px ×0.879 */
  margin: 13rpx 21rpx 11rpx;                   /* 15 24 12 ×0.879 */
  border: 1rpx solid #dfe2e8;
  border-radius: 8rpx;                         /* 9px ×0.879 */
  background: #fff;
}

.pub-check-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-left: 24rpx;
}

.pub-check-icon-img {
  width: 40rpx;                                /* 45px ×0.879 */
  height: 40rpx;
}

.pub-check-title {
  color: #20242d;
  font-size: 19rpx;                            /* 22px ×0.879 */
  line-height: 25rpx;
  font-weight: 400;
}

.pub-check-sub {
  margin-top: 3rpx;
  color: #8b8f99;
  font-size: 16rpx;                            /* 18px ×0.879 */
  line-height: 21rpx;
  font-weight: 400;
}

.pub-chev-static {
  position: static;
  justify-self: center;
  width: 25rpx;                                /* 28px ×0.879 */
  height: 25rpx;
}

/* 发布步底部栏（原型 .bottom-bar）：保存草稿(316px) + 发布约骑(1fr) */
.pub-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 278rpx 1fr;           /* 316px ×0.879 */
  column-gap: 25rpx;                           /* 28px ×0.879 */
  padding: 16rpx 25rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e8ed;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -10rpx 24rpx rgba(24, 27, 34, 0.025);
}

.pub-draft-btn,
.pub-publish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;                               /* 96px ×0.879 */
  border-radius: 8rpx;                         /* 9px ×0.879 */
  font-size: 26rpx;                            /* 30px ×0.879 */
  line-height: 34rpx;
  font-weight: 500;
}

.pub-draft-btn {
  border: 1rpx solid #dfe2e8;
  color: #151820;
  background: #fff;
}

.pub-publish-btn {
  color: #fff;
  background: #ff1744;
}

.pub-publish-btn:active,
.pub-draft-btn:active {
  transform: translateY(1rpx);
}
