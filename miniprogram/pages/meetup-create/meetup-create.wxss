page {
  background: #f2f1f6;
}

.create-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 150rpx;
  box-sizing: border-box;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.steps view {
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #6b7280;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.steps .active {
  background: #111827;
  color: #fff;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-title {
  margin: 18rpx 0 0;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 800;
  color: #111827;
}

.route-card,
.field,
.summary {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.route-card {
  border: 2rpx solid transparent;
}

.route-card.selected {
  border-color: #ff2d55;
  background: #fff5f7;
}

.route-card view {
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111827;
}

.route-card text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.tencent-route-box {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
}

.tencent-points {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.point-button,
.generate-button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.point-button {
  overflow: hidden;
  background: #f3f4f6;
  color: #111827;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.generate-button {
  width: 100%;
  background: #111827;
  color: #fff;
}

.route-preview-shell {
  position: relative;
  overflow: hidden;
  height: 360rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #eef3ee;
}

.route-preview-map {
  width: 100%;
  height: 100%;
}

.route-preview-label {
  position: absolute;
  left: 20rpx;
  bottom: 18rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.field text {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b7280;
}

.field input,
.picker-value {
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  color: #111827;
}

/* 出发/结束：日期占宽一点、时间窄一点，横向并排 */
.datetime {
  display: flex;
  gap: 12rpx;
}

.datetime .dt-date {
  flex: 3;
}

.datetime .dt-time {
  flex: 2;
}

.field textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f3f4f6;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #111827;
}

.summary-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 800;
  color: #111827;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #374151;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(17, 24, 39, 0.08);
}

.bottom-actions button:only-child {
  grid-column: 1 / 3;
}

.primary,
.ghost {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary {
  background: #ff2d55;
  color: #fff;
}

.ghost {
  background: #fff;
  color: #111827;
  border: 1rpx solid #d1d5db;
}

/* 照片墙：标题行（左标题 + 右"加照片"）+ 多列 grid，风格照搬详情页保持一致 */
.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.add-media {
  font-size: 26rpx;
  color: #ff2d55;
  font-weight: 700;
}

.media-empty {
  font-size: 26rpx;
  color: #86868b;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.media-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
}

.media-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  display: block;
}

.media-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  font-size: 28rpx;
}

/* —— 发布前总览（图二）—— */
.preview {
  gap: 16rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag,
.template-list view,
.anti-harass {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
  line-height: 34rpx;
}

.tag.selected {
  background: #111827;
  color: #fff;
}

.compact {
  padding: 0;
  margin-top: 16rpx;
  background: transparent;
}

.template-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}

.invite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-share {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ff2d55;
  background: #fff;
  border: 1rpx solid #ff2d55;
  border-radius: 28rpx;
}

.invitee-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #111827;
}

.invitee-list text {
  margin-left: 12rpx;
  color: #ff2d55;
  font-size: 22rpx;
}

.anti-harass {
  text-align: center;
  color: #6b7280;
}
