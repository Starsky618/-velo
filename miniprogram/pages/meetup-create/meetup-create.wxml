<view class="create-page" data-current="{{currentStep}}">
  <!-- 顶部标题区：原型独立画框里有自绘返回箭头，小程序顶部已有系统原生导航返回，故不再重复画 back，只保留标题+副标题 -->
  <view class="wiz-head">
    <view class="wiz-title">发起约骑</view>
    <view class="wiz-subtitle">30 秒发起一次靠谱约骑</view>
  </view>

  <!--
    顶部步骤指示器：原型的"圆圈 + 连接线"样式。
    设计思路：把"路线→编辑→确认"三步排成一行，每个圆圈三态——
      done（已完成，显示对勾√，红边白底）/ current（当前步，红底白字数字）/ 灰色待办（todo，红边白字数字）。
    判定哪一步算 done/current，靠 currentStep 在三步（route→edit→confirm）里的"位置"比较。
    类比：像地铁线路图，已坐过的站打勾、当前站点亮、后面的站灰着；连接线是两站之间的轨道（3 站 = 2 段轨道）。
  -->
  <view class="wiz-steps">
    <!-- 第1步 路线：只有还停在 route 步才是 current，进入 edit/confirm 后算 done -->
    <view class="wiz-step {{currentStep === 'route' ? 'current' : 'done'}}">
      <view class="wiz-mark">
        <image wx:if="{{currentStep !== 'route'}}" class="wiz-mark-icon" src="/assets/icons/meetup/check.svg" mode="aspectFit" />
        <text wx:else>1</text>
      </view>
      <view class="wiz-step-label">路线</view>
      <view class="wiz-line"></view>
    </view>
    <!-- 第2步 编辑(edit)：route 时待办、edit 时 current、confirm 时 done -->
    <view class="wiz-step {{currentStep === 'route' ? 'todo' : (currentStep === 'edit' ? 'current' : 'done')}}">
      <view class="wiz-mark">
        <image wx:if="{{currentStep === 'confirm'}}" class="wiz-mark-icon" src="/assets/icons/meetup/check.svg" mode="aspectFit" />
        <text wx:else>2</text>
      </view>
      <view class="wiz-step-label">编辑</view>
      <view class="wiz-line"></view>
    </view>
    <!-- 第3步 确认(confirm)：最后一步无连接线，仅 confirm 时 current -->
    <view class="wiz-step {{currentStep === 'confirm' ? 'current' : 'todo'}}">
      <view class="wiz-mark"><text>3</text></view>
      <view class="wiz-step-label">确认</view>
    </view>
  </view>

  <view wx:if="{{currentStep === 'route'}}" class="panel">
    <view class="section-title">赛段</view>
    <view class="route-card {{selectedSegmentId === item.id ? 'selected' : ''}}" wx:for="{{segments}}" wx:key="id" data-type="segment" data-index="{{index}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="selectRoute">
      <view>{{item.displayName}}</view>
      <text>{{item.displayMeta}}</text>
    </view>

    <view class="section-title">腾讯地图生成</view>
    <view class="tencent-route-box">
      <view class="tencent-points">
        <button class="point-button" bindtap="onTapChooseTencentStart">{{tencentStartText}}</button>
        <button class="point-button" bindtap="onTapChooseTencentEnd">{{tencentEndText}}</button>
      </view>
      <input class="tencent-route-name" value="{{tencentRouteName}}" maxlength="40" bindinput="onTencentRouteNameInput" placeholder="给这条路线起个名字" />
      <button class="generate-button" loading="{{creatingTencentRoute}}" disabled="{{creatingTencentRoute}}" bindtap="onTapCreateTencentRoute">生成路线</button>
      <view wx:if="{{routePreviewVisible}}" class="route-preview-shell">
        <canvas canvas-id="route-preview-main" class="route-preview-canvas"></canvas>
        <view class="route-preview-label">路线预览图（非导航）</view>
      </view>
    </view>

    <view wx:if="{{officialRouteBooks.length}}" class="section-title">官方路线</view>
    <view class="route-card {{selectedRouteBookId === item.id ? 'selected' : ''}}" wx:for="{{officialRouteBooks}}" wx:key="id" data-type="route_book" data-source="official" data-index="{{index}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="selectRoute">
      <view>{{item.displayName}}</view>
      <text>{{item.displayMeta}}</text>
    </view>

    <view class="section-title">我的路书</view>
    <view class="route-card {{selectedRouteBookId === item.id ? 'selected' : ''}}" wx:for="{{routeBooks}}" wx:key="id" data-type="route_book" data-source="mine" data-index="{{index}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="selectRoute">
      <view>{{item.displayName}}</view>
      <text>{{item.displayMeta}}</text>
    </view>

    <view class="section-title">从骑行生成</view>
    <view class="route-card {{selectedActivityId === item.id ? 'selected' : ''}}" wx:for="{{activities}}" wx:key="id" data-type="activity" data-index="{{index}}" data-id="{{item.id}}" data-name="{{item.displayName}}" bindtap="selectRoute">
      <view>{{item.displayName}}</view>
      <text>{{item.displayMeta}}</text>
    </view>
  </view>

  <!--
    编辑步（第2步 / currentStep === 'edit'）：保留原 publish 白卡片视觉，但右侧从"只读+箭头"换成"就地可编辑"。
    设计思路：用户在图二一次性把所有字段填好/改好，不再像旧流程那样点箭头逐项跳回上一步。
    每行结构仍是原型 .pub-row 三栏网格（图标列 / 内容列 / 右侧控件列），
      只把第三列从 chevron 箭头换成对应的编辑控件（picker / input / 加减器）。
    路线行例外：保持只读（左侧地图缩略图 + 右侧"路线已生成"徽标），路线在第 1 步已选定，这里不可改。
    照片用真照片网格（复用 mediaList + onTapAddMedia/onTapDeleteMedia/onTapPreviewMedia）。
  -->
  <view wx:if="{{currentStep === 'edit'}}" class="panel pub-card">
    <!-- 路线行：左侧轨迹缩略线（canvas 自绘形状，替代原生地图——原生组件层级
         盖按钮 + 抢手势是"地图与按键位置冲突"bug 的根源），右侧"路线已生成"徽标；只读不可编辑 -->
    <view class="pub-row">
      <view class="pub-route-thumb">
        <canvas wx:if="{{routePreviewVisible}}" canvas-id="route-thumb-edit" class="route-thumb-canvas"></canvas>
        <view wx:else class="pub-route-thumb-fallback">
          <image class="pub-icon pub-icon-route" src="/assets/icons/meetup/map.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="pub-row-body">
        <view class="pub-row-title">路线</view>
        <view class="pub-row-sub">{{selectedRouteName}}</view>
      </view>
      <view class="pub-route-status">路线已生成</view>
    </view>

    <!-- 出发时间：右侧放日期 + 时间两个 picker，结束时间 js 自动顺延（图二不露出） -->
    <view class="pub-row">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/clock.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">出发时间</view>
        <view class="pub-row-sub">{{startDate}} {{startTime}}</view>
      </view>
      <view class="pub-edit-col pub-edit-col-time">
        <picker class="pub-picker" mode="date" value="{{startDate}}" start="{{minStartDate}}" bindchange="onStartDateChange">
          <view class="pub-picker-value">{{startDate}}</view>
        </picker>
        <picker class="pub-picker" mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
          <view class="pub-picker-value">{{startTime}}</view>
        </picker>
      </view>
    </view>

    <!-- 集合地点：整行点击进地图选点（唯一路径=搜索/选点→地图确认，不手填——Tim 2026-06-13 拍） -->
    <view class="pub-row pub-row-tappable" bindtap="onTapChooseMeetingPoint">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/map-pin.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">集合地点</view>
        <view wx:if="{{form.meeting_point}}" class="pub-row-sub">{{form.meeting_point}}</view>
        <view wx:else class="pub-row-sub pub-row-sub-muted">去地图选点，支持搜地名</view>
      </view>
      <view class="pub-row-chevron">›</view>
    </view>
    <view wx:if="{{form.meeting_point}}" class="pub-place-actions">
      <button class="pub-place-btn pub-place-btn-save" bindtap="saveMeetingPointAsFavorite">存为常用集合点</button>
    </view>
    <scroll-view wx:if="{{favoritePlaces.length}}" class="pub-favorite-places" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{favoritePlaces}}" wx:key="id" class="pub-favorite-place" data-index="{{index}}" bindtap="applyFavoritePlace">
        <view class="pub-favorite-name">{{item.name}}</view>
        <view class="pub-favorite-address">{{item.address}}</view>
      </view>
    </scroll-view>

    <!-- 人数上限：右侧加减器（catchtap onStepMax，已可用，不改） -->
    <view class="pub-row">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/users-round.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">人数上限</view>
        <view class="pub-row-sub">{{form.max_participants}} 人</view>
      </view>
      <view class="pub-stepper">
        <view class="pub-stepper-btn" catchtap="onStepMax" data-delta="-1"><image class="pub-stepper-icon" src="/assets/icons/meetup/minus.svg" mode="aspectFit" /></view>
        <text class="pub-stepper-value">{{form.max_participants}}</text>
        <view class="pub-stepper-btn" catchtap="onStepMax" data-delta="1"><image class="pub-stepper-icon" src="/assets/icons/meetup/plus.svg" mode="aspectFit" /></view>
      </view>
    </view>

    <!-- 骑行节奏：右侧 picker 选择节奏 -->
    <view class="pub-row">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/gauge.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">骑行节奏</view>
      </view>
      <view class="pub-edit-col">
        <picker class="pub-picker" mode="selector" range="{{paceOptions}}" range-key="label" bindchange="onPaceChange">
          <view class="pub-picker-value">{{paceLabel}}</view>
        </picker>
      </view>
    </view>

    <!-- 补给点：手填为主（地点高度自由），下面给最近用过的快选（本地缓存，复用率高） -->
    <view class="pub-row">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/cup-soda.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">补给点</view>
      </view>
      <view class="pub-edit-col">
        <input class="pub-input" value="{{form.supply_point}}" data-field="supply_point" bindinput="updateField" placeholder="例如：天龙山景区口" />
      </view>
    </view>
    <scroll-view wx:if="{{supplyPointHistory.length}}" class="pub-supply-history" scroll-x="true" show-scrollbar="{{false}}">
      <view wx:for="{{supplyPointHistory}}" wx:key="*this" class="pub-supply-chip" data-value="{{item}}" bindtap="applySupplyPoint">{{item}}</view>
    </scroll-view>

    <!-- 活动说明：右侧单行就地输入 -->
    <view class="pub-row">
      <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/file-text.svg" mode="aspectFit" /></view>
      <view class="pub-row-body">
        <view class="pub-row-title">活动说明</view>
      </view>
      <view class="pub-edit-col">
        <input class="pub-input" value="{{form.description}}" data-field="description" bindinput="updateField" placeholder="预计时长、装备要求等" />
      </view>
    </view>

    <!-- 活动照片：标题行 + 4 列真照片网格（复用 mediaList 增删/预览）-->
    <view class="pub-row pub-row-photos">
      <view class="pub-photo-head">
        <view class="pub-iconbox"><image class="pub-icon" src="/assets/icons/meetup/image.svg" mode="aspectFit" /></view>
        <view class="pub-row-body">
          <view class="pub-row-title">活动照片<text class="pub-optional">（选填）</text></view>
          <view class="pub-row-sub pub-row-sub-muted">已添加 {{mediaList.length}} 张</view>
        </view>
      </view>
      <view class="pub-photo-grid">
        <view class="pub-photo-item" wx:for="{{mediaList}}" wx:key="id">
          <video wx:if="{{item.isVideo}}" src="{{item.url}}" class="pub-photo-img"></video>
          <image wx:else src="{{item.url}}" mode="aspectFill" class="pub-photo-img" data-url="{{item.url}}" bindtap="onTapPreviewMedia"></image>
          <view class="pub-photo-remove" data-id="{{item.id}}" catchtap="onTapDeleteMedia">
            <image class="pub-photo-remove-icon" src="/assets/icons/meetup/x.svg" mode="aspectFit" />
          </view>
        </view>
        <view class="pub-photo-add" bindtap="onTapAddMedia">
          <view class="pub-photo-add-inner">
            <image class="pub-photo-add-icon" src="/assets/icons/meetup/plus-add.svg" mode="aspectFit" />
            <text>添加照片</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 发布前检查：内嵌一个浅边框小卡片 -->
    <view class="pub-check">
      <view class="pub-check-icon"><image class="pub-check-icon-img" src="/assets/icons/meetup/shield-check.svg" mode="aspectFit" /></view>
      <view class="pub-check-body">
        <view class="pub-check-title">发布前检查</view>
        <view class="pub-check-sub">请确认以上信息准确，发布后可随时编辑。</view>
      </view>
      <image class="pub-chev pub-chev-static" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" />
    </view>
  </view>

  <!--
    发布前总览确认页（第3步 / currentStep === 'confirm'）：逐像素还原原型 meetup-create-visual-clone.html。
    缩放系数 750/853 ≈ 0.879，原型所有 px ×0.879 → rpx；颜色/圆角/阴影/字重 1:1。
    结构：路线卡(地图缩略图+名称+已生成+三项数据) → 适合谁(6 pill) → 节奏与门槛(3列+门槛行)
         → 报名规则(人数/可见范围两盒子/截止/安全提示/集合) → 已邀请骑友 → 反骚扰条。
    交互：适合谁 toggleAudienceTag / 可见范围 onSelectVisibility 两盒子 / 安全提示+门槛点行展开 textarea 可编辑。
    确认并发布按钮统一放底部栏（confirm 步），此 panel 内不再内嵌发布按钮，避免重复。
  -->
  <view wx:elif="{{currentStep === 'confirm'}}" class="panel pv-page">
    <!-- 路线卡：左侧轨迹缩略线（canvas 自绘，同编辑步），右侧名称 + 已生成徽标 + 距离/爬升/时长三项数据 -->
    <view class="pv-card pv-route-card">
      <view class="pv-map-thumb">
        <canvas wx:if="{{routePreviewVisible}}" canvas-id="route-thumb-confirm" class="route-thumb-canvas"></canvas>
        <view wx:else class="pv-map-fallback">
          <image class="pv-map-fallback-icon" src="/assets/icons/meetup/map.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="pv-route-main">
        <view class="pv-route-title-row">
          <view class="pv-route-title">{{selectedRouteName}}</view>
          <view class="pv-status-chip">已生成</view>
        </view>
        <view class="pv-route-line"></view>
        <view class="pv-route-stats">
          <view wx:if="{{routeDistanceText !== ''}}" class="pv-stat">
            <image class="pv-stat-icon" src="/assets/icons/meetup/gauge.svg" mode="aspectFit" />
            <view class="pv-stat-num">{{routeDistanceText}} <text class="pv-stat-unit">km</text></view>
            <view class="pv-stat-label">距离</view>
          </view>
          <view wx:if="{{routeClimbText !== ''}}" class="pv-stat">
            <image class="pv-stat-icon" src="/assets/icons/meetup/mountain.svg" mode="aspectFit" />
            <view class="pv-stat-num">{{routeClimbText}} <text class="pv-stat-unit">m</text></view>
            <view class="pv-stat-label">爬升</view>
          </view>
          <view wx:if="{{estimatedDurationText}}" class="pv-stat">
            <image class="pv-stat-icon" src="/assets/icons/meetup/clock.svg" mode="aspectFit" />
            <view class="pv-stat-num">{{estimatedDurationText}}</view>
            <view class="pv-stat-label">预计时长</view>
          </view>
          <view class="pv-route-detail" bindtap="onTapPreviewRouteDetail">
            <text>查看详情</text>
            <image class="pv-route-detail-chev" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <!-- 适合谁：6 个 pill，选中态红边+右下角红勾；女性友好=红胶囊 soft、新手慎选=灰胶囊 muted -->
    <view class="pv-card pv-section">
      <view class="pv-section-title">适合谁</view>
      <view class="pv-pills">
        <view wx:for="{{audienceOptions}}" wx:key="value"
              class="pv-pill {{item.selected ? 'active' : ''}} {{item.value === 'female_friendly' ? 'soft' : ''}} {{item.value === 'newbie_caution' ? 'muted' : ''}}"
              data-value="{{item.value}}" bindtap="toggleAudienceTag">
          <image class="pv-pill-icon" src="{{item.icon}}" mode="aspectFit" />
          <text>{{item.label}}</text>
          <view wx:if="{{item.selected}}" class="pv-check-dot">
            <image class="pv-check-dot-icon" src="/assets/icons/meetup/check.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
      <view class="pv-audience-note">我们鼓励友善、互助的骑行氛围。</view>
    </view>

    <!-- 节奏与门槛：3 列(强度/功率/均速 各带下拉箭头) + 分隔线 + 报名门槛行 -->
    <view class="pv-card pv-section">
      <view class="pv-section-title">节奏与门槛</view>
      <view class="pv-pace-grid">
        <view class="pv-pace-col">
          <view class="pv-pace-label">强度预期</view>
          <picker class="pv-pace-picker" mode="selector" range="{{paceOptions}}" range-key="label" value="{{paceIndex}}" bindchange="onPaceChange">
            <view class="pv-pace-value">{{paceLabel}}<image class="pv-pace-chev" src="/assets/icons/meetup/chevron-down.svg" mode="aspectFit" /></view>
          </picker>
        </view>
        <!-- 推荐功率/预计均速：区间选择器不手打（Tim 2026-06-13 拍：给骑友现成组件挑，不让他写）。
             跟着强度预期联动默认值，想改就从区间里挑一档 -->
        <view class="pv-pace-col">
          <view class="pv-pace-label">推荐功率</view>
          <picker class="pv-pace-picker" mode="selector" range="{{powerOptions}}" value="{{powerIndex}}" data-kind="power" bindchange="onPaceHintChange">
            <view class="pv-pace-value">{{recommendedPowerLabel}}<image class="pv-pace-chev" src="/assets/icons/meetup/chevron-down.svg" mode="aspectFit" /></view>
          </picker>
        </view>
        <view class="pv-pace-col">
          <view class="pv-pace-label">预计均速</view>
          <picker class="pv-pace-picker" mode="selector" range="{{speedOptions}}" value="{{speedIndex}}" data-kind="speed" bindchange="onPaceHintChange">
            <view class="pv-pace-value">{{averageSpeedRange}}<image class="pv-pace-chev" src="/assets/icons/meetup/chevron-down.svg" mode="aspectFit" /></view>
          </picker>
        </view>
      </view>
      <view class="pv-divider"></view>
      <!-- 报名门槛行：点行展开后是预设标签多选（Tim 2026-06-13 拍：挑现成的，不手打）+ 兜底手打补充 -->
      <view class="pv-gate-row" bindtap="togglePvEditGate">
        <view class="pv-round-icon"><image class="pv-round-icon-img" src="/assets/icons/meetup/calendar-plus.svg" mode="aspectFit" /></view>
        <view class="pv-gate-body">
          <view wx:if="{{form.eligibility_note}}" class="pv-gate-title">{{form.eligibility_note}}</view>
          <view wx:else class="pv-gate-title pv-gate-title-empty">未设置门槛</view>
          <view class="pv-gate-sub">为保障安全与体验，满足条件方可报名</view>
        </view>
        <view class="pv-edit-link"><text>{{pvEditGate ? '收起' : '设置门槛'}}</text><image class="pv-edit-chev" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" /></view>
      </view>
      <block wx:if="{{pvEditGate}}">
        <view class="pv-template-chips">
          <view wx:for="{{eligibilityOptions}}" wx:key="label"
                class="pv-template-chip {{item.selected ? 'active' : ''}}"
                data-label="{{item.label}}" bindtap="toggleEligibilityTag">{{item.label}}</view>
        </view>
        <textarea class="pv-edit-textarea" value="{{form.eligibility_note}}" data-field="eligibility_note" bindinput="updateField" maxlength="100" placeholder="挑上面的标签，或在这里补充特殊要求" />
      </block>
    </view>

    <!-- 报名规则：人数 / 可见范围两盒子 / 报名截止 / 安全提示(可编辑) / 集合信息 -->
    <view class="pv-card pv-section">
      <view class="pv-section-title">报名规则</view>

      <view class="pv-rule-row">
        <view class="pv-rule-label">人数上限</view>
        <view class="pv-rule-value">{{form.max_participants}} 人</view>
      </view>

      <view class="pv-rule-block">
        <view class="pv-rule-label">可见范围</view>
        <view class="pv-visibility-options">
          <view class="pv-visibility-box {{form.visibility === 'invite_only' ? 'active' : ''}}" data-value="invite_only" bindtap="onSelectVisibility">
            <image class="pv-visibility-icon" src="{{form.visibility === 'invite_only' ? '/assets/icons/meetup/lock-keyhole-active.svg' : '/assets/icons/meetup/lock-keyhole.svg'}}" mode="aspectFit" />
            <view class="pv-visibility-text">
              <view class="pv-visibility-main">私圈可见</view>
              <view class="pv-visibility-sub">仅被邀请的人可见</view>
            </view>
          </view>
          <view class="pv-visibility-box {{form.visibility === 'public' ? 'active' : ''}}" data-value="public" bindtap="onSelectVisibility">
            <image class="pv-visibility-icon" src="{{form.visibility === 'public' ? '/assets/icons/meetup/globe-active.svg' : '/assets/icons/meetup/globe.svg'}}" mode="aspectFit" />
            <view class="pv-visibility-text">
              <view class="pv-visibility-main">本城可见</view>
              <view class="pv-visibility-sub">太原市骑友可见</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{registrationDeadlineLabel}}" class="pv-rule-row">
        <view class="pv-rule-label">报名截止</view>
        <view class="pv-rule-value">{{registrationDeadlineLabel}}</view>
      </view>

      <!-- 安全提示：点行展开 textarea + 模板 chips（视觉是展示行，但能改）-->
      <view class="pv-rule-row" bindtap="togglePvEditSafety">
        <view class="pv-rule-label">安全提示</view>
        <view class="pv-rule-value pv-rule-value-r">{{form.safety_note}}</view>
        <image class="pv-rule-chev" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" />
      </view>
      <block wx:if="{{pvEditSafety}}">
        <textarea class="pv-edit-textarea" value="{{form.safety_note}}" data-field="safety_note" bindinput="updateField" maxlength="200" />
        <view class="pv-template-chips">
          <view wx:for="{{safetyTemplates}}" wx:key="*this" class="pv-template-chip" data-index="{{index}}" bindtap="applySafetyTemplate">{{item}}</view>
        </view>
      </block>

      <view wx:if="{{form.meeting_point}}" class="pv-rule-row pv-rule-row-top">
        <view class="pv-rule-label">集合信息</view>
        <view class="pv-rule-value pv-rule-value-r">集合：{{form.meeting_point}}</view>
      </view>
    </view>

    <!-- 已邀请骑友：头像 + 昵称 + 组织者/标签 + 继续邀请（微信原生转发）-->
    <view class="pv-card pv-invite-card">
      <view class="pv-invite-top">
        <view class="pv-section-title">已邀请骑友（{{invitees.length}}）</view>
        <button class="pv-invite-link" open-type="share">继续邀请<image class="pv-invite-chev" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" /></button>
      </view>
      <view wx:if="{{invitees.length === 0}}" class="pv-invite-empty">发布后发起人会自动加入</view>
      <view wx:else class="pv-riders">
        <view class="pv-rider" wx:for="{{invitees}}" wx:key="user_id">
          <image wx:if="{{item.avatar_url}}" class="pv-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
          <view wx:else class="pv-avatar pv-avatar-placeholder">{{item.nickname ? item.nickname[0] : 'V'}}</view>
          <view class="pv-rider-name">{{item.nickname || 'VELO 骑友'}}</view>
          <view wx:if="{{item.is_creator}}" class="pv-rider-tag organizer">组织者</view>
          <view wx:else class="pv-rider-tag">最近同行</view>
        </view>
      </view>
    </view>

    <!-- 反骚扰提示条 -->
    <view class="pv-safety-strip">
      <image class="pv-safety-icon" src="/assets/icons/meetup/shield-check.svg" mode="aspectFit" />
      <text class="pv-safety-text">VELO 反骚扰机制已开启，违规行为将被严肃处理</text>
      <view class="pv-learn-more"><text>了解更多</text><image class="pv-learn-chev" src="/assets/icons/meetup/chevron-right.svg" mode="aspectFit" /></view>
    </view>

  </view>

  <!--
    底部按钮栏：按 currentStep 三态切换（统一所有发布/确认入口在底部栏，panel 内不再内嵌按钮）。
    - route 步：单个「下一步」（nextStep：route→edit）
    - edit 步：「保存草稿」(saveDraft 落库退出) + 「下一步」(nextStep：edit→落库进 confirm)，两按钮并排
    - confirm 步：「上一步」(prevStep：confirm→edit) + 「确认并发布」(onConfirmPublish)
  -->
  <view wx:if="{{currentStep === 'route'}}" class="bottom-actions">
    <button class="primary" bindtap="nextStep">下一步</button>
  </view>
  <view wx:elif="{{currentStep === 'edit'}}" class="pub-bottom-bar">
    <button class="pub-draft-btn" bindtap="saveDraft">保存草稿</button>
    <button class="pub-publish-btn" bindtap="nextStep">下一步</button>
  </view>
  <view wx:elif="{{currentStep === 'confirm'}}" class="pub-bottom-bar">
    <button class="pub-draft-btn" bindtap="prevStep">上一步</button>
    <button class="pub-publish-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onConfirmPublish">确认并发布</button>
  </view>
</view>
