<!--
  排行榜页
  赛段选择器 + 赛段信息 + 排行榜列表
-->

<view class="page-header">
  <text class="subtitle">RIDEMAP</text>
  <text class="title">排行榜</text>
</view>

<!-- 赛段选择器（横向滚动） -->
<scroll-view scroll-x class="seg-scroll" wx:if="{{segments.length}}">
  <view class="seg-list">
    <view class="seg-tag {{activeIdx === index ? 'active' : ''}}"
      wx:for="{{segments}}" wx:key="id"
      bindtap="switchSegment" data-idx="{{index}}">
      <text>{{item.name}}</text>
    </view>
  </view>
</scroll-view>

<!-- 选中赛段信息 -->
<view class="seg-info card" wx:if="{{detail}}">
  <text class="seg-name">{{detail.name}}</text>
  <view class="seg-meta">
    <view class="seg-meta-item">
      <text class="seg-meta-value">{{detail.distance}}</text>
      <text class="seg-meta-unit">km</text>
    </view>
    <view class="seg-meta-item" wx:if="{{detail.elevation_gain}}">
      <text class="seg-meta-value">{{detail.elevation_gain}}</text>
      <text class="seg-meta-unit">m ↑</text>
    </view>
    <view class="seg-meta-item">
      <text class="seg-meta-value">{{detail.leaderboard.length}}</text>
      <text class="seg-meta-unit">人挑战</text>
    </view>
  </view>
</view>

<!-- 排行榜列表 -->
<view wx:if="{{detail && detail.leaderboard.length}}">
  <!-- 前三名领奖台 -->
  <view class="podium" wx:if="{{detail.leaderboard.length >= 3}}">
    <!-- 第二名 -->
    <view class="podium-item silver">
      <view class="podium-avatar">
        <text>{{detail.leaderboard[1].initial}}</text>
      </view>
      <text class="podium-name">{{detail.leaderboard[1].nickname}}</text>
      <text class="podium-time">{{detail.leaderboard[1].timeText}}</text>
      <view class="podium-bar silver-bar">
        <text class="podium-medal">🥈</text>
      </view>
    </view>
    <!-- 第一名（中间最高） -->
    <view class="podium-item gold">
      <view class="podium-avatar gold-avatar">
        <text>{{detail.leaderboard[0].initial}}</text>
      </view>
      <text class="podium-name">{{detail.leaderboard[0].nickname}}</text>
      <text class="podium-time">{{detail.leaderboard[0].timeText}}</text>
      <view class="podium-bar gold-bar">
        <text class="podium-medal">🥇</text>
      </view>
    </view>
    <!-- 第三名 -->
    <view class="podium-item bronze">
      <view class="podium-avatar">
        <text>{{detail.leaderboard[2].initial}}</text>
      </view>
      <text class="podium-name">{{detail.leaderboard[2].nickname}}</text>
      <text class="podium-time">{{detail.leaderboard[2].timeText}}</text>
      <view class="podium-bar bronze-bar">
        <text class="podium-medal">🥉</text>
      </view>
    </view>
  </view>

  <!-- 第4名及以后的列表 -->
  <view class="rank-list">
    <view class="rank-item {{item.isMe ? 'me' : ''}}"
      wx:for="{{detail.leaderboard}}" wx:key="rank"
      wx:if="{{index >= 3}}">
      <text class="rank-num">{{item.rank}}</text>
      <view class="rank-avatar">
        <text>{{item.initial}}</text>
      </view>
      <view class="rank-info">
        <text class="rank-name {{item.isMe ? 'me-name' : ''}}">{{item.nickname}}{{item.isMe ? ' (你)' : ''}}</text>
        <text class="rank-speed" wx:if="{{item.avg_speed}}">{{item.avg_speed}} km/h</text>
      </view>
      <text class="rank-time">{{item.timeText}}</text>
    </view>
  </view>

  <!-- 不足3人时直接显示列表 -->
  <view class="rank-list" wx:if="{{detail.leaderboard.length < 3}}">
    <view class="rank-item {{item.isMe ? 'me' : ''}}"
      wx:for="{{detail.leaderboard}}" wx:key="rank">
      <text class="rank-num">{{item.rank}}</text>
      <view class="rank-avatar">
        <text>{{item.initial}}</text>
      </view>
      <view class="rank-info">
        <text class="rank-name {{item.isMe ? 'me-name' : ''}}">{{item.nickname}}{{item.isMe ? ' (你)' : ''}}</text>
        <text class="rank-speed" wx:if="{{item.avg_speed}}">{{item.avg_speed}} km/h</text>
      </view>
      <text class="rank-time">{{item.timeText}}</text>
    </view>
  </view>
</view>

<!-- 空状态 -->
<view class="empty-state" wx:if="{{!loading && (!detail || !detail.leaderboard.length)}}">
  <text class="empty-icon">🏆</text>
  <text class="empty-text">暂无成绩</text>
  <text class="empty-hint">上传骑行记录后自动匹配赛段排名</text>
</view>

<!-- 无赛段 -->
<view class="empty-state" wx:if="{{!loading && segments.length === 0}}">
  <text class="empty-icon">🗺️</text>
  <text class="empty-text">暂无赛段</text>
  <text class="empty-hint">赛段由管理员创建</text>
</view>
