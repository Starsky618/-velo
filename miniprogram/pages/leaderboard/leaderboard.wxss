/* 排行榜页样式 */

/* ── 赛段选择器（横向滚动标签） ── */
.seg-scroll {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
}

.seg-list {
  display: inline-flex;
  gap: 12rpx;
}

.seg-tag {
  display: inline-flex;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-2);
  background: var(--color-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.seg-tag.active {
  color: #ffffff;
  background: var(--color-text-1);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

/* ── 赛段信息卡片 ── */
.seg-info {
  margin: 0 24rpx 24rpx;
}

.seg-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-1);
  display: block;
  margin-bottom: 16rpx;
}

.seg-meta {
  display: flex;
  gap: 32rpx;
}

.seg-meta-item {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.seg-meta-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-1);
}

.seg-meta-unit {
  font-size: 22rpx;
  color: var(--color-text-3);
}

/* ══════ 领奖台 ══════ */
.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 32rpx 24rpx 0;
  gap: 12rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 220rpx;
}

.podium-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-1);
  margin-bottom: 8rpx;
}

.gold-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #ffffff;
  font-size: 32rpx;
}

.podium-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
  margin-bottom: 4rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-time {
  font-size: 22rpx;
  color: var(--color-text-2);
  margin-bottom: 12rpx;
}

/* 领奖台柱子 */
.podium-bar {
  width: 100%;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 16rpx;
}

.gold-bar {
  height: 140rpx;
  background: linear-gradient(180deg, rgba(255, 215, 0, 0.15), rgba(255, 215, 0, 0.05));
}

.silver-bar {
  height: 100rpx;
  background: linear-gradient(180deg, rgba(192, 192, 192, 0.15), rgba(192, 192, 192, 0.05));
}

.bronze-bar {
  height: 76rpx;
  background: linear-gradient(180deg, rgba(205, 127, 50, 0.15), rgba(205, 127, 50, 0.05));
}

.podium-medal {
  font-size: 40rpx;
}

/* ══════ 排名列表（第4名起） ══════ */
.rank-list {
  padding: 16rpx 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  background: var(--color-card);
  border-radius: var(--radius-sm);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.03);
}

/* 如果是当前用户，高亮 */
.rank-item.me {
  background: var(--color-primary-light);
  border: 2rpx solid rgba(255, 45, 85, 0.2);
}

.rank-num {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-2);
  text-align: center;
  flex-shrink: 0;
}

.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-1);
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-name.me-name {
  color: var(--color-primary);
}

.rank-speed {
  font-size: 22rpx;
  color: var(--color-text-3);
}

.rank-time {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-1);
  flex-shrink: 0;
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-1);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-3);
}
