/* 探索页（路线百科）——苹果方案：趴在 iOS HIG 上 + 系统橙 accent。
   色板全部用 iOS 系统语义色：背景 systemGroupedBackground / 主文字 label /
   次文字 secondaryLabel / accent systemOrange。不自创颜色。 */

.route-list-page {
  min-height: 100vh;
  background: #f2f2f7;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.page-head {
  margin: 20rpx 4rpx 30rpx;
}

/* 中文字重铁律：PingFang 真字重上限是 600，写 700+ 会触发合成加粗（笔画糊）——
   "字体丑"的头号来源。中文一律 ≤600。 */
.page-title {
  color: #1c1c1e;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 27rpx;
}

.create-route-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.create-copy {
  flex: 1;
  min-width: 0;
}

.section-title,
.encyclopedia-title {
  color: #1c1c1e;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #8a8a8e;
  font-size: 24rpx;
  line-height: 1.45;
}

.draw-route-button {
  flex: 0 0 188rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #ff9500;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.encyclopedia-title {
  margin: 4rpx 4rpx 18rpx;
}

.state-text {
  padding: 100rpx 0;
  color: #8a8a8e;
  font-size: 28rpx;
  text-align: center;
}

/* ── 骨架屏：和 .guide-card 同外形的灰块占位 ──
   设计：卡片轮廓一模一样（圆角/阴影/尺寸），内部内容换成灰块；
   sk-shimmer 给灰块一个左右扫光的呼吸动画，暗示"正在加载"而非"卡死"。 */
.skeleton-card {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.sk-cover {
  width: 100%;
  height: 320rpx;   /* 和真封面 .cover 同高，换卡时不跳动 */
}

.sk-body {
  padding: 24rpx 30rpx 30rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 8rpx;
}

.sk-line-title {
  width: 55%;       /* 模拟路线名长度 */
  height: 34rpx;
}

.sk-line-meta {
  width: 38%;       /* 模拟数据行长度 */
  margin-top: 16rpx;
}

/* 扫光动画：浅灰底上一条更亮的光带从左扫到右，2 秒一轮。
   用 background 渐变 + background-position 位移实现（小程序支持 keyframes）。 */
.sk-shimmer {
  background: linear-gradient(
    100deg,
    #ececf0 30%,
    #f5f5f7 50%,
    #ececf0 70%
  );
  background-size: 200% 100%;
  animation: sk-shimmer 1.4s ease-in-out infinite;
}

@keyframes sk-shimmer {
  0% { background-position: 150% 0; }
  100% { background-position: -50% 0; }
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* 大图卡：图在上、信息在下（标杆：iOS 原生 feed 卡），
   大圆角 + 轻阴影 + 无边框 = HIG 卡片语言 */
.guide-card {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.cover-wrap {
  position: relative;
}

.cover {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #e9e9ee;
}

/* "有轨迹"徽标：白底橙字小胶囊浮在图上；文字版不打标（不强调缺失） */
.chip {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #e07f00;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.card-body {
  padding: 24rpx 30rpx 30rpx;
}

.guide-name {
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

/* 数据行：iOS 原生 App 的真实做法——不换字体族（mono 族会落到呆板的 Menlo），
   用系统字 + tabular-nums 等宽数字特性：数字仍是 SF 的现代字形，宽度对齐不跳动 */
.meta {
  margin-top: 10rpx;
  color: #1c1c1e;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

.highlight {
  margin-top: 8rpx;
  color: #8a8a8e;
  font-size: 26rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
