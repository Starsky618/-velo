/*
 * 探索页样式 — 赛段瀑布流（task-4.4 改造）
 *
 * 这个文件干什么：
 *   - 顶部城市筛选条（横向滚动 chip + active 高亮）
 *   - 主体瀑布流（白底卡片 + 圆角阴影）
 *   - NEW 红色 badge / 难度 4 档配色
 *   - loading / 空态 / 加载更多提示
 *
 * 视觉对齐 home.wxml 风格：
 *   - 卡片用 card-shadow / 24rpx 圆角
 *   - 主色调 var(--color-text-1) / 红色强调用 #FF2D55
 */

page {
  background: #F2F1F6;
}

/* ====== 顶部城市筛选条 ====== */
.city-filter-scroll {
  white-space: nowrap;
  padding: 16rpx 24rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #ECECEC;
}

.city-filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.city-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: #F2F1F6;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.2s;
}

.city-chip.active {
  background: #FF2D55;
  color: #ffffff;
  font-weight: 600;
}

/* ====== 首屏 loading ====== */
.loading {
  text-align: center;
  padding: 80rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

/* ====== 空态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 48rpx 0;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* ====== 主体瀑布流 ====== */
.segment-list {
  padding: 24rpx;
}

.segment-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.segment-card:active {
  transform: scale(0.98);
}

/* 卡片头部：赛段名 + NEW 标签 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.seg-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.new-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  background: #FF2D55;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

/* 主元数据：距离 / 爬升 / 城市 / 难度 */
.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #555;
}

.difficulty {
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.difficulty-easy {
  background: #E8F5E9;
  color: #2E7D32;
}

.difficulty-medium {
  background: #FFF8E1;
  color: #F57F17;
}

.difficulty-hard {
  background: #FFEBEE;
  color: #C62828;
}

.difficulty-extreme {
  background: #1A1A1A;
  color: #ffffff;
}

/* 副元数据：已挑战人数 */
.card-sub {
  display: flex;
  align-items: center;
}

.entries-text {
  font-size: 22rpx;
  color: #999;
}

/* ====== 分页加载提示 ====== */
.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx 24rpx 48rpx;
  font-size: 24rpx;
  color: #999;
}
