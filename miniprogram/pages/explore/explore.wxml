<view class="route-list-page">
  <view class="page-head">
    <view class="page-title">路线百科</view>
    <view class="page-subtitle">太原骑友常用路线手册</view>
  </view>

  <!-- 加载态：骨架屏（iOS 做法）——用和真路线卡同样外形的灰块占位 + 呼吸动画，
       数据来了无缝换成真卡。比干巴巴一行"加载中"文字更像原生 App、白屏焦虑更低。
       零 js 改动：复用现有 loading 状态，只在 loading 时渲染 3 张骨架卡。 -->
  <view wx:if="{{loading}}" class="guide-list">
    <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-cover sk-shimmer"></view>
      <view class="sk-body">
        <view class="sk-line sk-line-title sk-shimmer"></view>
        <view class="sk-line sk-line-meta sk-shimmer"></view>
      </view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="state-text">{{error}}</view>

  <view wx:else class="guide-list">
    <view class="guide-card tappable" wx:for="{{guides}}" wx:key="id" data-id="{{item.id}}" bindtap="openGuide">
      <view class="cover-wrap">
        <!-- 统一用 coverSrc：js 里已拼好 baseUrl 或回落占位图；
             直接用 cover_url（相对路径）在小程序里会指向本地包内必然加载失败 -->
        <image class="cover" src="{{item.coverSrc}}" mode="aspectFill" lazy-load />
        <view wx:if="{{item.ready}}" class="chip">有轨迹</view>
      </view>
      <view class="card-body">
        <view class="guide-name">{{item.name}}</view>
        <view wx:if="{{item.metaText}}" class="meta">{{item.metaText}}</view>
        <view wx:if="{{item.firstHighlight}}" class="highlight">{{item.firstHighlight}}</view>
      </view>
    </view>
  </view>
</view>
