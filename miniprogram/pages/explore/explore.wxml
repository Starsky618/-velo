<view class="route-list-page">
  <view class="page-head">
    <view class="page-title">路线百科</view>
    <view class="page-subtitle">太原骑友常用路线手册</view>
  </view>

  <view wx:if="{{loading}}" class="state-text">加载中</view>
  <view wx:elif="{{error}}" class="state-text">{{error}}</view>

  <view wx:else class="guide-list">
    <view class="guide-card" wx:for="{{guides}}" wx:key="id" data-id="{{item.id}}" bindtap="openGuide">
      <view class="cover-wrap">
        <!-- 统一用 coverSrc：js 里已拼好 baseUrl 或回落占位图；
             直接用 cover_url（相对路径）在小程序里会指向本地包内必然加载失败 -->
        <image class="cover" src="{{item.coverSrc}}" mode="aspectFill" lazy-load />
        <view wx:if="{{item.ready}}" class="chip">有轨迹</view>
      </view>
      <view class="card-body">
        <view class="guide-name">{{item.name}}</view>
        <view wx:if="{{item.metaText}}" class="meta">{{item.metaText}}</view>
        <view wx:if="{{item.firstHighlight}}" class="highlight">{{item.firstHighlight}}</view>
      </view>
    </view>
  </view>
</view>
