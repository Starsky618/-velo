// wxml 专用格式化函数（WXS 模块 / 只能用 ES5 语法）
// 这里只放给小程序模板调用的"显示层"函数 / 集中维护避免 wxml 散落 toFixed
//
// km(v)：把 km 距离 number 强制显示成两位小数字符串（带尾随零）
//   - v 为 null/undefined/空串/NaN → 返 '0.00'
//   - v 为 53.3 → 返 '53.30'（这是 toFixed(2) 的核心目的：保留尾随零）
//   - 为何不用 v.toFixed 直接调：v 可能不是 Number 类型（后端返字符串场景）→ 先 +v 强转

var km = function (v) {
  if (v === null || v === undefined || v === '') return '0.00'
  var n = +v
  if (isNaN(n)) return '0.00'
  return n.toFixed(2)
}

// secToHm(sec)：把秒数转成"时长"显示字符串（短/长行程统一英文 min 单位 / 字体规格一致）
//   - sec 为 null/undefined/0 → 返 '0min'
//   - sec ≥ 3600 → 返 'Hh Mmin' 格式（例 3700 → '1h 1min'）
//   - sec < 3600 → 返 'Mmin' 格式（例 1800 → '30min'）
//   - 2026-05-20 Tim 真用拍：列表里"3h 25min"和"32 分钟"中英混杂 + 空格不一 / 视觉割裂 / 全统一英文 min
var secToHm = function (sec) {
  if (sec === null || sec === undefined || sec === '') return '0min'
  var n = +sec
  if (isNaN(n) || n <= 0) return '0min'
  var h = Math.floor(n / 3600)
  var m = Math.floor((n % 3600) / 60)
  if (h > 0) {
    return h + 'h ' + m + 'min'
  }
  return m + 'min'
}

// roundInt(v)：把数值四舍五入成整数字符串（前端"米爬升"等无小数语义的字段用）
//   - v 为 null/undefined/空串/NaN → 返 '0'
//   - v 为 73.6 → 返 '74'（爬升 73.6 米 显示 74 / 不带 .0 尾巴）
var roundInt = function (v) {
  if (v === null || v === undefined || v === '') return '0'
  var n = +v
  if (isNaN(n)) return '0'
  return '' + Math.round(n)
}

module.exports = {
  km: km,
  secToHm: secToHm,
  roundInt: roundInt
}
