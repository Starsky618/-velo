.heatmap-card {
  margin: 0 24rpx 24rpx;
}

.card-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--color-text-1);
  font-size: 30rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-bottom: 24rpx;
  color: var(--color-text-3);
  font-size: 24rpx;
}

.heatmap-map-shell {
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: #eef3ee;
}

.heatmap-state {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--color-text-3);
  font-size: 26rpx;
}

.error-mini {
  color: var(--color-primary);
}

.heatmap-count {
  position: absolute;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.heatmap-count {
  top: 20rpx;
  left: 20rpx;
}

.heatmap-fullscreen {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  min-width: 128rpx;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: rgba(28, 28, 30, 0.86);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.heatmap-updating,
.heatmap-tile-error {
  position: absolute;
  top: 96rpx;
  left: 20rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(28, 28, 30, 0.82);
  color: #fff;
  font-size: 22rpx;
  line-height: 56rpx;
}

.heatmap-tile-error {
  background: rgba(196, 111, 0, 0.9);
}
