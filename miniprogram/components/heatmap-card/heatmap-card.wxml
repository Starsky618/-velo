<view class="card heatmap-card">
  <text class="card-title">骑行热力图</text>
  <text class="subtitle">所有骑行叠在同一张地图上</text>

  <view wx:if="{{loading}}" class="heatmap-map-shell heatmap-state">加载中...</view>
  <view wx:elif="{{error}}" class="heatmap-map-shell heatmap-state error-mini" bindtap="_retryFetch">加载失败 · 点击重试</view>
  <view wx:elif="{{isEmpty}}" class="heatmap-map-shell heatmap-state">还没骑过任何路线</view>
  <map wx:else
       id="heatmap-card-map"
       class="heatmap-map-shell"
       latitude="{{center.latitude}}"
       longitude="{{center.longitude}}"
       scale="10"
       include-points="{{includePoints}}"
       polyline="{{polylines}}"
       enable-scroll="{{true}}"
       enable-zoom="{{true}}"
       enable-rotate="{{false}}"
       enable-3D="{{false}}"
       show-location="{{false}}"
       show-scale="{{true}}"
       bindregionchange="onMapRegionChange">
    <cover-view class="heatmap-count">{{activityCount}} 次骑行</cover-view>
    <cover-view class="heatmap-fullscreen" catchtap="_openFullScreen">全屏查看</cover-view>
    <cover-view wx:if="{{updating}}" class="heatmap-updating">正在更新...</cover-view>
    <cover-view wx:if="{{tileError}}" class="heatmap-tile-error" catchtap="_retryTiles">图层加载失败 · 点击重试</cover-view>
  </map>
</view>
