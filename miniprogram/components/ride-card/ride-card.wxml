<!-- ride-card 组件模板：骑行卡片列表（可复用 home / profile） -->
<!-- 字段全部对齐后端 ActivitySummary schema（app/activity/schemas.py:39）： -->
<!--   id / title / distance(公里, service 已转) / duration(秒, 全程耗时) / moving_time(秒, 移动时间) -->
<!--   / elevation_gain(米) / avg_speed(km/h, worker 已转) / avg_power(W) / avg_hr(bpm) / started_at(ISO datetime) -->
<!-- 时长显示统一用 moving_time，老活动（GPX 早期）moving_time 为 NULL 时 fallback duration -->
<!-- 空字段（如爬升缺失）用 wx:if 整块隐藏，禁用 "-" 占位（永久规则） -->

<wxs src="../../utils/format.wxs" module="f" />

<block wx:if="{{rides && rides.length > 0}}">
  <view
    class="ride-card"
    wx:for="{{rides}}"
    wx:key="id"
    data-activity-id="{{item.id}}"
    bindtap="onTapRide"
  >
    <!-- 路线轨迹缩略（iGPSport 式左图）：父页面塞 trackPoints 后组件 observer 自画。
         用 hidden 而非 wx:if——canvas DOM 常在才能稳定绘制（陷阱 #17）；
         无轨迹的活动整块隐藏，右侧信息自动占满全宽 -->
    <view class="ride-thumb" hidden="{{!item.trackPoints || item.trackPoints.length < 2}}">
      <canvas canvas-id="ride-thumb-{{item.id}}" class="ride-thumb-canvas"></canvas>
    </view>

    <view class="ride-main">
    <view class="ride-card-header">
      <view class="ride-title">{{item.title || '骑行记录'}}</view>
      <!-- started_at 由父页面预格式化成 startedAtDisplay 字段（如"今天 09:30"） -->
      <view class="ride-subtitle" wx:if="{{item.startedAtDisplay}}">
        {{item.startedAtDisplay}}
      </view>
    </view>

    <view class="ride-stats">
      <!-- 距离：service 层已把米转公里 / wxs km() 保 2 位小数 / 单位 km 跟在数值后 -->
      <view class="ride-stat" wx:if="{{item.distance !== null && item.distance !== undefined}}">
        <view class="ride-stat-value">{{f.km(item.distance)}}<text class="ride-stat-unit">km</text></view>
        <view class="ride-stat-label">距离</view>
      </view>
      <!-- 时长：后端秒 / 优先用 moving_time（移动时间）/ 老活动 fallback duration / wxs secToHm() 转 "Xh Ymin" -->
      <view class="ride-stat" wx:if="{{item.moving_time || item.duration}}">
        <view class="ride-stat-value">{{f.secToHm(item.moving_time || item.duration)}}</view>
        <view class="ride-stat-label">时长</view>
      </view>
      <!-- 均速：单位 km/h 跟在数值后 / label 写"均速" / 4 项宽度均衡挤同行 -->
      <view class="ride-stat" wx:if="{{item.avg_speed !== null && item.avg_speed !== undefined}}">
        <view class="ride-stat-value">{{item.avg_speed}}<text class="ride-stat-unit">km/h</text></view>
        <view class="ride-stat-label">均速</view>
      </view>
      <!-- 爬升：米 float / wxs roundInt() 四舍五入去 .0 尾巴 / 单位 m 跟在数值后 -->
      <view class="ride-stat" wx:if="{{item.elevation_gain !== null && item.elevation_gain !== undefined}}">
        <view class="ride-stat-value">{{f.roundInt(item.elevation_gain)}}<text class="ride-stat-unit">m</text></view>
        <view class="ride-stat-label">爬升</view>
      </view>
    </view>
    </view>
  </view>
</block>

<view class="ride-empty" wx:elif="{{showEmpty}}">
  <view class="ride-empty-text">{{emptyText}}</view>
  <view class="ride-empty-subtext" wx:if="{{emptySubtext}}">{{emptySubtext}}</view>
</view>
