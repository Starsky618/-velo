<!-- ride-card 组件模板：骑行卡片列表（可复用 home / profile） -->
<!-- 字段全部对齐后端 ActivitySummary schema（app/activity/schemas.py:39）： -->
<!--   id / title / distance(公里, service 已转) / duration(秒, 全程耗时) / moving_time(秒, 移动时间) -->
<!--   / elevation_gain(米) / avg_speed(km/h, worker 已转) / avg_power(W) / avg_hr(bpm) / started_at(ISO datetime) -->
<!-- 时长显示统一用 moving_time，老活动（GPX 早期）moving_time 为 NULL 时 fallback duration -->
<!-- 空字段（如爬升缺失）用 wx:if 整块隐藏，禁用 "-" 占位（永久规则） -->

<wxs src="../../utils/format.wxs" module="f" />

<block wx:if="{{rides && rides.length > 0}}">

  <!-- ⚠ 关键结构（陷阱 #17 / 2026-06-14 回归实证）：
       wx:for 必须在最外层、绝不被 layout 的 wx:if 包裹——否则 canvas 节点随条件块延迟挂载，
       observer 首次绘制时 createCanvasContext 拿不到节点 → 静默画空（profile 轨迹一度消失就是这个）。
       布局差异下沉到每张卡内部：根节点用 class 区分 list/cover，canvas 始终渲染（hidden 控可见性）。 -->
  <view
    class="ride-card {{layout === 'cover' ? 'ride-card--cover' : ''}}"
    wx:for="{{rides}}"
    wx:key="id"
    data-activity-id="{{item.id}}"
    bindtap="onTapRide"
  >

    <!-- cover 头像行（Strava 式）：只 cover 模式有；list 模式整块不渲染（与 canvas 无关，纯信息可安全 wx:if）。
         有 avatarUrl 用真头像，没有回落字母占位（工程无默认头像图 / images 不存在，不引用防 404，见 MASTER §7）。 -->
    <view class="cover-head" wx:if="{{layout === 'cover' && item.nickname}}">
      <image wx:if="{{item.avatarUrl}}" class="cover-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="cover-avatar cover-avatar--letter"><text>{{item.initial}}</text></view>
      <view class="cover-user">
        <view class="cover-name">{{item.nickname}}</view>
        <view class="cover-meta" wx:if="{{item.startedAtDisplay}}">{{item.startedAtDisplay}}</view>
      </view>
    </view>

    <!-- ⚠ 轨迹 canvas：唯一一份、提到任何 layout 条件块外，永远渲染（陷阱 #17 / 2026-06-14 回归实证）。
         之前把 canvas 包进 layout 的 wx:if/block 里 → observer 首次绘制时 createCanvasContext 拿不到节点
         → 静默画空（profile 轨迹消失就是这个）。class 随 layout 变（list 左方块 / cover 全宽大图），
         可见性用 hidden（无轨迹整块隐藏），但 DOM 节点常在，绘制时序稳定。 -->
    <view class="thumb-slot {{layout === 'cover' ? 'thumb-slot--cover' : 'thumb-slot--list'}}"
          hidden="{{!item.trackPoints || item.trackPoints.length < 2}}">
      <canvas canvas-id="ride-thumb-{{item.id}}" class="thumb-canvas {{layout === 'cover' ? 'thumb-canvas--cover' : 'thumb-canvas--list'}}"></canvas>
    </view>

    <!-- cover 信息区（标题 + 横排数据行）：纯文字，安全 wx:if -->
    <view class="cover-body" wx:if="{{layout === 'cover'}}">
      <view class="cover-title">{{item.title || '骑行记录'}}</view>
      <!-- 数据行横排 "32.4 km · 420 m · 1h 18m"（探索页同款等宽）；缺字段不渲染该段 + 分隔点 -->
      <view class="cover-data">
        <text class="cover-data-item" wx:if="{{item.distance !== null && item.distance !== undefined}}">{{f.km(item.distance)}} km</text>
        <text class="cover-dot" wx:if="{{(item.distance !== null && item.distance !== undefined) && (item.elevation_gain !== null && item.elevation_gain !== undefined)}}">·</text>
        <text class="cover-data-item" wx:if="{{item.elevation_gain !== null && item.elevation_gain !== undefined}}">{{f.roundInt(item.elevation_gain)}} m</text>
        <text class="cover-dot" wx:if="{{(item.elevation_gain !== null && item.elevation_gain !== undefined) && (item.moving_time || item.duration)}}">·</text>
        <text class="cover-data-item" wx:if="{{item.moving_time || item.duration}}">{{f.secToHm(item.moving_time || item.duration)}}</text>
      </view>
    </view>

    <!-- list 信息区（右侧标题 + 四格数据）：纯文字，安全 wx:if -->
    <view class="ride-main" wx:if="{{layout !== 'cover'}}">
      <view class="ride-card-header">
        <view class="ride-title">{{item.title || '骑行记录'}}</view>
        <view class="ride-subtitle" wx:if="{{item.startedAtDisplay}}">
          {{item.startedAtDisplay}}
        </view>
      </view>

      <view class="ride-stats">
        <view class="ride-stat" wx:if="{{item.distance !== null && item.distance !== undefined}}">
          <view class="ride-stat-value">{{f.km(item.distance)}}<text class="ride-stat-unit">km</text></view>
          <view class="ride-stat-label">距离</view>
        </view>
        <view class="ride-stat" wx:if="{{item.moving_time || item.duration}}">
          <view class="ride-stat-value">{{f.secToHm(item.moving_time || item.duration)}}</view>
          <view class="ride-stat-label">时长</view>
        </view>
        <view class="ride-stat" wx:if="{{item.avg_speed !== null && item.avg_speed !== undefined}}">
          <view class="ride-stat-value">{{item.avg_speed}}<text class="ride-stat-unit">km/h</text></view>
          <view class="ride-stat-label">均速</view>
        </view>
        <view class="ride-stat" wx:if="{{item.elevation_gain !== null && item.elevation_gain !== undefined}}">
          <view class="ride-stat-value">{{f.roundInt(item.elevation_gain)}}<text class="ride-stat-unit">m</text></view>
          <view class="ride-stat-label">爬升</view>
        </view>
      </view>
    </view>

  </view>

</block>

<view class="ride-empty" wx:elif="{{showEmpty}}">
  <view class="ride-empty-text">{{emptyText}}</view>
  <view class="ride-empty-subtext" wx:if="{{emptySubtext}}">{{emptySubtext}}</view>
</view>
