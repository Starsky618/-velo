/**
 * 功率曲线 component 样式
 *
 * 设计原则：
 * - 沿用全局 .card 样式（app.wxss 已定义白底圆角阴影）+ 本地外边距
 * - 标题 / 副标题字号层级跟个人页其他卡片对齐（28rpx 标题 / 24rpx 副标题）
 * - canvas 容器固定高度 320rpx（4 条线展示空间够用，比 detail 页 280rpx 略高一点）
 * - 4 状态文案统一居中、灰色（不抢主角）
 */

.power-curve-card {
  margin: 0 24rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-1);
  display: block;
  letter-spacing: -0.3rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--color-text-3);
  display: block;
  margin-top: 6rpx;
  margin-bottom: 20rpx;
}

/* ── v3 polish: period 切换 segment control ──
 * 5 档均分 / 默认灰字 / 当前档主色调红高亮
 * 设计参考 iOS segment control 风格：圆角胶囊 + 浅红背景 + 红字加粗
 */
.period-tabs {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
  margin-bottom: 4rpx;
  gap: 8rpx;
}

.period-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-3);
  padding: 10rpx 0;
  border-radius: 16rpx;
  background-color: rgba(0, 0, 0, 0.04);
  transition: background-color 0.15s, color 0.15s;
}

.period-tab.active {
  color: var(--color-primary);
  background-color: rgba(255, 45, 85, 0.1);
  font-weight: 600;
}

/* ── 4 状态文案：loading / error / empty 共享尺寸，颜色不同 ── */
.loading-mini,
.error-mini,
.empty-mini {
  font-size: 26rpx;
  color: var(--color-text-3);
  text-align: center;
  padding: 80rpx 0;
  line-height: 1.5;
}

.error-mini {
  color: var(--color-primary);
}

/* ── canvas 容器：固定高度让 hidden 切换不撑塌布局 ── */
.chart-canvas-wrap {
  width: 100%;
  height: 320rpx;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}
