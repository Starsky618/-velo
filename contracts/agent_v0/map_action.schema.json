{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velo.invalid/agent_v0/map_action.schema.json",
  "title": "VELO Map Action v0",
  "description": "A declarative shared-map proposal that must pass a deterministic gate and reducer before presentation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "fixture_only",
    "map_action_id",
    "session_id",
    "base_session_revision",
    "source_agent_action_ref",
    "sequence",
    "issued_at",
    "reducer_required",
    "action_type",
    "payload",
    "metadata"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "environment": { "$ref": "session_state.schema.json#/$defs/environment" },
    "fixture_only": { "type": "boolean" },
    "map_action_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "session_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "base_session_revision": { "type": "integer", "minimum": 1 },
    "source_agent_action_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "reducer_required": { "const": true },
    "action_type": {
      "type": "string",
      "enum": [
        "fit_bounds",
        "show_area",
        "highlight_object",
        "show_candidate_set",
        "highlight_plan_leg",
        "dim_objects",
        "show_anchor",
        "show_warning_scope"
      ]
    },
    "payload": { "type": "object" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" }
  },
  "allOf": [
    { "$ref": "session_state.schema.json#/$defs/environment_fixture_rule" },
    {
      "oneOf": [
        {
          "properties": {
            "action_type": { "const": "fit_bounds" },
            "payload": { "$ref": "#/$defs/fit_bounds_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "show_area" },
            "payload": { "$ref": "#/$defs/show_area_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "highlight_object" },
            "payload": { "$ref": "#/$defs/highlight_object_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "show_candidate_set" },
            "payload": { "$ref": "#/$defs/show_candidate_set_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "highlight_plan_leg" },
            "payload": { "$ref": "#/$defs/highlight_plan_leg_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "dim_objects" },
            "payload": { "$ref": "#/$defs/dim_objects_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "show_anchor" },
            "payload": { "$ref": "#/$defs/show_anchor_payload" }
          },
          "required": ["action_type", "payload"]
        },
        {
          "properties": {
            "action_type": { "const": "show_warning_scope" },
            "payload": { "$ref": "#/$defs/show_warning_scope_payload" }
          },
          "required": ["action_type", "payload"]
        }
      ]
    }
  ],
  "$defs": {
    "fit_bounds_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds_ref", "padding_profile"],
      "properties": {
        "bounds_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "padding_profile": { "type": "string", "enum": ["compact", "comfortable"] }
      }
    },
    "cycling_area_ref": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/object_ref" },
        {
          "properties": { "object_type": { "const": "cycling_area" } },
          "required": ["object_type"]
        }
      ]
    },
    "show_area_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_ref", "presentation_role"],
      "properties": {
        "area_ref": { "$ref": "#/$defs/cycling_area_ref" },
        "presentation_role": {
          "type": "string",
          "enum": ["context", "primary", "comparison"]
        }
      }
    },
    "highlight_object_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_ref", "highlight_role"],
      "properties": {
        "object_ref": { "$ref": "common.schema.json#/$defs/object_ref" },
        "highlight_role": {
          "type": "string",
          "enum": ["primary", "secondary", "selected", "warning"]
        }
      }
    },
    "candidate_display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "plan_revision_ref",
        "validation_result_ref",
        "display_order"
      ],
      "properties": {
        "candidate_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "plan_revision_ref": { "$ref": "session_state.schema.json#/$defs/plan_revision_ref" },
        "validation_result_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "display_order": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "show_candidate_set_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/candidate_display" }
        }
      }
    },
    "highlight_plan_leg_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision_ref", "leg_ref", "highlight_role"],
      "properties": {
        "plan_revision_ref": { "$ref": "session_state.schema.json#/$defs/plan_revision_ref" },
        "leg_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "highlight_role": {
          "type": "string",
          "enum": ["primary", "secondary", "selected", "warning"]
        }
      }
    },
    "dim_objects_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "reason"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "session_state.schema.json#/$defs/display_target" },
          "maxItems": 20
        },
        "reason": {
          "type": "string",
          "enum": ["comparison_context", "out_of_focus", "stale"]
        }
      }
    },
    "show_anchor_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor"],
      "properties": {
        "anchor": { "$ref": "session_state.schema.json#/$defs/map_anchor" }
      }
    },
    "show_warning_scope_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_ref", "target", "severity"],
      "properties": {
        "warning_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "target": { "$ref": "session_state.schema.json#/$defs/display_target" },
        "severity": {
          "type": "string",
          "enum": ["information", "caution", "major", "critical"]
        }
      }
    }
  }
}
