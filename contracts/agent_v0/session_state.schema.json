{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velo.invalid/agent_v0/session_state.schema.json",
  "title": "VELO Planning Session State v0",
  "description": "Recoverable deterministic working state for one rider planning decision. It is not a transcript, Agent Run checkpoint, World Fact packet, long-term memory, or RidePlan body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "fixture_only",
    "session_id",
    "session_revision",
    "state_owner",
    "status",
    "created_at",
    "updated_at",
    "task_mode",
    "focused_world_refs",
    "candidate_plans",
    "map_state",
    "assumptions",
    "unknowns",
    "metadata"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "environment": { "$ref": "#/$defs/environment" },
    "fixture_only": { "type": "boolean" },
    "session_id": { "$ref": "common.schema.json#/$defs/stable_id" },
    "session_revision": { "type": "integer", "minimum": 1 },
    "state_owner": { "const": "deterministic_interaction_service" },
    "status": {
      "type": "string",
      "enum": ["open", "resolved", "expired", "cancelled"]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "task_mode": {
      "type": "string",
      "enum": ["discover", "understand", "compare", "revise", "execute"]
    },
    "rider_ref": { "$ref": "#/$defs/rider_ref" },
    "active_intent_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "last_user_turn_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "last_map_event_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "last_committed_run_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "focused_world_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/object_ref" },
      "maxItems": 50
    },
    "focused_plan_leg": { "$ref": "#/$defs/focused_plan_leg" },
    "candidate_plans": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/candidate_plan" }
    },
    "active_candidate_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
    "selected_plan": { "$ref": "#/$defs/selected_plan" },
    "map_state": { "$ref": "#/$defs/map_state" },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" },
      "maxItems": 50
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/session_unknown" },
      "maxItems": 50
    },
    "pending_user_decision": { "$ref": "#/$defs/pending_user_decision" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" }
  },
  "allOf": [
    { "$ref": "#/$defs/environment_fixture_rule" },
    {
      "if": {
        "properties": { "status": { "enum": ["expired", "cancelled"] } },
        "required": ["status"]
      },
      "then": { "not": { "required": ["pending_user_decision"] } }
    }
  ],
  "$defs": {
    "environment": {
      "type": "string",
      "enum": ["test", "shadow", "production"]
    },
    "environment_fixture_rule": {
      "if": {
        "properties": { "environment": { "const": "test" } },
        "required": ["environment"]
      },
      "then": {
        "properties": { "fixture_only": { "const": true } },
        "required": ["fixture_only"]
      },
      "else": {
        "properties": { "fixture_only": { "const": false } },
        "required": ["fixture_only"]
      }
    },
    "rider_ref": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/object_ref" },
        {
          "properties": { "object_type": { "const": "rider" } },
          "required": ["object_type"]
        }
      ]
    },
    "plan_revision_ref": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/revision_ref" },
        {
          "properties": {
            "object_ref": {
              "allOf": [
                { "$ref": "common.schema.json#/$defs/object_ref" },
                {
                  "properties": { "object_type": { "const": "ride_plan" } },
                  "required": ["object_type"]
                }
              ]
            }
          },
          "required": ["object_ref"]
        }
      ]
    },
    "focused_plan_leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision_ref", "leg_ref"],
      "properties": {
        "plan_revision_ref": { "$ref": "#/$defs/plan_revision_ref" },
        "leg_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "candidate_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "plan_revision_ref",
        "session_fit_status",
        "presentation_state",
        "display_order"
      ],
      "properties": {
        "candidate_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "plan_revision_ref": { "$ref": "#/$defs/plan_revision_ref" },
        "session_fit_status": {
          "type": "string",
          "enum": ["current", "stale", "invalid"]
        },
        "presentation_state": {
          "type": "string",
          "enum": ["hidden", "visible", "dimmed"]
        },
        "display_order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "validation_result_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "tradeoff_summary_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_fit_status": { "const": "current" },
              "presentation_state": { "const": "visible" }
            },
            "required": ["session_fit_status", "presentation_state"]
          },
          "then": { "required": ["validation_result_ref"] }
        }
      ]
    },
    "selected_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "plan_revision_ref",
        "selected_by_user_event_ref",
        "selected_at"
      ],
      "properties": {
        "candidate_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "plan_revision_ref": { "$ref": "#/$defs/plan_revision_ref" },
        "selected_by_user_event_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "selected_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "map_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_ref", "anchor_role", "location_handle", "source_event_ref"],
      "properties": {
        "anchor_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "anchor_role": {
          "type": "string",
          "enum": ["origin", "destination", "waypoint", "turnaround", "exit"]
        },
        "location_handle": { "$ref": "common.schema.json#/$defs/location_handle" },
        "source_event_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "map_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds_ref", "zoom_level", "source_event_ref"],
      "properties": {
        "bounds_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "zoom_level": { "type": "number", "minimum": 0, "maximum": 24 },
        "source_event_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "elevation_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_kind",
        "target_ref",
        "from_fraction",
        "to_fraction",
        "selected_by_event_ref"
      ],
      "properties": {
        "target_kind": { "type": "string", "enum": ["traversal", "plan_leg"] },
        "target_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "from_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "to_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "selected_by_event_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "display_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "target_ref"],
      "properties": {
        "target_kind": {
          "type": "string",
          "enum": ["world_object", "candidate_plan", "plan_leg", "anchor", "warning"]
        },
        "target_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "map_presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shown_area_refs",
        "highlighted_targets",
        "visible_candidate_refs",
        "dimmed_targets",
        "warning_scope_refs",
        "last_map_action_refs"
      ],
      "properties": {
        "shown_area_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/object_ref" },
          "maxItems": 20
        },
        "highlighted_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/display_target" },
          "maxItems": 20
        },
        "visible_candidate_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/stable_id" },
          "maxItems": 3
        },
        "dimmed_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/display_target" },
          "maxItems": 20
        },
        "warning_scope_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/stable_id" },
          "maxItems": 20
        },
        "last_map_action_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/stable_id" },
          "maxItems": 20
        }
      }
    },
    "map_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "viewport", "presentation"],
      "properties": {
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/map_anchor" },
          "maxItems": 20
        },
        "viewport": { "$ref": "#/$defs/map_viewport" },
        "elevation_selection": { "$ref": "#/$defs/elevation_selection" },
        "presentation": { "$ref": "#/$defs/map_presentation" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "assumption_kind",
        "status",
        "source_ref",
        "user_safe_summary"
      ],
      "properties": {
        "assumption_id": { "$ref": "common.schema.json#/$defs/stable_id" },
        "assumption_kind": {
          "type": "string",
          "enum": [
            "intent_interpretation",
            "location_interpretation",
            "time_budget",
            "route_preference",
            "plan_tradeoff"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "user_confirmed", "rejected", "superseded"]
        },
        "source_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "user_safe_summary": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "session_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "unknown_kind", "blocking", "user_safe_summary"],
      "properties": {
        "unknown_id": { "$ref": "common.schema.json#/$defs/stable_id" },
        "unknown_kind": {
          "type": "string",
          "enum": [
            "intent",
            "location",
            "world_data",
            "plan_feasibility",
            "user_choice",
            "session_consistency"
          ]
        },
        "blocking": { "type": "boolean" },
        "user_safe_summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "related_ref": { "$ref": "common.schema.json#/$defs/stable_id" }
      }
    },
    "pending_user_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_ref",
        "decision_kind",
        "requested_by_agent_action_ref",
        "blocking",
        "created_at"
      ],
      "properties": {
        "decision_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "decision_kind": {
          "type": "string",
          "enum": [
            "clarification",
            "candidate_selection",
            "plan_confirmation",
            "session_assumption"
          ]
        },
        "requested_by_agent_action_ref": { "$ref": "common.schema.json#/$defs/stable_id" },
        "blocking": { "type": "boolean" },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
