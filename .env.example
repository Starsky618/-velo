# 数据库连接（PostgreSQL + PostGIS）
DATABASE_URL=postgresql://ridemap:changeme@localhost:5432/ridemap

# Redis（用于 rq 任务队列）
REDIS_URL=redis://localhost:6379/0

# JWT 密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-to-a-random-secret

# 微信小程序凭证（变量名与 spec docker-compose 保持一致）
WX_APPID=your-app-id
WX_SECRET=your-app-secret

# 文件存储根目录（本地开发用）
UPLOAD_DIR=./uploads
