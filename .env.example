# VELO 环境变量模板
# 使用方法：cp .env.example .env，然后填入实际值
# 警告：.env 包含密钥，绝对不要提交到 Git！

# ===== 本地开发 =====
# DATABASE_URL=postgresql://velo:changeme@localhost:5432/velo
# REDIS_URL=redis://localhost:6379/0

# ===== Docker 部署（docker-compose.yml 中已设置，这里只需填密码和密钥） =====

# 数据库密码（生产环境请用随机强密码）
DB_PASSWORD=changeme

# JWT 签名密钥（用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
JWT_SECRET=change-me-to-a-random-secret

# 微信小程序凭证（微信公众平台 → 开发管理 → 开发设置）
WX_APPID=your-app-id
WX_SECRET=your-app-secret

# 文件存储根目录
UPLOAD_DIR=./uploads

# Strava Webhook 订阅 ID
# 初次部署时手动跑 curl 创建订阅（见 docs/plans/phase4/task-7.4.md 部署说明），
# 把返回的 id 填这里。未配置 POST /webhook 会返 503
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# DeepSeek API（v5 task-1.B.1 起用 / AI 赛段介绍生成）
# 真实 key 只在生产 .env 配（不进 git）；dev / CI 可空，segment_writer 自动跳过
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
